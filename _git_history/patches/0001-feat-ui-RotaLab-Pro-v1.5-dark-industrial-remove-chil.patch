-      if(!channels.length) return;
-      // simple FFT magnitude (naive for demo)
-      const ch = channels[0];
-      const seg = ch.samples.slice(viewStart, viewStart+Math.min(viewLen, 4096));
-      const n = seg.length;
-      const mag = new Float64Array(W);
-      // fake envelope spectrum with fault peaks for demo
-      gS.strokeStyle="#7c3aed"; gS.beginPath();
-      for(let px=0;px<W;px++){
-        const freq = px/W * ch.sampleRate/2;
-        // mock spectrum: peaks at BPFO/BPFI if outer fault
-        let m = Math.random()*0.1 + 0.2*Math.exp(-Math.pow((freq-87)/10,2)) + 0.15*Math.exp(-Math.pow((freq-174)/10,2));
