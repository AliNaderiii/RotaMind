+:root{--bg:#0b1220;--panel:#111c2e;--card:#16233c;--border:#1e3356;--text:#e2e8f0;--muted:#94a3b8;--accent:#0ea5e9}
+*{box-sizing:border-box;margin:0;padding:0}
+body{font-family:system-ui,sans-serif;background:var(--bg);color:var(--text);height:100vh;display:flex;flex-direction:column;overflow:hidden}
+.topbar{height:48px;background:#0f172a;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:14px;padding:0 16px}
+.brand-mark{width:28px;height:28px;background:linear-gradient(135deg,#0ea5e9,#6366f1);border-radius:6px;display:grid;place-items:center;font-weight:700;font-size:13px}
+.layout{display:grid;grid-template-columns:220px 1fr 320px;flex:1;min-height:0}
+.sidenav{background:#0f172a;border-left:1px solid var(--border);padding:10px 8px;display:flex;flex-direction:column;gap:4px}
+.nav-item{height:34px;display:flex;align-items:center;gap:10px;padding:0 10px;border-radius:8px;font-size:12px;color:var(--muted)}
+.nav-item.active{background:var(--card);color:var(--text);border:1px solid var(--border)}
+.center{display:flex;flex-direction:column;min-width:0;background:#0b1220}
+.toolbar{height:42px;background:var(--panel);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;padding:0 12px}
+.btn{height:30px;padding:0 12px;border:1px solid var(--border);background:var(--panel);color:var(--text);border-radius:8px;font-size:12px;cursor:pointer}
+.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
+.card{background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden}
+.card-head{height:36px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;border-bottom:1px solid var(--border);font-size:12px;font-weight:600}
+canvas{display:block;width:100%;background:#0a1222}
+.right{background:var(--panel);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:auto}
+.panel{padding:12px;border-bottom:1px solid var(--border)}
+</style>
