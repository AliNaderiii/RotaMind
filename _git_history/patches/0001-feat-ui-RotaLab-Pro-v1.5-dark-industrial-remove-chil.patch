-    function drawWave(){
-      const W = waveCanvas.width, H = waveCanvas.height;
-      gW.clearRect(0,0,W,H);
-      gW.fillStyle="#fff"; gW.fillRect(0,0,W,H);
-      gW.strokeStyle="#e2e8f0"; gW.strokeRect(0,0,W,H);
-      if(!channels.length) {
-        gW.fillStyle="#94a3b8"; gW.font="13px Vazirmatn"; gW.fillText("نمودار پس از باز کردن فایل نمایش داده می‌شود — از edf-bdf-WR الهام گرفته شده (Canvas + min/max decimation)", 20, H/2);
-        return;
-      }
-      const visible = channels.filter((_,i)=> document.querySelector(`[data-ch="${i}"]`).checked);
-      visible.forEach((ch, idx)=>{
-        const y0 = (idx+0.5) * (H/visible.length);
-        const amp = 80;
-        gW.strokeStyle = ["#0ea5e9","#f59e0b","#10b981"][idx%3];
-        gW.beginPath();
-        const step = Math.max(1, Math.floor(viewLen / W));
-        let first=true;
-        for(let px=0; px<W; px++){
-          const i0 = viewStart + px*step;
-          if(i0 >= ch.samples.length) break;
-          // min/max per pixel (from edf-bdf-WR)
-          let mn=Infinity,mx=-Infinity;
-          const i1 = Math.min(i0+step, ch.samples.length);
-          for(let j=i0;j<i1;j++){ const v=ch.samples[j]; if(v<mn) mn=v; if(v>mx) mx=v; }
-          const yMn = y0 - mn*amp, yMx = y0 - mx*amp;
-          if(first){ gW.moveTo(px, yMn); first=false; }
-          gW.lineTo(px, yMn); gW.lineTo(px, yMx);
-        }
-        gW.stroke();
-        gW.fillStyle="#334155"; gW.font="11px monospace"; gW.fillText(`${ch.label} (${ch.unit}) RMS:${ch.rms.toFixed(2)}`, 6, y0-60);
-      });
-    }
-
