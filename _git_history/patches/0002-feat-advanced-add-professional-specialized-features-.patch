+/**
+ * iso10816.ts — ارزیابی خودکار بر اساس ISO 10816-3 (ماشین‌های صنعتی)
+ * متخصص: مهندس مکانیک + دیتا آنالیست
+ * الهام: Fluke 810 overall vibration + Emerson severity scale
+ * 
+ * ISO 10816-3 zones:
+ *  A: new machine  B: acceptable  C: alert  D: danger
+ * حدود بر اساس گروه ماشین و فونداسیون
+ */
+
+export type IsoClass = 'I'|'II'|'III'|'IV'; // توان
+export type Foundation = 'rigid'|'soft';
+export type IsoZone = 'A'|'B'|'C'|'D';
+
+export interface IsoThresholds { B:number; C:number; D:number } // mm/s RMS velocity
+
+// جدول ساده شده ISO 10816-3 (velocity mm/s RMS, 10-1000Hz)
+const ISO_TABLE: Record<IsoClass, Record<Foundation, IsoThresholds>> = {
+  'I': { // <15kW
+    'rigid': { B:0.71, C:1.8, D:4.5 },
+    'soft':  { B:0.9,  C:2.3, D:5.6 }
+  },
+  'II': { // 15-300kW
+    'rigid': { B:1.4, C:2.8, D:7.1 },
+    'soft':  { B:1.8, C:3.5, D:9.0 }
+  },
+  'III': { // >300kW rigid
+    'rigid': { B:2.3, C:4.5, D:11 },
+    'soft':  { B:3.5, C:7.1, D:18 }
+  },
+  'IV': { // >10MW
+    'rigid': { B:2.3, C:4.5, D:11 },
+    'soft':  { B:3.5, C:6.0, D:15 }
+  }
+};
+
+export function evaluateISO(vRms_mm_s:number, machineClass:IsoClass='II', foundation:Foundation='rigid'): {zone:IsoZone, color:string, labelFa:string, actionFa:string} {
+  const t = ISO_TABLE[machineClass][foundation];
+  let zone: IsoZone;
+  if(vRms_mm_s < t.B) zone='A';
+  else if(vRms_mm_s < t.C) zone='B';
+  else if(vRms_mm_s < t.D) zone='C';
+  else zone='D';
+  const map: Record<IsoZone, {color:string,labelFa:string,actionFa:string}> = {
+    'A': { color:'#10b981', labelFa:'عالی (A) — ماشین نو', actionFa:'ادامه پایش ماهانه' },
+    'B': { color:'#22c55e', labelFa:'قابل قبول (B)', actionFa:'پایش هفتگی' },
+    'C': { color:'#f59e0b', labelFa:'هشدار (C) — نیاز به برنامه‌ریزی', actionFa:'بررسی و برنامه تعمیر در 1 ماه' },
+    'D': { color:'#ef4444', labelFa:'خطر (D) — توقف', actionFa:'توقف فوری و بازرسی' },
+  };
+  return { zone, ...map[zone] };
+}
+
+// تبدیل شتاب g به سرعت mm/s RMS (انتگرال ساده در حوزه فرکانس)
+// برای MVP: تقریب با 1g @ 100Hz = 15.6 mm/s
+export function accToVelocity(accRms_g:number, dominantFreqHz:number=100): number {
+  // v = a / (2πf) ; a in m/s2 (1g=9.81)
+  return (accRms_g*9.81) / (2*Math.PI*dominantFreqHz) * 1000; // mm/s
+}
+
+export function severityFromISO(zone:IsoZone): {level:'Slight'|'Moderate'|'Serious'|'Extreme', fa:string, score:number} {
+  const map = {
+    'A': { level:'Slight' as const, fa:'جزئی', score:1 },
+    'B': { level:'Moderate' as const, fa:'متوسط', score:2 },
+    'C': { level:'Serious' as const, fa:'جدی', score:3 },
+    'D': { level:'Extreme' as const, fa:'بحرانی', score:4 },
+  };
+  return map[zone];
+}
