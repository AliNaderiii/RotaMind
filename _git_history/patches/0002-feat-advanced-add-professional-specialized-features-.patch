+/**
+ * diagnosis.ts — موتور تشخیص توصیفی (Plain-text Diagnosis Engine)
+ * الهام: Fluke 810 (plain-text + 4 severity + repair recommendation + cited peaks)
+ * ترکیب: ISO + Kurtosis + Crest + AI
+ */
+
+export type Severity = 'Slight'|'Moderate'|'Serious'|'Extreme';
+export interface DiagnosisResult {
+  primaryFault: string; // "Outer Race" | "Normal" | "Imbalance" | ...
+  severity: Severity;
+  severityFa: string;
+  score: number; // 0-100
+  evidence: string[]; // cited peaks
+  recommendation: string;
+  helpTip: string; // context-sensitive help (Fluke-style)
+}
+
+export function diagnose(params:{
+  rms_g:number, peak_g:number, kurt:number, crest:number,
+  vel_mm_s:number, isoZone:string,
+  aiFault:string, aiConf:number,
+  spectrumPeaks:{freq:number, amp:number, label:string}[], // از envelope
+  rpm:number
+}): DiagnosisResult {
+
+  const { rms_g, peak_g, kurt, crest, vel_mm_s, isoZone, aiFault, aiConf } = params;
+
+  // Rule-based layer (مثل Fluke 810)
+  let fault = aiFault;
+  let sev: Severity = 'Slight';
+  let score = 0;
+  const evidence: string[] = [];
+
+  // 1) ISO
+  if(isoZone==='D') { sev='Extreme'; score+=40; evidence.push(`ISO Zone D — vel ${vel_mm_s.toFixed(1)} mm/s`); }
+  else if(isoZone==='C') { sev='Serious'; score+=25; evidence.push(`ISO Zone C`); }
+  else if(isoZone==='B') { sev='Moderate'; score+=10; }
+
+  // 2) Impulsiveness (Kurtosis + Crest)
+  if(kurt > 6) { evidence.push(`Kurtosis ${kurt.toFixed(1)} — ضربات شدید (Spall)`); score+=20; if(sev==='Slight') sev='Moderate'; }
+  else if(kurt > 3) { evidence.push(`Kurtosis ${kurt.toFixed(1)} — ضربات متوسط`); score+=10; }
+  if(crest > 6) { evidence.push(`Crest Factor ${crest.toFixed(1)} > 6`); score+=10; }
+
+  // 3) AI
+  if(aiFault !== 'Normal' && aiConf > 0.7) {
+    evidence.push(`AI ${aiFault} ${(aiConf*100).toFixed(0)}%`);
+    score += aiConf*30;
+    fault = aiFault;
+    if(aiConf > 0.9 && sev==='Slight') sev='Serious';
+    else if(aiConf > 0.75 && sev==='Slight') sev='Moderate';
+  } else if(aiFault==='Normal') {
+    evidence.push(`AI Normal ${(aiConf*100).toFixed(0)}%`);
+  }
+
+  // Final score clamp
+  score = Math.min(100, Math.round(score));
+
+  // Severity refinement by score
+  if(score >= 75) sev='Extreme';
+  else if(score >= 50) sev='Serious';
+  else if(score >= 25) sev='Moderate';
+  else sev='Slight';
+
+  const severityFaMap: Record<Severity,string> = { 'Slight':'جزئی','Moderate':'متوسط','Serious':'جدی','Extreme':'بحرانی' };
+
+  // Recommendation (Fluke-style repair)
+  let recommendation = 'پایش عادی';
+  let helpTip = 'برای دقت بیشتر، سنسور را محکم و نزدیک یاتاقان نصب کنید.';
+  if(fault==='Outer' || fault==='Inner' || fault==='Ball' || fault==='Cage'){
+    if(sev==='Slight') { recommendation='پایش هفتگی + چک روانکاری (NLGI 2) — تعویض در سرویس بعدی'; helpTip='عیب زودهنگام: اغلب با روانکاری یا تمیزکاری بهبود می‌یابد. طیف Envelope را چک کنید.'; }
+    else if(sev==='Moderate') { recommendation='برنامه تعویض 2–4 هفته آینده — قطعه یدکی سفارش شود'; helpTip='دامنه هارمونیک‌های BPFO/BPFI رو به رشد است. تاریخچه Trend را ببینید.'; }
+    else if(sev==='Serious') { recommendation='تعویض در توقف بعدی (1–2 هفته) — ریسک گسترش ترک'; helpTip='سطح ارتعاش ISO C/D: توقف بی‌برنامه نزدیک است. بازرسی Thermography هم انجام دهید.'; }
+    else { recommendation='توقف فوری — خطر قفل شدن یاتاقان و آسیب شافت'; helpTip='Extreme: دستگاه را زیر بار نگه ندارید. گزارش را به مدیر ارسال کنید.'; }
+  } else if(fault==='Normal'){
+    recommendation = 'وضعیت سالم — پایش ماهانه کافی است';
+    helpTip = 'نویز پس‌زمینه طبیعی است. برای مقایسه، Trend ماه گذشته را ببینید.';
+  }
+
+  // Generic for imbalance/misalignment (if kurt low but 1x high)
+  if(kurt < 2 && vel_mm_s > 2 && fault==='Normal'){
+    // could be imbalance
+    // evidence.push('1× FR dominant — احتمال نابالانسی');
+  }
+
+  return { primaryFault: fault, severity: sev, severityFa: severityFaMap[sev], score, evidence, recommendation, helpTip };
+}
