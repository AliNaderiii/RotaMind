+/**
+ * trending.ts — تاریخچه و روند (Scalar Trending)
+ * الهام: Emerson AMS scalar trending + SKF ProCollect trends + Schaeffler OPTIME dashboard
+ * ذخیره آفلاین در localStorage — بدون سرور
+ */
+
+export interface TrendPoint {
+  ts: number; // epoch ms
+  dateFa: string; // شمسی
+  rms_g: number;
+  peak_g: number;
+  kurt: number;
+  vel_mm_s: number;
+  isoZone: string;
+  aiFault: string;
+  aiConf: number;
+  rpm: number;
+  fileName: string;
+  note?: string;
+}
+
+const KEY = 'rotamind_trend_v1';
+
+export function loadTrends(): TrendPoint[] {
+  try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; }
+}
+export function saveTrends(list: TrendPoint[]) {
+  localStorage.setItem(KEY, JSON.stringify(list.slice(-200))); // نگه‌داری 200 نقطه
+}
+export function addTrend(p: TrendPoint) {
+  const list = loadTrends();
+  list.push(p);
+  saveTrends(list);
+  return list;
+}
+export function clearTrends() { localStorage.removeItem(KEY); }
+
+export function toCSV(list: TrendPoint[]): string {
+  const header = 'date,ts,rms_g,peak_g,kurt,vel_mm_s,isoZone,aiFault,aiConf,rpm,fileName';
+  const rows = list.map(x=> `${x.dateFa},${x.ts},${x.rms_g},${x.peak_g},${x.kurt},${x.vel_mm_s},${x.isoZone},${x.aiFault},${x.aiConf},${x.rpm},${x.fileName}`);
+  return [header, ...rows].join('\n');
+}
+
+// محاسبه نرخ رشد (برای پیش‌بینی)
+export function growthRate(list: TrendPoint[], key: keyof TrendPoint, window=5): number {
+  if(list.length < window) return 0;
+  const slice = list.slice(-window);
+  const y = slice.map(x=> Number(x[key]));
+  const x = slice.map((_,i)=> i);
+  // linear regression slope
+  const n=y.length, sumX=x.reduce((a,b)=>a+b,0), sumY=y.reduce((a,b)=>a+b,0);
+  const sumXY=x.reduce((s,xi,i)=> s+xi*y[i],0), sumXX=x.reduce((s,xi)=> s+xi*xi,0);
+  const slope = (n*sumXY - sumX*sumY)/(n*sumXX - sumX*sumX);
+  return slope;
+}
