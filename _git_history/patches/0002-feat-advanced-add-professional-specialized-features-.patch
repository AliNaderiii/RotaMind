+/**
+ * bearingDB.ts — پایگاه یاتاقان + محاسبه فرکانس عیب
+ * متخصص: مهندس مکانیک ارتعاشات + دیتا آنالیست
+ * الهام: Fluke 810 machine setup + SKF catalogue + Emerson fault frequency dashboard
+ */
+
+export interface BearingGeometry {
+  designation: string; // 6205, 6308, NU205...
+  type: 'ball' | 'roller' | 'taper';
+  n: number; // تعداد ساچمه
+  d: number; // قطر ساچمه mm
+  D: number; // قطر گام mm
+  alphaDeg: number; // زاویه تماس
+  dynamicLoad_kN?: number;
+  maxRPM?: number;
+}
+
+// دیتابیس اولیه — 12 یاتاقان پرکاربرد ایران (قابل گسترش به 200)
+export const BEARING_DB: BearingGeometry[] = [
+  { designation: '6205-2RS', type:'ball', n:9, d:7.94, D:39.04, alphaDeg:0, dynamicLoad_kN:14.8, maxRPM:18000 },
+  { designation: '6206', type:'ball', n:9, d:9.52, D:46.0, alphaDeg:0, dynamicLoad_kN:20.3, maxRPM:15000 },
+  { designation: '6308', type:'ball', n:8, d:15.08, D:65.0, alphaDeg:0, dynamicLoad_kN:42.3, maxRPM:11000 },
+  { designation: '6310', type:'ball', n:8, d:19.05, D:72.0, alphaDeg:0, dynamicLoad_kN:62, maxRPM:9000 },
+  { designation: 'NU205-E', type:'roller', n:12, d:7.5, D:39.5, alphaDeg:0, dynamicLoad_kN:28, maxRPM:12000 },
+  { designation: 'NU306', type:'roller', n:12, d:11, D:54, alphaDeg:0, dynamicLoad_kN:45, maxRPM:8000 },
+  { designation: '22210-E1', type:'roller', n:14, d:12, D:70, alphaDeg:0, dynamicLoad_kN:75, maxRPM:7000 },
+  { designation: '30205-A', type:'taper', n:16, d:7.2, D:36.5, alphaDeg:15, dynamicLoad_kN:32, maxRPM:14000 },
+  { designation: '7206-B', type:'ball', n:13, d:7.1, D:46, alphaDeg:40, dynamicLoad_kN:22, maxRPM:13000 },
+  { designation: '608-2RS', type:'ball', n:7, d:4.76, D:19, alphaDeg:0, dynamicLoad_kN:3.3, maxRPM:28000 },
+  { designation: 'UCP205', type:'ball', n:9, d:7.94, D:39.04, alphaDeg:0, dynamicLoad_kN:14, maxRPM:10000 },
+  { designation: 'Custom', type:'ball', n:9, d:7.94, D:39.04, alphaDeg:0 },
+];
+
+export interface FaultFreqs { FR:number; BPFO:number; BPFI:number; BSF:number; FTF:number; GMF?:number }
+
+export function calcFaultFreqs(g: BearingGeometry, rpm:number, gearTeeth?:number): FaultFreqs {
+  const FR = rpm/60;
+  const dD = g.d / g.D;
+  const cosA = Math.cos(g.alphaDeg * Math.PI/180);
+  const BPFO = (g.n/2) * FR * (1 - dD*cosA);
+  const BPFI = (g.n/2) * FR * (1 + dD*cosA);
+  const BSF = (g.D/(2*g.d)) * FR * (1 - Math.pow(dD*cosA,2));
+  const FTF = 0.5 * FR * (1 - dD*cosA);
+  const GMF = gearTeeth ? FR * gearTeeth : undefined;
+  return { FR, BPFO, BPFI, BSF, FTF, GMF };
+}
+
+// Harmonic series generator (for cursors)
+export function harmonicSeries(baseHz:number, count=5, bwHz=2): {f:number, label:string}[] {
+  return Array.from({length:count}, (_,i)=> ({ f: baseHz*(i+1), label: `${i+1}× ${baseHz.toFixed(1)}Hz` }));
+}
+
+export function sidebands(centerHz:number, modHz:number, count=2): {f:number, label:string}[] {
+  const out: {f:number,label:string}[] = [];
+  for(let i=1;i<=count;i++){ out.push({f:centerHz - i*modHz, label:`-${i}×`}); out.push({f:centerHz + i*modHz, label:`+${i}×`}); }
+  return out.sort((a,b)=>a.f-b.f);
+}
