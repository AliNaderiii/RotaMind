+/**
+ * llmCopilot.ts — LLM آفلاین Copilot — Ollama mock
+ */
+export function askCopilot(q:string, context:{rms:number, kurt:number, fault:string}): string{
+  const l=q.toLowerCase();
+  if(l.includes('bpfo')||l.includes('outer')) return `BPFO = ${(context.fault.includes('BPFO')?'تشخیص داده شد':'مشکوک')} — فرکانس Outer race. Kurtosis ${context.kurt.toFixed(1)} → ${context.kurt>5?'آسیب':'نرمال'}. اقدام: ${context.rms>1?'بازرسی فوری':'پایش'}.`;
+  if(l.includes('kurt')) return `Kurtosis ${context.kurt.toFixed(2)} — نرمال 3.0. ${context.kurt>6?'یاتاقان ضربه‌ای':'وضع سالم'}.`;
+  if(l.includes('rul')||l.includes('عمر')) return `RUL بر اساس روند RMS — اگر شیب منفی ادامه یابد، 20-40 روز تا Danger.`;
+  return `پاسخ Copilot (Ollama آفلاین): RMS ${context.rms.toFixed(2)}g — ${context.fault} — پیشنهاد: ${context.rms>1?'توقف':'پایش ماهانه'}.`;
+}
+export const COPILOT_SUGGESTIONS=['چرا BPFO؟','Kurtosis چیست؟','RUL چقدر است؟','چطور بالانس کنم؟'];
