+/**
+ * ceFile.ts — CE Technical File + FMEA + MTBF
+ */
+export interface FMEARow { component:string; failure:string; severity:number; occurrence:number; detection:number; rpn:number; }
+export function fmea(): FMEARow[]{
+  const rows:Omit<FMEARow,'rpn'>[]=[
+    {component:'ADXL1002',failure:'Drift',severity:6,occurrence:2,detection:7},
+    {component:'ESP32-S3',failure:'Watchdog reset',severity:5,occurrence:3,detection:8},
+    {component:'Battery',failure:'Capacity fade',severity:4,occurrence:4,detection:6},
+  ];
+  return rows.map(r=>({...r, rpn:r.severity*r.occurrence*r.detection}));
+}
+export function mtbf(lambda_per_mh:number){ const mtbf_h=1e6/lambda_per_mh; return {mtbf_h, mtbf_years: mtbf_h/8760};}
+export function ceChecklist(){ return ['EMC 2014/30/EU','LVD 2014/35/EU','RoHS 2011/65/EU','RED 2014/53/EU','ISO 10816-3'];}
