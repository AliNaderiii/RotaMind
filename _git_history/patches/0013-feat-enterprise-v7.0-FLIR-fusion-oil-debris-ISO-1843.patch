+/**
+ * iso50001.ts — گزارش انرژی ISO 50001
+ */
+export interface EnergyReport { dateFa:string; kwh:number; baseline_kwh:number; saving_pct:number; co2_kg:number; cost:number; verdict:string; }
+export function iso50001(kwh:number, baseline:number): EnergyReport{
+  const saving=(baseline-kwh)/baseline*100; const co2=kwh*0.45; const cost=kwh*0.08;
+  return {dateFa:new Date().toLocaleDateString('fa-IR'), kwh, baseline_kwh:baseline, saving_pct:saving, co2_kg:co2, cost, verdict: saving>5?'صرفه‌جویی معنی‌دار': saving<-5?'مصرف بالا — بررسی نابالانسی':'نرمال'};
+}
