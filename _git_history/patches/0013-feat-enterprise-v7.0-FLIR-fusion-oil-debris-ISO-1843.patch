+/**
+ * beamforming.ts — Acoustic Beamforming آرایه 4 میکروفون
+ */
+export function beamform(mics:Float64Array[], fs:number, angle_deg:number){
+  const delaySamples= Math.round(Math.sin(angle_deg*Math.PI/180)*2); // mock 2 samples per angle
+  const n=mics[0].length; let out=new Float64Array(n);
+  for(let i=0;i<n;i++){ let s=0; mics.forEach((m,idx)=>{ const d=delaySamples*idx; const j=i-d; if(j>=0) s+=m[j];}); out[i]=s/mics.length;}
+  const power= out.reduce((a,b)=>a+b*b,0)/n;
+  return {angle:angle_deg, power, source: power>0.3? 'نشتی/اصطکاک در '+angle_deg+'°' : 'نرمال'};
+}
+export function scanAngles(mics:Float64Array[], fs:number){ return [-60,-30,0,30,60].map(a=> beamform(mics,fs,a)); }
