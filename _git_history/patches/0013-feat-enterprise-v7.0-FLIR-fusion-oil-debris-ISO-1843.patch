+  if(fault.includes('BPFO')) return [
+    {idx:1,title:'ایزوله',desc:'برق را قطع و LOTO',model:'lock.glb',duration_s:60},
+    {idx:2,title:'باز کردن',desc:'4 پیچ M8',model:'bearing.glb',duration_s:120},
+    {idx:3,title:'تعویض',desc:'6208 جدید + گریس',model:'grease.glb',duration_s:180},
+  ];
+  return [{idx:1,title:'بازرسی',desc:'عمومی',model:'generic.glb',duration_s:60}];
+}
