+/**
+ * flirFusion.ts — دوربین حرارتی FLIR + همپوشانی ویبره
+ */
+export interface ThermalFrame { w:number; h:number; data:Float64Array; maxTemp:number; hotspot:{x:number,y:number,temp:number}; }
+export function mockFLIR(w=80,h=60): ThermalFrame{
+  const data=new Float64Array(w*h); let max=0, hx=0, hy=0;
+  for(let y=0;y<h;y++) for(let x=0;x<w;x++){ const v=35 + 15*Math.exp(-((x-w/2)**2+(y-h/2)**2)/400) + Math.random()*2; data[y*w+x]=v; if(v>max){max=v; hx=x; hy=y;}}
+  return {w,h,data,maxTemp:max, hotspot:{x:hx,y:hy,temp:max}};
+}
+export function fuseVibThermal(vib:number, temp:number){ return {score: vib*0.6 + (temp-40)*0.08, alarm: vib>4 || temp>75};}
