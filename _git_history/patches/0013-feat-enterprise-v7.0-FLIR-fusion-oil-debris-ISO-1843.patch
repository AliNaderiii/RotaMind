+ {id:1,q:'BPFO مربوط به کدام بخش یاتاقان است؟',options:['Inner race','Outer race','Ball','Cage'],answer:1,cat:'I'},
+ {id:2,q:'Kurtosis نرمال برای یاتاقان سالم؟',options:['1','3','6','10'],answer:1,cat:'II'},
+ {id:3,q:'Phase 180° بین دو یاتاقان نشان چیست؟',options:['Unbalance','Misalignment','Looseness','Resonance'],answer:1,cat:'II'},
