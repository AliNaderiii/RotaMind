+// ── Phase9: Streaming WASM — ring buffer + 50% overlap ──
+#[wasm_bindgen]
+pub struct StreamProcessor {
+    win: usize,
+    hop: usize,
+    buf: Vec<f32>,
+    frames: u32,
+}
+
+#[wasm_bindgen]
+impl StreamProcessor {
+    #[wasm_bindgen(constructor)]
+    pub fn new(win: usize, overlap_pct: f32) -> Self {
+        let overlap = (overlap_pct / 100.0).clamp(0.0, 0.9);
+        let hop = (win as f32 * (1.0 - overlap)) as usize;
+        Self { win, hop: hop.max(1), buf: Vec::new(), frames: 0 }
+    }
+    #[wasm_bindgen]
+    pub fn push(&mut self, chunk: Vec<f32>) -> usize {
+        self.buf.extend_from_slice(&chunk);
+        let mut produced = 0;
+        while self.buf.len() >= self.win {
+            produced += 1;
+            self.frames += 1;
+            self.buf.drain(0..self.hop);
+        }
+        produced
+    }
+    #[wasm_bindgen]
+    pub fn status_frames(&self) -> u32 { self.frames }
+    #[wasm_bindgen]
+    pub fn buffered(&self) -> usize { self.buf.len() }
+    #[wasm_bindgen]
+    pub fn process_frame(&self, frame: Vec<f32>) -> Vec<f32> {
+        fft_hann(frame)
+    }
+}
