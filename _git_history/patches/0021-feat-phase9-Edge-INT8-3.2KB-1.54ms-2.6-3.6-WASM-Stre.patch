+@app.post("/edge/quantize")
+async def edge_quantize():
+    base = Path(__file__).parent.parent
+    inp = base / "model" / "phyq_paper.onnx"
+    out = base / "model" / "phyq_paper.int8.onnx"
+    report = quantize_model_fp32_to_int8_report(inp)
