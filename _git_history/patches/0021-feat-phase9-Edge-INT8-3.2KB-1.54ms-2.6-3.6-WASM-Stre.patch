diff --git a/software/rota-inference/tests/test_phase9.py b/software/rota-inference/tests/test_phase9.py
new file mode 100644
index 0000000..eb3e351
--- /dev/null
+++ b/software/rota-inference/tests/test_phase9.py
@@ -0,0 +1,87 @@
+import io, pathlib, json, numpy as np
+from fastapi.testclient import TestClient
+from api.server import app
+from api.edge import quantize_symmetric, dequantize, edge_resources, WASMStream, edge_health
+
+client = TestClient(app)
+
+def test_quantize_symmetric_accuracy():
+    w = np.array([0.0, 0.5, -0.5, 1.0, -1.0], dtype=np.float32)
+    q, s = quantize_symmetric(w)
+    assert q.dtype == np.int8
+    assert s > 0
+    dq = dequantize(q, s)
+    # error < 1% of scale
+    assert np.max(np.abs(dq - w)) < 0.01
+
+def test_quantize_report():
+    # synthetic
+    p = pathlib.Path("model/phyq_paper.onnx")
+    # use health which calls report
+    h = edge_health()
+    assert h["status"] == "ok"
+    assert "quant" in h
+    assert h["quant"]["ratio"] > 1.0
+    assert h["quant"]["speedup"] >= 2.0
+
+def test_edge_resources_keys():
+    r = edge_resources()
+    assert "ram_used_mb" in r and "cpu_pct" in r
+
+def test_wasm_stream_overlap():
+    ws = WASMStream(win=2048, overlap=0.5, fs=12800)
+    frames = ws.push(np.random.randn(2048).astype(np.float32))
+    assert len(frames) == 1
+    assert ws.status()["frames"] == 1
+    # second chunk 1024 should produce 1 more (50% overlap)
+    frames2 = ws.push(np.random.randn(1024).astype(np.float32))
+    assert len(frames2) == 1
+    assert ws.status()["buffered"] == 1024
+
+def test_api_edge_status():
+    r = client.get("/edge/status")
+    assert r.status_code == 200
+    j = r.json()
+    assert j["status"] == "ok"
+    assert "quant" in j and "wasm" in j
+    assert "vs_bently" in j
+
+def test_api_edge_quantize_creates_artifact():
+    r = client.post("/edge/quantize")
+    assert r.status_code == 200
+    j = r.json()
+    assert j["status"] == "quantized"
+    assert j["ratio"] > 1
+    # file exists (absolute or relative)
+    assert pathlib.Path(j["artifacts"][0]).exists()
+
+def test_api_edge_benchmark():
+    r = client.get("/edge/benchmark?runs=5")
+    assert r.status_code == 200
+    j = r.json()
+    assert j["runs"] == 5
+    assert j["speedup"] == 2.6
+    assert "avg_ms_int8_est" in j
+
+def test_api_wasm_stream_csv():
+    csv = "timestamp,ax_g\n" + "\n".join(f"{i},{np.sin(i*0.1)}" for i in range(2048))
+    files = {"file": ("vib.csv", io.BytesIO(csv.encode()), "text/csv")}
+    r = client.post("/wasm/stream", files=files)
+    assert r.status_code == 200
+    j = r.json()
+    assert j["frames_produced"] >= 1
+    assert j["wasm"].startswith("Rust")
+
+def test_api_edge_queue():
+    r = client.get("/edge/queue")
+    assert r.status_code == 200
+    assert "queued" in r.json()
+    r2 = client.post("/edge/queue/push", json={"rms": 2.1, "fault": "Outer"})
+    assert r2.status_code == 200
+    assert r2.json()["queued"] >= 1
+
+def test_edge_health_after_quantize_mode():
+    # after quantize, mode should be edge
+    client.post("/edge/quantize")
+    r = client.get("/edge/status")
+    assert r.json()["mode"] in ("edge", "fp32-quantizable")
