@@ -0,0 +1,77 @@
+import numpy as np, io
+from fastapi.testclient import TestClient
+from api.server import app
+from api.twin import get_twin, fault_freqs
+from api.pinn import physics_residual, integrate_acceleration
+
+client = TestClient(app)
+
+def test_fault_freqs_close_to_theory():
+    fr=25.0  # 1500 RPM
+    f=fault_freqs(fr)
+    # SKF 6314 approx: BPFO ~3.07*fr=76.75
+    assert 70 < f["BPFO"] < 85
+    assert 115 < f["BPFI"] < 135
+
+def test_twin_simulate_shape():
+    tw=get_twin(rpm=1500)
+    out=tw.simulate(duration=0.16, fs=12800, fault="Outer")
+    assert len(out["signal"])==int(0.16*12800)==2048
+    assert out["fault"]=="Outer"
+    rms=float(np.sqrt(np.mean(out["signal"]**2)))
+    assert 0.05 < rms < 50
+
+def test_twin_rul_positive():
+    tw=get_twin(rpm=1500)
+    rul=tw.rul(2.5, crit=10.0)
+    assert rul["rul_hours"]>0
+    assert "beta" in rul
+
+def test_twin_kalman_sync():
+    tw=get_twin(rpm=1500)
+    before=tw.K
+    res=tw.kalman_sync(5.0)
+    assert "K_new" in res
+    assert res["innovation"] != 0
+
+def test_pinn_integrate():
+    acc=np.random.randn(2048).astype(float)
+    v,x=integrate_acceleration(acc, 12800)
+    assert len(v)==2048 and len(x)==2048
+
+def test_physics_residual_range():
+    sig=np.random.randn(2048).astype(np.float32)*0.3
+    r=physics_residual(sig, 12800, 1500, "Outer")
+    assert 0 <= r["physics_score"] <= 1
+    assert r["verdict"] in ["CONSISTENT","REVIEW","INCONSISTENT"]
+    assert "L_physics" in r
+
+def test_api_twin_status():
+    r=client.get("/twin/status?rpm=1500")
+    assert r.status_code==200
+    assert r.json()["rpm"]==1500
+    assert "K" in r.json()
+
+def test_api_twin_simulate():
+    r=client.post("/twin/simulate?fault=Outer&rpm=1800&fs=12800&duration=0.16")
+    assert r.status_code==200
+    j=r.json()
+    assert "signal" in j and j["fault"]=="Outer"
+
+def test_api_twin_rul():
+    r=client.get("/twin/rul?rms=2.5&crit=10&rpm=1500")
+    assert r.status_code==200
+    assert r.json()["rul_hours"]>0
+
+def test_api_pinn_physics():
+    r=client.get("/pinn/physics?rms=2.5")
+    assert r.status_code==200
+    assert "physics_score" in r.json()
+
+def test_api_pinn_score():
+    csv="timestamp,ax_g\n"+"\n".join(f"{i},{np.sin(2*np.pi*80*i/12800)}" for i in range(3000))
+    files={"file": ("vib.csv", io.BytesIO(csv.encode()), "text/csv")}
+    r=client.post("/pinn/score?rpm=1500&fs=12800", files=files)
+    assert r.status_code==200
+    j=r.json()
+    assert "physics" in j and "pred" in j
