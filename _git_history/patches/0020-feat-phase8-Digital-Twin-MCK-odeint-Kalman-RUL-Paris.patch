+"""
+pinn.py — Phase 8: Physics-Informed Neural Network (PINN) برای یاتاقان
+
+تئوری دقیق (Raissi 2019):
+
+ODE یاتاقان — M·x'' + C·x' + K·x = F(t)          (1)
+برای سیگنال اندازه‌گیری‌شده s(t) ≈ a(t)=x''(t)، باقیمانده فیزیکی:
+
+  R(t) = M·a(t) + C·v(t) + K·x(t) - F(t)       (2)
+  که v(t)=∫a dt, x(t)=∬a dt² (انتگرال عددی)
+
+PINN Loss = L_data + λ·L_physics
+  L_data   = CrossEntropy(logits, y)                    — برچسب داده
+  L_physics= mean(R²) / F_scale²                         — نقض فیزیک
+  λ ≈ 0.1-1.0 (قابل تنظیم)
+
+مزیت علمی:
+  • مدل فقط الگوهای سازگار با فیزیک (BPFO/BPFI) را می‌آموزد → تعمیم به ماشین جدید بدون داده زیاد
+  • physics_score = 1/(1+L_physics) — امتیاز سازگاری 0-1 برای هر پیش‌بینی
+  • vs Bently: black-box → ما physics-consistent + قابل تفسیر
+
+پیاده‌سازی: inference-time scorer (بدون نیاز به آموزش مجدد torch) — با نمدیک
+"""
+
+import numpy as np
+from typing import Dict, Tuple
+from api.twin import BEARING_GEOM, fault_freqs
+
+def integrate_acceleration(acc: np.ndarray, fs: int) -> Tuple[np.ndarray, np.ndarray]:
+    """a → v → x با انتگرال تجمعی + حذف drift (high-pass)"""
+    dt = 1.0 / fs
+    v = np.cumsum(acc) * dt
+    v = v - np.mean(v)  # detrending ساده
+    x = np.cumsum(v) * dt
+    x = x - np.mean(x)
+    return v, x
+
+def physics_residual(signal: np.ndarray, fs: int, rpm: float,
+                     fault: str = "Normal", geom=BEARING_GEOM, lam: float = 0.5) -> Dict:
+    """
+    signal: شتاب (پس از scaler) — 2048 نمونه
+    محاسبه R(t) و L_physics نرمال‌شده
+    """
+    fr = rpm/60.0
+    M, K = geom["M"], geom["K"]
+    zeta = geom["zeta"]
+    C = 2*zeta*np.sqrt(K*M)
+    # فرض signal = a(t) (m/s²) — مقیاس
+    a = signal.astype(np.float64)
+    v, x = integrate_acceleration(a, fs)
+
+    t = np.arange(len(a)) / fs
+    omega = 2*np.pi*fr
+    # نیروی نابالانسی
+    F_ub = geom["m_e"] * M * omega**2 * np.sin(omega*t) * 0.1
+    # نیروی عیب — فقط برای ارزیابی residual اگر fault معلوم باشد، وگرنه F= F_ub
+    F = F_ub
+    if fault != "Normal":
+        freqs = fault_freqs(fr, geom)
+        f_fault = {"Outer": freqs["BPFO"], "Inner": freqs["BPFI"], "Ball": freqs["BSF"], "Cage": freqs["FTF"]}.get(fault, freqs["BPFO"])
+        # تقریب Dirac comb به سینوس مدوله‌شده
+        F = F_ub + 3.0*np.sin(2*np.pi*f_fault*t) * np.exp(-0.5*np.abs(np.sin(2*np.pi*f_fault*t)))
+
+    R = M*a + C*v + K*x - F
+    # نرمال‌سازی
+    F_scale = max(np.std(F), 1.0)
+    L_physics = float(np.mean(R**2) / (F_scale**2 + 1e-9))
+    # physics score 0-1 (بالا = سازگار)
+    physics_score = float(1.0 / (1.0 + L_physics))
+    # consistency با فرکانس عیب — آیا انرژی در BPFO بالاست؟
+    from api.dsp_real import envelope_spectrum
+    try:
+        freqs_env, mag_env = envelope_spectrum(a.astype(np.float32), fs)
+        faults = fault_freqs(fr, geom)
+        # energy within ±2Hz of BPFO
+        bpfo = faults["BPFO"]
+        mask = (freqs_env > bpfo-2) & (freqs_env < bpfo+2)
+        e_bpfo = float(np.sum(mag_env[mask])) if np.any(mask) else 0.0
+        e_total = float(np.sum(mag_env)+1e-9)
+        fault_energy_ratio = e_bpfo / e_total
+    except Exception:
+        fault_energy_ratio = 0.0
+
+    return {
+        "L_physics": round(L_physics, 5),
+        "physics_score": round(physics_score, 3),
+        "fault_energy_ratio": round(fault_energy_ratio, 4),
+        "residual_rms": round(float(np.sqrt(np.mean(R**2))), 5),
+        "verdict": "CONSISTENT" if physics_score > 0.65 else "REVIEW" if physics_score > 0.35 else "INCONSISTENT",
+        "fault": fault, "fr": fr, "lambda": lam,
+        "note": "PINN residual R=M·a+C·v+K·x-F — منحصر به RotaMind (Siemens black-box ندارد)"
+    }
+
+def pinn_loss(logits: np.ndarray, label: int, L_physics: float, lam: float = 0.5) -> Dict:
+    """ترکیب نهایی Loss برای گزارش آموزش"""
+    # CrossEntropy
+    e = np.exp(logits - logits.max())
+    probs = e / e.sum()
+    ce = -np.log(max(probs[label], 1e-9))
+    total = float(ce + lam * L_physics)
+    return {
+        "ce": round(float(ce), 4),
+        "L_physics": round(float(L_physics), 5),
+        "loss": round(total, 4),
+        "lambda": lam,
+        "probs": probs.tolist()
+    }
+
+def score_prediction(signal: np.ndarray, pred_fault: str, logits: np.ndarray,
+                     fs: int, rpm: float) -> Dict:
+    """امتیازدهی نهایی — برای API"""
+    phys = physics_residual(signal, fs, rpm, fault=pred_fault)
+    # اگر Inconsistent ولی confidence بالا → هشدار
+    return {
+        "pred": pred_fault,
+        "physics": phys,
+        "trust": "HIGH" if phys["physics_score"] > 0.6 else "MEDIUM" if phys["physics_score"] > 0.35 else "LOW",
+        "pinn": pinn_loss(logits, ["Normal","Outer","Inner","Ball","Cage"].index(pred_fault), phys["L_physics"])
+    }
+
+if __name__ == "__main__":
+    sig = np.random.randn(2048).astype(np.float32)*0.3
+    print(physics_residual(sig, 12800, 1500, "Outer"))
