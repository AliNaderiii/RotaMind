@@ -0,0 +1,177 @@
+"""
+twin.py — Phase 8: Digital Twin فیزیکی یاتاقان/روتور (Precision Engineering)
+
+مدل مرجع:
+  جرم-فنر-دمپر دو درجه آزادی برای روتور صلب روی دو یاتاقان
+  M·x'' + C·x' + K·x = F_unbalance(t) + F_fault(t)      (1)
+
+  که:
+    M = جرم معادل روتور (kg)
+    C = 2ζ√(KM) — ζ نسبت میرایی (0.02-0.05 برای یاتاقان غلتشی)
+    K = سختی شعاعی یاتاقان (N/m) — تابع بار و پیش‌بار
+    F_unbalance = m·e·ω²·sin(ωt) — نابالانسی باقیمانده ISO 1940 G6.3
+    F_fault = Σ A_k·δ(t - k·T_fault)·exp(-ζ·ω_n·(t-k·T))·sin(ω_n·t) — قطار ضربه عیب
+
+  فرکانس‌های عیب (هندسه SKF 6314):
+    BPFO = (n/2)·fr·(1 - d/D·cosα)
+    BPFI = (n/2)·fr·(1 + d/D·cosα)
+    BSF  = (D/(2d))·fr·[1 - (d/D·cosα)²]
+    FTF  = (1/2)·fr·(1 - d/D·cosα)
+
+  RUL (پیش‌بینی عمر باقی‌مانده):
+    مدل تخریب نمایی Paris: a(t) = a0·exp(β·t) — β از fitting trends
+    RUL = (ln(a_crit) - ln(a(t))) / β
+
+این Twin با OPC UA همگام می‌شود و داده مصنوعی برای آموزش Federated تولید می‌کند.
+vs Bently: مدل تجربی → ما Physics-based + قابل کالیبراسیون
+"""
+
+import numpy as np
+from scipy.integrate import odeint
+from typing import Dict, Tuple, List
+
+# ── پارامترهای استاندارد روتور آزمایشگاهی (قابل کالیبراسیون) ──
+BEARING_GEOM = {
+    "n": 8, "d": 19e-3, "D": 70e-3, "alpha": 0.0,  # 6314 واقعاً D~70mm pitch
+    "M": 2.5, "zeta": 0.03, "K": 5e7, "m_e": 5e-5, "fn": 1800.0  # ω_n ساختار
+}
+
+def fault_freqs(fr: float, geom=BEARING_GEOM) -> Dict[str, float]:
+    n, d, D, a = geom["n"], geom["d"], geom["D"], geom["alpha"]
+    cos_a = np.cos(a)
+    return {
+        "BPFO": 0.5*n*fr*(1 - d/D*cos_a),
+        "BPFI": 0.5*n*fr*(1 + d/D*cos_a),
+        "BSF":  D/(2*d)*fr*(1 - (d/D*cos_a)**2),
+        "FTF":  0.5*fr*(1 - d/D*cos_a),
+        "fr": fr
+    }
+
+def _ode(state, t, M, C, K, fr, fault, geom):
+    x, v = state
+    omega = 2*np.pi*fr
+    # نابالانسی
+    F_ub = geom["m_e"] * geom["M"] * omega**2 * np.sin(omega*t) * 0.1  # scale
+    # قطار ضربه عیب — Dirac comb با decay نمایی
+    F_fault = 0.0
+    if fault != "Normal":
+        freqs = fault_freqs(fr, geom)
+        f_fault = {"Outer": freqs["BPFO"], "Inner": freqs["BPFI"], "Ball": freqs["BSF"], "Cage": freqs["FTF"]}.get(fault, freqs["BPFO"])
+        T = 1.0 / max(f_fault, 1e-9)
+        # نزدیک‌ترین ضربه
+        k = round(t / T)
+        tk = t - k*T
+        if abs(tk) < 0.0008:  # عرض ضربه 0.8ms
+            A = {"Outer": 12.0, "Inner": 15.0, "Ball": 9.0, "Cage": 5.0}.get(fault, 10.0)
+            decay = np.exp(-geom["zeta"]*2*np.pi*geom["fn"]*abs(tk))
+            F_fault = A * decay * np.sin(2*np.pi*geom["fn"]*tk)
+    # معادله
+    a = (F_ub + F_fault - C*v - K*x) / M
+    return [v, a]
+
+class RotorTwin:
+    """Digital Twin — state کالیبره‌شونده با OPC UA"""
+    def __init__(self, geom=BEARING_GEOM, rpm: float = 1500.0):
+        self.geom = dict(geom)
+        self.rpm = rpm
+        self.fr = rpm/60.0
+        self.M = self.geom["M"]
+        self.K = self.geom["K"]
+        self.C = 2*self.geom["zeta"]*np.sqrt(self.K*self.M)
+        self.state = np.array([0.0, 0.0])  # [x, v]
+        self.t = 0.0
+        # Kalman ساده (1D) برای sync
+        self.kalman_gain = 0.3
+        self.degradation_beta = 0.002  # از trends یاد گرفته می‌شود
+
+    def step(self, dt: float, fault: str = "Normal") -> Tuple[float, float, float]:
+        """انتگرال یک گام (RK4 via odeint single step)"""
+        t_span = [self.t, self.t + dt]
+        sol = odeint(_ode, self.state, t_span, args=(self.M, self.C, self.K, self.fr, fault, self.geom))
+        self.state = sol[-1]
+        self.t = t_span[1]
+        x, v = self.state
+        a = (self._force(self.t, fault) - self.C*v - self.K*x)/self.M
+        return float(x), float(v), float(a)
+
+    def _force(self, t, fault):
+        omega = 2*np.pi*self.fr
+        F_ub = self.geom["m_e"] * self.M * omega**2 * np.sin(omega*t) * 0.1
+        return F_ub  # fault داخل ode محاسبه می‌شود
+
+    def simulate(self, duration: float = 0.16, fs: int = 12800, fault: str = "Normal") -> Dict:
+        """تولید سیگنال مصنوعی — برای آموزش/اعتبارسنجی بدون داده واقعی"""
+        n = int(duration * fs)
+        dt = 1.0 / fs
+        xs = np.zeros(n); vs = np.zeros(n); ac = np.zeros(n)
+        # reset
+        self.state = np.array([0.0, 0.0]); self.t = 0.0
+        for i in range(n):
+            x, v, a = self.step(dt, fault=fault)
+            xs[i] = x; vs[i] = v; ac[i] = a
+        # شتاب → ولتاژ سنسور (scale نرمال‌شده به g, نویز)
+        # ac واقعی ~ 1e-3 m/s² → g ≈ ac/9.81, مقیاس‌گذاری برای RMS ≈0.5-5 g
+        signal = ac * 0.5 + np.random.normal(0, 0.08, n)
+        signal = signal.astype(np.float32)
+        return {
+            "signal": signal,
+            "x": xs, "v": vs, "a": ac,
+            "fs": fs, "rpm": self.rpm, "fault": fault,
+            "geom": self.geom, "duration": duration,
+            "note": "Physics-based synthetic — قابل استفاده برای Federated pre-training"
+        }
+
+    def kalman_sync(self, measured_rms: float):
+        """به‌روزرسانی ساده Twin با اندازه‌گیری OPC UA (innovation)"""
+        # تخمین فعلی دامنه
+        est_rms = float(np.sqrt(np.mean(self.state**2)) + 1e-9)
+        innovation = measured_rms - est_rms
+        # تصحیح K
+        self.K *= (1.0 + self.kalman_gain * innovation * 0.01)
+        self.C = 2*self.geom["zeta"]*np.sqrt(self.K*self.M)
+        return {"est_rms": est_rms, "innovation": innovation, "K_new": self.K}
+
+    def rul(self, current_indicator: float, crit: float = 10.0) -> Dict:
+        """Paris exponential: a(t)=a0·exp(βt) → RUL"""
+        beta = max(self.degradation_beta, 1e-6)
+        if current_indicator <= 0 or current_indicator >= crit:
+            return {"rul_hours": 0.0, "beta": beta, "status": "CRITICAL" if current_indicator>=crit else "INVALID"}
+        rul_h = (np.log(crit) - np.log(current_indicator)) / beta
+        return {
+            "rul_hours": round(float(rul_h), 1),
+            "rul_days": round(float(rul_h/24), 1),
+            "beta": beta,
+            "current": current_indicator,
+            "crit": crit,
+            "confidence": "MEDIUM" if 10 < rul_h < 1000 else "LOW",
+            "model": "Paris exponential a(t)=a0·exp(βt) — ISO 13381-1 RUL"
+        }
+
+    def fit_beta(self, trends: List[Dict]):
+        """کالیبراسیون β از تاریخچه trends (log-linear regression)"""
+        if len(trends) < 5:
+            return self.degradation_beta
+        vals = np.array([t.get("rms", t.get("vel", 1.0)) for t in trends[-30:]], dtype=float)
+        ts = np.array([t.get("ts", i*3600*1000) for i, t in enumerate(trends[-30:])], dtype=float)
+        ts_h = (ts - ts[0]) / 3600e3  # ساعت
+        # ln(a) = ln(a0) + β·t
+        y = np.log(np.maximum(vals, 1e-9))
+        # least squares
+        A = np.vstack([ts_h, np.ones(len(ts_h))]).T
+        beta, _ = np.linalg.lstsq(A, y, rcond=None)[0]
+        self.degradation_beta = float(np.clip(beta, 1e-5, 0.05))
+        return self.degradation_beta
+
+# singleton
+_twin: RotorTwin | None = None
+def get_twin(rpm: float = 1500) -> RotorTwin:
+    global _twin
+    if _twin is None or _twin.rpm != rpm:
+        _twin = RotorTwin(rpm=rpm)
+    return _twin
+
+if __name__ == "__main__":
+    tw = RotorTwin(rpm=1500)
+    out = tw.simulate(duration=0.16, fs=12800, fault="Outer")
+    print(f"sim {out['fault']} rms={np.sqrt(np.mean(out['signal']**2)):.3f} len={len(out['signal'])}")
+    print(tw.rul(2.5), tw.kalman_sync(2.8))
