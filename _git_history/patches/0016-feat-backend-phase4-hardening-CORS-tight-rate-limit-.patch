+from fastapi.testclient import TestClient
+from api.server import app
+import io
+
+client = TestClient(app)
+
+def test_health():
+    r = client.get("/health")
+    assert r.status_code == 200
+    assert r.json()["status"] == "ok"
+    assert "model" in r.json()
+
+def test_trends_crud():
+    r = client.post("/trends", json={"ts": 123, "rms": 1.2, "kurt": 3.5, "vel": 2.1, "fault":"Outer","rpm":1500})
+    assert r.status_code == 200
+    r2 = client.get("/trends")
+    assert r2.status_code == 200
+    assert len(r2.json()) >= 1
+
+def test_infer_needs_file():
+    # بدون فایل باید 422 بده
+    r = client.post("/infer")
+    assert r.status_code in (422, 400)
+
+def test_infer_with_csv():
+    csv = "timestamp,ax_g\n0,0.1\n1,0.2\n" + "\n".join([f"{i},0.05" for i in range(3000)])
+    files = {"file": ("test.csv", io.BytesIO(csv.encode()), "text/csv")}
+    r = client.post("/infer?rpm=1500&fs=12800", files=files)
+    assert r.status_code == 200
+    assert r.json()["fault"] in ["Normal","Outer","Inner","Ball","Cage"]
