+# ── Real DSP endpoints — جایگزین localStorage تزیینی ──
+TRENDS_FILE = Path(__file__).parent.parent / "model" / "trends.json"
+TRENDS_FILE.parent.mkdir(parents=True, exist_ok=True)
+if not TRENDS_FILE.exists():
