+
+class TrendPoint(BaseModel):
+    ts: int
+    rms: float
+    kurt: float
+    vel: float
+    fault: str
+    rpm: float
+
+@app.post("/dsp/envelope")
+async def dsp_envelope(request: Request, file: UploadFile = File(...), fs: int = 12800, rpm: float = 1500, x_api_key: str = Header(None)):
+    rate_limit(request)
+    check_api_key(x_api_key)
+    validate_upload(file.filename or "data.csv", 0)
+    data = await file.read()
+    text = data.decode('utf-8', errors='ignore')
+    lines = text.strip().splitlines()
+    vals = []
+    for line in lines[1:]:
+        try: vals.append(float(line.split(',')[1]))
+        except: continue
+    x = np.array(vals, dtype=np.float32)
+    freqs, mag = envelope_spectrum(x[:4096], fs)
+    faults = bearing_freqs(rpm)
+    return {"freqs": freqs[:800].tolist(), "mag": mag[:800].tolist(), "faults": faults, "samples": len(x)}
+
