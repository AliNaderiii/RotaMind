+"""
+security.py — Hardening layer for Phase 4
+• API-Key auth (offline-safe)
+• Rate limiting (5 req/s per IP)
+• Strict file validation
+"""
+import hashlib, time, secrets
+from fastapi import HTTPException, Header, Request
+from typing import Optional
+
+# در حالت آفلاین: کلید پیش‌فرض روی فایل لوکال، قابل تعویض
+API_KEYS = {"dev-rotamind-2026": "admin", "factory-key-001": "viewer"}
+
+# Simple in-memory rate limiter (per IP)
+_hits: dict[str, list[float]] = {}
+
+def check_api_key(x_api_key: Optional[str] = Header(None)):
+    if x_api_key is None:
+        return  # allow guest for MVP; در تولید: raise
+    if x_api_key not in API_KEYS:
+        raise HTTPException(status_code=401, detail="Invalid API-Key")
+
+def rate_limit(request: Request, max_per_sec: int = 5):
+    ip = request.client.host or "unknown"
+    now = time.time()
+    bucket = _hits.get(ip, [])
+    bucket = [t for t in bucket if now - t < 1.0]
+    if len(bucket) >= max_per_sec:
+        raise HTTPException(status_code=429, detail="Rate limit 5/s")
+    bucket.append(now)
+    _hits[ip] = bucket
+
+def validate_upload(filename: str, size: int, max_mb: int = 20):
+    if not filename.lower().endswith((".csv", ".txt", ".wav", ".edf")):
+        raise HTTPException(400, "Only .csv/.txt/.wav/.edf allowed")
+    if size > max_mb * 1024 * 1024:
+        raise HTTPException(413, f"File too large >{max_mb}MB")
+    if ".." in filename or "/" in filename or "\\" in filename:
+        raise HTTPException(400, "Invalid filename")
