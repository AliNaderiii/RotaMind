index 0000000..5fbad01
--- /dev/null
+++ b/software/rota-inference/api/db.py
@@ -0,0 +1,119 @@
+"""db.py — Phase 5: TimescaleDB hypertable + SQLAlchemy async (offline-safe fallback JSON)"""
+import os, json, time, uuid
+from pathlib import Path
+from typing import List, Optional
+from sqlalchemy.ext.asyncio import create_async_engine, AsyncSession, async_sessionmaker
+from sqlalchemy.orm import declarative_base, Mapped, mapped_column
+from sqlalchemy import String, Float, BigInteger, select, text
+from api.config import settings
+
+Base = declarative_base()
+
+class Trend(Base):
+    __tablename__ = "trends"
+    id: Mapped[str] = mapped_column(String(12), primary_key=True)
+    ts: Mapped[int] = mapped_column(BigInteger, index=True)  # epoch ms
+    rms: Mapped[float] = mapped_column(Float)
+    kurt: Mapped[float] = mapped_column(Float)
+    vel: Mapped[float] = mapped_column(Float)
+    fault: Mapped[str] = mapped_column(String(20))
+    rpm: Mapped[float] = mapped_column(Float)
+    dateFa: Mapped[str] = mapped_column(String(16))
+
+# زمان‌بندی: Timescale hypertable فقط روی Postgres فعال است
+HYPERTABLE_SQL = """
+CREATE TABLE IF NOT EXISTS trends (
+    id TEXT PRIMARY KEY,
+    ts BIGINT NOT NULL,
+    rms DOUBLE PRECISION,
+    kurt DOUBLE PRECISION,
+    vel DOUBLE PRECISION,
+    fault TEXT,
+    rpm DOUBLE PRECISION,
+    dateFa TEXT
+);
+SELECT create_hypertable('trends','ts', if_not_exists => TRUE, migrate_data => TRUE);
+CREATE INDEX IF NOT EXISTS idx_trends_fault ON trends(fault, ts DESC);
+"""
+
+TRENDS_FILE = Path(__file__).parent.parent / "model" / "trends.json"
+
+_engine = None
+_SessionLocal = None
+_is_postgres = False
+
+def _resolve_db_url() -> str:
+    # اولویت: env DATABASE_URL (docker-compose) > settings.database_url
+    raw = os.getenv("DATABASE_URL") or settings.database_url
+    # تبدیل psycopg2 URL به asyncpg برای SQLAlchemy async
+    if raw.startswith("postgresql://"):
+        raw = raw.replace("postgresql://", "postgresql+asyncpg://", 1)
+    if raw.startswith("postgres://"):
+        raw = raw.replace("postgres://", "postgresql+asyncpg://", 1)
+    return raw
+
+def get_engine():
+    global _engine, _SessionLocal, _is_postgres
+    if _engine is None:
+        url = _resolve_db_url()
+        _is_postgres = "postgres" in url or "asyncpg" in url
+        _engine = create_async_engine(url, echo=False, future=True)
+        _SessionLocal = async_sessionmaker(_engine, expire_on_commit=False)
+    return _engine
+
+async def init_db():
+    """ایجاد جدول + hypertable — صدا زدن در startup"""
+    eng = get_engine()
+    try:
+        async with eng.begin() as conn:
+            if _is_postgres:
+                await conn.execute(text(HYPERTABLE_SQL))
+            else:
+                await conn.run_sync(Base.metadata.create_all)
+    except Exception as e:
+        # offline-safe: لاگ کن و با JSON ادامه بده
+        print(f"⚠️ init_db fallback to JSON: {e}")
+
+# ── CRUD با fallback JSON ──
+
+async def db_add_trend(ts: int, rms: float, kurt: float, vel: float, fault: str, rpm: float) -> dict:
+    rec = {"id": str(uuid.uuid4())[:8], "ts": ts, "rms": rms, "kurt": kurt, "vel": vel, "fault": fault, "rpm": rpm, "dateFa": time.strftime("%Y-%m-%d")}
+    try:
+        eng = get_engine()
+        # اگر PG نیست و فایل DB وجود ندارد ولی fallback JSON هنوز لازم است — تلاش PG
+        async with _SessionLocal() as s:
+            s.add(Trend(**rec))
+            await s.commit()
+            return {"ok": True, "id": rec["id"], "backend": "timescale" if _is_postgres else "sqlite"}
+    except Exception as e:
+        # fallback JSON
+        TRENDS_FILE.parent.mkdir(parents=True, exist_ok=True)
+        if not TRENDS_FILE.exists():
+            TRENDS_FILE.write_text("[]")
+        arr = json.loads(TRENDS_FILE.read_text())
+        arr.append(rec)
+        TRENDS_FILE.write_text(json.dumps(arr[-500:], ensure_ascii=False, indent=2))
+        return {"ok": True, "id": rec["id"], "backend": f"json-fallback:{str(e)[:40]}"}
+
+async def db_get_trends(limit: int = 200) -> List[dict]:
+    try:
+        eng = get_engine()
+        async with _SessionLocal() as s:
+            res = await s.execute(select(Trend).order_by(Trend.ts.desc()).limit(limit))
+            rows = res.scalars().all()
+            return [{"id": r.id, "ts": r.ts, "rms": r.rms, "kurt": r.kurt, "vel": r.vel, "fault": r.fault, "rpm": r.rpm, "dateFa": r.dateFa} for r in rows]
+    except Exception:
+        if not TRENDS_FILE.exists():
+            return []
+        return json.loads(TRENDS_FILE.read_text())[-limit:]
+
+async def db_count() -> int:
+    try:
+        eng = get_engine()
+        async with _SessionLocal() as s:
+            res = await s.execute(text("SELECT COUNT(*) FROM trends"))
+            return int(res.scalar() or 0)
+    except Exception:
+        if not TRENDS_FILE.exists():
+            return 0
+        return len(json.loads(TRENDS_FILE.read_text()))
