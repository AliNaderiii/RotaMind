+    return await archive_to_parquet(older_than_days)
+
+@app.get("/healthz")
+async def healthz():
+    try:
+        n = await db_count()
+        backend = "timescale/sqlite"
+    except Exception:
+        n = -1
+        backend = "json"
+    return {"status":"ok","mode":"ONNX" if not MOCK_MODE else "MOCK","trends":n,"backend":backend,"version":"1.0.0-phase5"}
 
 @app.get("/")
 def root():
