+  backend-test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: { python-version: '3.11' }
+      - run: pip install -r software/rota-inference/requirements.txt
+      - run: PYTHONPATH=software/rota-inference pytest software/rota-inference/tests -v
+      - run: python software/rota-inference/api/dsp_real.py  # 50Hz ±5Hz test
+
+  frontend-build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
