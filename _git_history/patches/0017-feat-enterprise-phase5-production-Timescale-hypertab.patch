+"""metrics.py — Phase 5: Prometheus metrics (vs Bently System1 بدون observability)"""
+from prometheus_client import Counter, Histogram, Gauge, CONTENT_TYPE_LATEST, generate_latest
+from fastapi import Request
+import time
+
+REQ_COUNT = Counter("rotamind_requests_total", "Total requests", ["method","path","status"])
+REQ_LAT = Histogram("rotamind_request_latency_ms", "Latency ms", ["path"], buckets=[5,10,25,50,100,250,500,1000,2000])
+INFER_COUNT = Counter("rotamind_infer_total", "Infer calls", ["fault","mode"])
+DB_TRENDS = Gauge("rotamind_trends_rows", "Trends row count")
+
+def metrics_middleware(request: Request, status: int, latency_ms: float):
+    REQ_COUNT.labels(request.method, request.url.path, str(status)).inc()
+    REQ_LAT.labels(request.url.path).observe(latency_ms)
+
+def prometheus_bytes() -> tuple[bytes, str]:
+    return generate_latest(), CONTENT_TYPE_LATEST
