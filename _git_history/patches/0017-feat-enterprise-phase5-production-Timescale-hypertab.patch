+"""backup.py — Phase 5: Parquet archival (Timescale → S3/MinIO + cold storage vs Bently PI گران)"""
+import os, json, time
+from pathlib import Path
+from datetime import datetime, timedelta
+
+try:
+    import pandas as pd  # اختیاری
+    HAS_PD = True
+except ImportError:
+    HAS_PD = False
+
+from api.db import db_get_trends
+from api.config import settings
+
+async def archive_to_parquet(older_than_days: int = 30) -> dict:
+    """داده‌های قدیمی را به Parquet export کن (Cron روزانه)"""
+    rows = await db_get_trends(limit=5000)
+    if not rows:
+        return {"archived": 0, "reason": "no rows"}
+    cutoff = int((datetime.utcnow() - timedelta(days=older_than_days)).timestamp()*1000)
+    old = [r for r in rows if r["ts"] < cutoff]
+    if not old:
+        return {"archived": 0, "reason": f"no rows older than {older_than_days}d"}
+    out_dir = Path(settings.parquet_archive_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    fname = out_dir / f"trends_{datetime.utcnow().strftime('%Y%m%d')}.parquet"
+    if HAS_PD:
+        pd.DataFrame(old).to_parquet(fname, compression="zstd")
+    else:
+        # fallback JSONL اگر pandas نیست
+        fname = fname.with_suffix(".jsonl")
+        fname.write_text("\n".join(json.dumps(r) for r in old))
+    return {"archived": len(old), "file": str(fname), "compressed": HAS_PD}
