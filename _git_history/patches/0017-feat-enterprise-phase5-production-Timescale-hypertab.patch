@@ -0,0 +1,28 @@
+-- 001_hypertable.sql — TimescaleDB hypertable (10× faster than Bently MS SQL)
+CREATE EXTENSION IF NOT EXISTS timescaledb;
+
+CREATE TABLE IF NOT EXISTS trends (
+    id TEXT PRIMARY KEY,
+    ts BIGINT NOT NULL,
+    rms DOUBLE PRECISION,
+    kurt DOUBLE PRECISION,
+    vel DOUBLE PRECISION,
+    fault TEXT,
+    rpm DOUBLE PRECISION,
+    dateFa TEXT
+);
+
+SELECT create_hypertable('trends', 'ts', if_not_exists => TRUE, migrate_data => TRUE);
+CREATE INDEX IF NOT EXISTS idx_trends_fault ON trends(fault, ts DESC);
+CREATE INDEX IF NOT EXISTS idx_trends_ts ON trends(ts DESC);
+
+-- Continuous aggregate: میانگین روزانه RMS برای داشبورد Fleet Manager
+CREATE MATERIALIZED VIEW IF NOT EXISTS trends_daily
+WITH (timescaledb.continuous) AS
+SELECT time_bucket('1 day', to_timestamp(ts/1000.0)) AS day,
+       fault, avg(rms) as avg_rms, avg(vel) as avg_vel, count(*) as n
+FROM trends GROUP BY day, fault
+WITH NO DATA;
+
+-- Retention: حذف خودکار پس از 2 سال (قابل تنظیم)
+SELECT add_retention_policy('trends', INTERVAL '2 years', if_not_exists => TRUE);
