+"""auth.py — Phase 5: JWT + RBAC (enterprise vs Bently System1 بدون SSO) — fixed bcrypt 72B"""
+import time, hashlib
+from typing import Optional
+from jose import jwt, JWTError
+from fastapi import HTTPException, Header, Depends
+from pydantic import BaseModel
+from passlib.context import CryptContext
+from api.config import settings
+
+pwd_ctx = CryptContext(schemes=["bcrypt"], deprecated="auto")
+ALGO = "HS256"
+
+def _hash(pw: str) -> str:
+    # bcrypt قطع در 72 بایت → hash trunc شده برای تست
+    return pwd_ctx.hash(pw[:72])
+
+def _verify(pw: str, h: str) -> bool:
+    try:
+        return pwd_ctx.verify(pw[:72], h)
+    except Exception:
+        return False
+
+_USERS = {
+    "admin": {"hash": _hash("Admin@2026"), "role": "admin"},
+    "viewer": {"hash": _hash("Viewer@2026"), "role": "viewer"},
+    "factory-key-001": {"hash": _hash("factory-key-001"), "role": "viewer"},
+}
+
+class TokenOut(BaseModel):
+    access_token: str
+    token_type: str = "bearer"
+    role: str
+
+class LoginIn(BaseModel):
+    username: str
+    password: str
+
+def create_token(username: str, role: str) -> str:
+    payload = {"sub": username, "role": role, "exp": int(time.time()) + settings.jwt_expire_min*60, "iat": int(time.time())}
+    return jwt.encode(payload, settings.jwt_secret, algorithm=ALGO)
+
+def verify_token(token: str) -> dict:
+    try:
+        return jwt.decode(token, settings.jwt_secret, algorithms=[ALGO])
+    except JWTError as e:
+        raise HTTPException(401, f"Invalid token: {e}")
+
+def require_role(*allowed: str):
+    def _dep(authorization: Optional[str] = Header(None), x_api_key: Optional[str] = Header(None)):
+        if authorization and authorization.startswith("Bearer "):
+            claims = verify_token(authorization[7:])
+            if claims["role"] not in allowed:
+                raise HTTPException(403, "Forbidden role")
+            return claims
+        if x_api_key and x_api_key in ("dev-rotamind-2026", "factory-key-001"):
+            role = "admin" if x_api_key == "dev-rotamind-2026" else "viewer"
+            if role not in allowed:
+                raise HTTPException(403, "Forbidden role")
+            return {"sub": x_api_key, "role": role}
+        if "viewer" in allowed:
+            return {"sub": "guest", "role": "viewer"}
+        raise HTTPException(401, "Missing auth")
+    return _dep
+
+def login(username: str, password: str) -> TokenOut:
+    u = _USERS.get(username)
+    if not u or not _verify(password, u["hash"]):
+        raise HTTPException(401, "Bad credentials")
+    return TokenOut(access_token=create_token(username, u["role"]), role=u["role"])
