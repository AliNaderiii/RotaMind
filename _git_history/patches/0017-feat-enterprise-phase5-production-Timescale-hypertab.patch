+"""updater.py — Phase 5: OTA updater manifest generator (Tauri updater vs Bently manual patch)"""
+import json, hashlib
+from pathlib import Path
+
+def sign_artifact(path: Path, private_key_pem: str = "") -> str:
+    """در CI: tauri signer sign — اینجا mock SHA256"""
+    return hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else "mock-sig"
+
+def make_latest_json(version: str, base_url: str, artifacts: dict) -> dict:
+    """ساخت latest.json برای Tauri updater"""
+    return {
+        "version": version,
+        "notes": f"RotaMind {version} — PhyQ-TransNet ONNX + DSP WASM",
+        "pub_date": __import__("datetime").datetime.utcnow().isoformat()+"Z",
+        "platforms": {
+            plat: {"url": f"{base_url}/{info['file']}", "signature": info.get("sig","")}
+            for plat, info in artifacts.items()
+        }
+    }
