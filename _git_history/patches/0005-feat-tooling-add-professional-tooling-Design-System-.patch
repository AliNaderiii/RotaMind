+/**
+ * MetricCard.tsx — Storybook-ready component
+ * Usage: <MetricCard label="RMS" value="0.34" unit="g" status="good" hint="ISO مرجع" />
+ */
+import React from 'react';
+type Props = { label:string; value:string; unit?:string; status?:'good'|'warn'|'bad'; hint?:string; };
+export function MetricCard({ label, value, unit, status='good', hint }:Props){
+  const color = status==='good' ? '#059669' : status==='warn' ? '#d97706' : '#dc2626';
+  return (
+    <div style={{background:'var(--surface)',border:'1px solid var(--border)',borderRadius:8,padding:9}}>
+      <div style={{font:'600 9px Inter',letterSpacing:'.08em',textTransform:'uppercase',color:'var(--text-tertiary)',marginBottom:4}}>{label}</div>
+      <div style={{font:'600 14px JetBrains Mono',display:'flex',alignItems:'baseline',gap:4}}>{value}<small style={{font:'500 10px Inter',color:'var(--text-tertiary)'}}>{unit}</small></div>
+      {hint && <div style={{font:'500 10px Inter',color:'var(--text-tertiary)',marginTop:4,display:'flex',alignItems:'center',gap:4}}><span style={{width:6,height:6,borderRadius:'50%',background:color}}></span>{hint}</div>}
+    </div>
+  );
+}
+// Storybook stories (for Chromatic visual testing)
+// export default { title:'RotaLab/MetricCard', component: MetricCard };
