+/**
+ * useStore.ts — Zustand state management (professional)
+ * Replaces ad-hoc global vars — scalable to 100+ machines
+ */
+import { create } from 'zustand';
+
+interface Bearing { designation:string; n:number; d:number; D:number; alphaDeg:number; }
+interface Asset { id:string; name:string; bearing:string; rpm:number; }
+
+interface AppState {
+  // File
+  fileName: string | null;
+  fs: number;
+  channels: { label:string; samples: Float64Array; rms:number; peak:number }[];
+  viewStart: number; viewLen: number;
+  // Asset/Bearing
+  bearing: Bearing;
+  rpm: number;
+  isoClass: 'I'|'II'|'III'|'IV';
+  foundation: 'rigid'|'soft';
+  assets: any[];
+  // UI
+  activeView: 'wave'|'spec'|'waterfall'|'cepstrum';
+  showCursor: boolean; showPeakVue: boolean;
+  // Actions
+  setView: (v:any)=>void;
+  setBearing: (b:any)=>void;
+  setRpm: (n:number)=>void;
+  loadFile: (f:File)=>Promise<void>;
+}
+
+export const useStore = create<AppState>((set,get)=>({
+  fileName:null, fs:12800, channels:[], viewStart:0, viewLen:12800*10,
+  bearing:{ designation:'6205-2RS', n:9, d:7.94, D:39.04, alphaDeg:0 },
+  rpm:1500, isoClass:'II', foundation:'rigid', assets:[],
+  activeView:'wave', showCursor:true, showPeakVue:false,
+  setView:(v)=> set({activeView:v}),
+  setBearing:(b)=> set({ bearing:b }),
+  setRpm:(n)=> set({ rpm:n }),
+  loadFile: async (f)=>{ /* delegated to parser */ },
+}));
