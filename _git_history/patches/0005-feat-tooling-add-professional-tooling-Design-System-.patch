+/**
+ * IsoGauge.tsx — ISO 10816-3 traffic-light gauge
+ * Professional: no emoji, real thresholds, accessible
+ */
+import React from 'react';
+type Props = { zone:'A'|'B'|'C'|'D'; vel:number; action:string; color:string; label:string; };
+export function IsoGauge({ zone, vel, action, color, label }:Props){
+  return (
+    <div style={{display:'grid',gridTemplateColumns:'36px 1fr',gap:10,alignItems:'center',background:'var(--surface)',border:'1px solid var(--border)',borderRadius:9,padding:10}}>
+      <div style={{width:36,height:36,borderRadius:8,display:'grid',placeItems:'center',border:`1.5px solid ${color}55`,background:`${color}14`,color, font:'700 11px JetBrains Mono'}}>{zone}</div>
+      <div>
+        <div style={{font:'600 11px Inter',color}}>{label}</div>
+        <div style={{font:'500 10px JetBrains Mono',color:'var(--text-tertiary)'}}>{vel.toFixed(2)} mm/s RMS • ناحیه {zone}</div>
+        <div style={{font:'500 10px Inter',color:'var(--text-secondary)',marginTop:2}}>{action}</div>
+      </div>
+    </div>
+  );
+}
