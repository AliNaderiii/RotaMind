+"""
+scheduler.py — Intelligent Maintenance Scheduler
+vs Bently no-schedule → ما optimizer: RUL + cost + spare-parts + crew + downtime → min total cost
+
+الگوریتم: urgency scoring + greedy window packing (OR-Tools-style heuristic)
+ورودی: assets [{id, rul_h, criticality, downtime_cost_per_h, spare_lead_days}]
+خروجی: schedule windows با هزینه، صرفه‌جویی vs naive (fix on-failure)
+"""
+from __future__ import annotations
+import time
+import uuid
+from typing import Dict, List, Optional, Literal
+from dataclasses import dataclass, field
+from pydantic import BaseModel, Field
+
+# ── Domain models ──
+class SparePart(BaseModel):
+    part_id: str
+    name: str
+    stock: int = 1
+    lead_days: float = 7.0
+    cost: float = 1200.0
+    compatible_assets: List[str] = Field(default_factory=list)
+
+class AssetNeed(BaseModel):
+    asset_id: str
+    rul_h: float  # remaining useful life hours
+    criticality: Literal["LOW", "MEDIUM", "HIGH", "CRITICAL"] = "MEDIUM"
+    downtime_cost_per_h: float = 500.0
+    repair_hours: float = 4.0
+    spare_part_id: Optional[str] = None
+    failure_cost: float = 15000.0  # cost if run-to-failure
+
+class ScheduleWindow(BaseModel):
+    window_id: str
+    asset_id: str
+    start_h: float  # hours from now
+    end_h: float
+    type: str = "PREVENTIVE"  # PREVENTIVE | CORRECTIVE | OPPORTUNISTIC
+    crew: str = "crew-A"
+    spare_part_id: Optional[str] = None
+    spare_available: bool = True
+    estimated_cost: float
+    risk_if_delayed: str = "LOW"
+    urgency_score: float
+
+class SchedulePlan(BaseModel):
+    plan_id: str
+    created_at: float = Field(default_factory=time.time)
+    windows: List[ScheduleWindow] = Field(default_factory=list)
+    total_cost: float = 0.0
+    total_downtime_h: float = 0.0
+    naive_cost: float = 0.0
+    savings: float = 0.0
+    savings_pct: float = 0.0
+    constraints: dict = Field(default_factory=dict)
+
+# ── Constants ──
+CRIT_WEIGHT = {"LOW": 1.0, "MEDIUM": 2.0, "HIGH": 3.5, "CRITICAL": 5.0}
+CREWS = ["crew-A", "crew-B"]
+MAX_PARALLEL_PER_WINDOW = 2
+HORIZON_H = 720  # 30 days
+
+class SchedulerEngine:
+    """
+    Greedy urgency-based scheduler.
+    urgency = w_crit * (HORIZON / rul) + w_cost * log(downtime_cost) + w_fail * (failure_cost / 10000)
+    سپس pack در earliest feasible window با spare & crew constraints.
+    """
+    def __init__(self):
+        self.spare_parts: Dict[str, SparePart] = {}
+        self.plans: Dict[str, SchedulePlan] = {}
+        self._seed_spares()
+
+    def _seed_spares(self):
+        if self.spare_parts:
+            return
+        self.spare_parts["SP-6314"] = SparePart(part_id="SP-6314", name="SKF 6314 Bearing", stock=3, lead_days=5, cost=850, compatible_assets=["C101", "C102"])
+        self.spare_parts["SP-SEAL"] = SparePart(part_id="SP-SEAL", name="Mechanical Seal", stock=5, lead_days=3, cost=400, compatible_assets=["C101", "P201"])
+        self.spare_parts["SP-LUBE"] = SparePart(part_id="SP-LUBE", name="Lube Kit", stock=10, lead_days=1, cost=120, compatible_assets=["C101", "C102", "P201"])
+
+    def _urgency(self, a: AssetNeed) -> float:
+        # higher urgency = sooner
+        horizon_factor = max(0.1, HORIZON_H / max(a.rul_h, 1))
+        cost_factor = max(1, a.downtime_cost_per_h / 500)
+        fail_factor = a.failure_cost / 10000
+        return round(CRIT_WEIGHT[a.criticality] * horizon_factor * 0.5 + cost_factor * 0.3 + fail_factor * 0.2, 3)
+
+    def _feasible_start(self, a: AssetNeed, urgency: float) -> float:
+        # schedule before RUL, but not too early — optimal at 80% of RUL with safety margin
+        # برای RUL کوتاه (<48h) → فوری
+        if a.rul_h < 48:
+            return 2.0  # 2h from now
+        # برای بقیه: 0.7 * rul (20% safety buffer)
+        ideal = a.rul_h * 0.7
+        # criticality shifts earlier
+        shift = {"LOW": 1.0, "MEDIUM": 0.95, "HIGH": 0.85, "CRITICAL": 0.75}[a.criticality]
+        return round(min(ideal * shift, HORIZON_H - a.repair_hours), 1)
+
+    def optimize(self, assets: List[AssetNeed], horizon_h: float = HORIZON_H) -> SchedulePlan:
+        plan_id = f"PLAN-{uuid.uuid4().hex[:6]}"
+        # score & sort
+        scored = []
+        for a in assets:
+            u = self._urgency(a)
+            start = self._feasible_start(a, u)
+            scored.append((u, a, start))
+        scored.sort(key=lambda x: x[0], reverse=True)  # highest urgency first
+
+        windows: List[ScheduleWindow] = []
+        crew_next_free: Dict[str, float] = {c: 0.0 for c in CREWS}
+        total_cost = 0.0
+        total_downtime = 0.0
+        naive_cost = sum(a.failure_cost for a in assets)  # if run to failure
+
+        for urgency, asset, ideal_start in scored:
+            # spare check — spare_available reflects current stock only
+            spare_available = True
+            if asset.spare_part_id:
+                sp = self.spare_parts.get(asset.spare_part_id)
+                if sp:
+                    spare_available = sp.stock > 0
+                    if sp.stock <= 0:
+                        # delay by lead_days (ordering)
+                        ideal_start = max(ideal_start, sp.lead_days * 24)
+                else:
+                    spare_available = False
+
+            # crew assignment — earliest free crew
+            crew = min(crew_next_free, key=lambda c: crew_next_free[c])
+            start = max(ideal_start, crew_next_free[crew])
+            end = start + asset.repair_hours
+            if end > horizon_h:
+                # still schedule but mark risk
+                risk = "HIGH"
+            else:
+                risk = "HIGH" if asset.rul_h < 72 else "MEDIUM" if asset.rul_h < 240 else "LOW"
+
+            # cost: spare + downtime + crew
+            spare_cost = self.spare_parts[asset.spare_part_id].cost if asset.spare_part_id and asset.spare_part_id in self.spare_parts else 0
+            downtime_cost = asset.downtime_cost_per_h * asset.repair_hours
+            # preventive is 3× cheaper than failure
+            preventive_cost = round(spare_cost + downtime_cost + 200, 2)  # 200 crew
+            total_cost += preventive_cost
+            total_downtime += asset.repair_hours
+
+            wtype = "PREVENTIVE" if asset.rul_h > 48 else "CORRECTIVE"
+            # opportunistic: if another window within 24h on same site (simple heuristic)
+            # (not implemented fully — placeholder)
+
+            win = ScheduleWindow(
+                window_id=f"W-{uuid.uuid4().hex[:6]}",
+                asset_id=asset.asset_id,
+                start_h=round(start, 1),
+                end_h=round(end, 1),
+                type=wtype,
+                crew=crew,
+                spare_part_id=asset.spare_part_id,
+                spare_available=spare_available,
+                estimated_cost=preventive_cost,
+                risk_if_delayed=risk,
+                urgency_score=urgency
+            )
+            windows.append(win)
+            crew_next_free[crew] = end + 1  # 1h buffer between jobs
+
+        savings = round(naive_cost - total_cost, 2)
+        savings_pct = round((savings / naive_cost * 100) if naive_cost else 0, 1)
+
+        plan = SchedulePlan(
+            plan_id=plan_id,
+            windows=windows,
+            total_cost=round(total_cost, 2),
+            total_downtime_h=round(total_downtime, 1),
+            naive_cost=round(naive_cost, 2),
+            savings=savings,
+            savings_pct=savings_pct,
+            constraints={"horizon_h": horizon_h, "crews": CREWS, "max_parallel": MAX_PARALLEL_PER_WINDOW}
+        )
+        self.plans[plan_id] = plan
+        return plan
+
+    def get_plan(self, plan_id: str) -> Optional[SchedulePlan]:
+        return self.plans.get(plan_id)
+
+    def list_plans(self) -> List[SchedulePlan]:
+        return list(self.plans.values())
+
+    def list_spares(self) -> List[SparePart]:
+        return list(self.spare_parts.values())
+
+    def consume_spare(self, part_id: str, qty: int = 1) -> Optional[SparePart]:
+        sp = self.spare_parts.get(part_id)
+        if not sp:
+            return None
+        if sp.stock >= qty:
+            sp.stock -= qty
+        return sp
+
+    def clear(self):
+        self.plans.clear()
+        self.spare_parts.clear()
+        self._seed_spares()
+
+
+_scheduler: Optional[SchedulerEngine] = None
+
+def get_scheduler() -> SchedulerEngine:
+    global _scheduler
+    if _scheduler is None:
+        _scheduler = SchedulerEngine()
+    return _scheduler
