+        await hub.publish("live.trends", {"rms": 3.1})
+        rep = hub.replay("live.trends", 10)
+        assert len(rep) == 2
+        assert rep[-1]["payload"]["rms"] == 3.1
+        assert hub.stats()["messages_sent"] == 2
+    asyncio.run(run())
