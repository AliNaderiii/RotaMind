+/**
+ * digitalTwin.ts — Rotor Dynamics Digital Twin (Jeffcott)
+ */
+export interface TwinParams { mass:number; stiffness:number; damping:number; unbalance:number; rpm:number; }
+export function simulateTwin(p:TwinParams){
+  const omega=p.rpm*2*Math.PI/60;
+  const wn=Math.sqrt(p.stiffness/p.mass);
+  const zeta=p.damping/(2*Math.sqrt(p.stiffness*p.mass));
+  const r=omega/wn;
+  const amp= (p.unbalance*omega*omega / p.stiffness) / Math.sqrt((1-r*r)**2 + (2*zeta*r)**2);
+  const phase=Math.atan2(2*zeta*r, 1-r*r)*180/Math.PI;
+  return {amp, phase, wn, criticalRpm: wn*60/(2*Math.PI), resonance: Math.abs(r-1)<0.1};
+}
