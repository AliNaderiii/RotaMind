+/**
+ * calibration.ts — NIST Traceable Calibration Wizard
+ */
+export interface CalCert { sensorId:string; dateFa:string; dueFa:string; factor:number; traceable:string; }
+export function createCert(sensorId:string, factor:number): CalCert {
+  const now=new Date(); const due=new Date(now.getTime()+365*86400000);
+  return {sensorId, dateFa: now.toLocaleDateString('fa-IR'), dueFa: due.toLocaleDateString('fa-IR'), factor, traceable:'NIST SRM 2910'};
+}
+export function checkDue(cert:CalCert){ return new Date(cert.dueFa) < new Date() ? 'Expired' : 'Valid'; }
