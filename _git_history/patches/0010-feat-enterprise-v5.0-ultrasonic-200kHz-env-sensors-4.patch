+/**
+ * blockchainAudit.ts — لاگ تغییرناپذیر — Hash Chain
+ */
+export interface Block { index:number; ts:number; data:string; prevHash:string; hash:string; }
+function h(s:string){ let x=0; for(let i=0;i<s.length;i++) x=((x<<5)-x)+s.charCodeAt(i); return Math.abs(x).toString(16).padStart(8,'0'); }
+export function genesis(): Block { return {index:0, ts:Date.now(), data:'GENESIS', prevHash:'0', hash: h('GENESIS') };}
+export function addBlock(chain:Block[], data:string): Block {
+  const prev=chain[chain.length-1]; const b:Block={index:prev.index+1, ts:Date.now(), data, prevHash:prev.hash, hash: h(prev.hash+data+Date.now())};
+  return b;
+}
+export function verify(chain:Block[]){ for(let i=1;i<chain.length;i++) if(chain[i].prevHash!==chain[i-1].hash) return false; return true; }
