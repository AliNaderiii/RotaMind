+/**
+ * lubrication.ts — مدیریت روانکاری — OPTIME C4 Lubricator
+ */
+export interface LubePoint { id:string; asset:string; intervalDays:number; lastFa:string; nextFa:string; status:'OK'|'Due'|'Overdue'; }
+export function lubeSchedule(asset:string, interval=90): LubePoint {
+  const last=new Date(); const next=new Date(last.getTime()+interval*86400000);
+  return {id:'L-'+Date.now().toString(36), asset, intervalDays:interval, lastFa:last.toLocaleDateString('fa-IR'), nextFa:next.toLocaleDateString('fa-IR'), status:'OK'};
+}
+export function estimateGrease(bearing:string, rpm:number){ // g
+  const d={ '6208':20, '6306':15, '6206':10}[bearing]||15;
+  return Math.round(d * (rpm/1000) *0.6);
+}
