+/**
+ * ultrasonic.ts — Ultrasonic Envelope تا 200kHz + Magnetic field (Tractian)
+ */
+export function ultrasonicEnvelope(signal:Float64Array, fs:number, band:[number,number]=[20000,40000]){
+  // Mock bandpass + envelope
+  const mag=signal.reduce((a,b)=>a+Math.abs(b),0)/signal.length;
+  return {band, rms: mag*1.8, peak: mag*4.2, defect: mag>0.5 ? 'Ultrasonic defect suspected' : 'Normal'};
+}
+export function magneticField(voltage:Float64Array){ const rms=Math.sqrt(voltage.reduce((a,b)=>a+b*b,0)/voltage.length); return {field_uT: rms*120, anomaly: rms>0.8}; }
