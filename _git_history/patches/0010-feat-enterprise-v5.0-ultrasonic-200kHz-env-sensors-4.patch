+/**
+ * modal.ts — Modal Analysis FRF + EMA
+ */
+export function computeFRF(input:Float64Array, output:Float64Array, fs:number){
+  const n=input.length; let frf:number[]=[]; for(let k=0;k<400;k++){ const f=k*fs/2/400; let reI=0,imI=0,reO=0,imO=0; for(let i=0;i<n;i++){ const t=i/fs; reI+=input[i]*Math.cos(2*Math.PI*f*t); imI+=input[i]*Math.sin(2*Math.PI*f*t); reO+=output[i]*Math.cos(2*Math.PI*f*t); imO+=output[i]*Math.sin(2*Math.PI*f*t);} const magI=Math.hypot(reI,imI)+1e-9; frf.push(Math.hypot(reO,imO)/magI);} return frf;
+}
+export function findNaturalFreq(frf:number[], fs:number){ let max=0, idx=0; frf.forEach((v,i)=>{ if(v>max){max=v; idx=i;}}); return {freq: idx*fs/2/frf.length, mag:max};}
