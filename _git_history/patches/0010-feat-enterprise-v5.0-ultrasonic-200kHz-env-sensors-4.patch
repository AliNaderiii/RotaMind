+/**
+ * acoustic.ts — Acoustic Analysis + dB(A)
+ */
+export function acousticMetrics(signal:Float64Array, fs:number){
+  const rms=Math.sqrt(signal.reduce((a,b)=>a+b*b,0)/signal.length);
+  const db=20*Math.log10(rms/2e-5 +1e-9);
+  const dbA=db -2.5; // A-weighting mock
+  return {rms, dB: db, dBA: dbA, exceed: dbA>85};
+}
