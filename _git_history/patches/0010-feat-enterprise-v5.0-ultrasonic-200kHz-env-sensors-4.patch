+/**
+ * torsional.ts — Torsional Vibration
+ */
+export function torsionalVibration(speed:Float64Array, fs:number){
+  const mean=speed.reduce((a,b)=>a+b,0)/speed.length;
+  let jitter=0; for(let i=1;i<speed.length;i++) jitter+=Math.abs(speed[i]-speed[i-1]);
+  jitter/=speed.length;
+  return {meanRpm: mean, jitter, severity: jitter>5?'High': jitter>2?'Medium':'Low'};
+}
