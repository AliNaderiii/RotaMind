+"""
+dsp_real.py — جایگزین تزیینی TypeScript با SciPy واقعی (پل به Rust dsp-core)
+الهام: Dewesoft X + Crystal CoCo — Window correct, AmpCorr, Envelope Hilbert
+"""
+import numpy as np
+from scipy.signal import hilbert, get_window, welch, find_peaks
+from scipy.fft import rfft, rfftfreq
+
+def fft_hann_real(x: np.ndarray, fs: int):
+    n = len(x)
+    win = get_window('hann', n)
+    amp_corr = 2.0  # Hann
+    X = rfft(x * win)
+    mag = np.abs(X) / (n/2) * amp_corr
+    freqs = rfftfreq(n, 1/fs)
+    return freqs, mag
+
+def envelope_spectrum(x: np.ndarray, fs: int):
+    analytic = hilbert(x)
+    env = np.abs(analytic)
+    env = env - np.mean(env)
+    freqs, mag = fft_hann_real(env, fs)
+    return freqs, mag
+
+def bearing_freqs(rpm: float, bpfo_mult=3.07, bpfi_mult=4.93):
+    fr = rpm/60.0
+    return {"BPFO": fr*bpfo_mult, "BPFI": fr*bpfi_mult, "BSF": fr*2.0, "FTF": fr*0.38}
+
+def detect_peaks(mag, freqs, height=0.1):
+    peaks, _ = find_peaks(mag, height=height, distance=5)
+    return [(float(freqs[i]), float(mag[i])) for i in peaks[:10]]
+
+if __name__ == "__main__":
+    fs=12800; f0=50
+    t=np.arange(2048)/fs
+    sig=np.sin(2*np.pi*f0*t)
+    freqs,mag = fft_hann_real(sig, fs)
+    peak_freq = freqs[np.argmax(mag)]
+    print(f"Peak {peak_freq:.1f} Hz (expect 50) — {'PASS' if abs(peak_freq-50)<2 else 'FAIL'}")
