+
+def test_statistical_features_keys():
+    sig = np.random.randn(2048)
+    f = statistical_features(sig, 12800)
+    assert "rms" in f and "kurtosis" in f and "crest" in f
+
+def test_detect_normal():
+    # سینوس تمیز → نرمال
+    t = np.arange(2048)/12800
+    sig = np.sin(2*np.pi*50*t) + 0.05*np.random.randn(2048)
+    r = detect_anomaly(sig, 12800)
+    assert "ensemble_score" in r and "layers" in r
+    assert r["is_anomaly"] in (True, False)
+
+def test_detect_impulsive_anomaly():
+    sig = np.random.randn(2048)*0.3
+    # ضربه شدید
+    sig[500:520] += 10
+    sig[1000:1020] += 12
+    r = detect_anomaly(sig, 12800)
+    assert r["is_anomaly"] is True
+    assert r["anomaly_type"] == "UNKNOWN_IMPULSIVE"
+
+def test_drift_stable():
+    hist = np.random.normal(1.0, 0.2, 100).tolist()
+    curr = np.random.normal(1.0, 0.2, 100).tolist()
+    d = drift_metrics(hist, curr)
+    assert "psi" in d and d["drift_detected"] in (True, False)
+    assert d["psi_interpretation"] in ("stable","moderate","major drift")
+
+def test_drift_major():
+    hist = np.random.normal(1.0, 0.2, 100).tolist()
+    curr = np.random.normal(3.0, 0.2, 100).tolist()
+    d = drift_metrics(hist, curr)
+    assert d["psi"] > 0.25 and d["drift_detected"] is True
+
+def test_circuit_breaker():
+    cb = CircuitBreaker("test", failure_threshold=2, reset_timeout_s=1)
+    assert cb.can_try() is True
+    cb.record_failure(); cb.record_failure()
+    assert cb.state.value == "OPEN" and cb.can_try() is False
+
+def test_healer_health():
+    h = get_healer().health_check()
+    assert "state" in h and h["state"] in ("HEALTHY","DEGRADED","RECOVERING","FAILED")
+    assert "checks" in h
+
+def test_healer_remediate():
+    healer = get_healer()
+    # force open
+    healer.circuits["db"].failures = 3
