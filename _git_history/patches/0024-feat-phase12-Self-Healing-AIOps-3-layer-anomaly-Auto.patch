+    csv = "timestamp,ax_g\n" + "\n".join(f"{i},{v}" for i,v in enumerate(sig))
+    files = {"file": ("sig.csv", io.BytesIO(csv.encode()), "text/csv")}
+    r = client.post("/aiops/anomaly/detect?fs=12800", files=files)
