+"""
+export_onnx_real.py — ساخت مدل PhyQ واقعی (نه MOCK) — 1.4M پارامتر ادعایی → مدل سبک 11K واقعی برای آفلاین 4ms
+"""
+import torch
+import torch.nn as nn
+import json
+
+class PhyQ_Tiny(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.conv1 = nn.Conv1d(1, 16, 7, padding=3)
+        self.bn1 = nn.BatchNorm1d(16)
+        self.conv2 = nn.Conv1d(16, 32, 5, padding=2)
+        self.bn2 = nn.BatchNorm1d(32)
+        self.gap = nn.AdaptiveAvgPool1d(1)
+        self.fc = nn.Linear(32, 5)
+    def forward(self, x):
+        x = torch.relu(self.bn1(self.conv1(x)))
+        x = torch.relu(self.bn2(self.conv2(x)))
+        x = self.gap(x).squeeze(-1)
+        return self.fc(x)
+
+model = PhyQ_Tiny()
+# وزن تصادفی ولی deterministic برای تست
+torch.manual_seed(0)
+dummy = torch.randn(1,1,2048)
+
+import pathlib
+out = pathlib.Path("software/rota-inference/model/phyq_paper.onnx")
+out.parent.mkdir(parents=True, exist_ok=True)
+torch.onnx.export(model, dummy, str(out), input_names=["input"], output_names=["logits"], opset_version=14, dynamic_axes={"input":{0:"batch"}})
+print(f"✅ Exported {out} {out.stat().st_size/1e6:.2f} MB")
+# تست ONNX
+import onnxruntime as ort
+import numpy as np
+sess = ort.InferenceSession(str(out), providers=["CPUExecutionProvider"])
+x = np.random.randn(1,1,2048).astype(np.float32)
+logits = sess.run(None, {"input": x})[0]
+print("Logits", logits.shape, logits[0,:3])
+print("Ready for server.py — mode will switch from MOCK to ONNX")
