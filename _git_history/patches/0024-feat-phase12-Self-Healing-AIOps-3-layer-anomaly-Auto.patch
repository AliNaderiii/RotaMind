+def test_api_incident_ack_resolve():
+    # create an incident via correlation, then ack
+    # ensure at least one incident exists
+    client.post("/aiops/alerts", json={"asset_id": "C102", "severity": "High", "title": "high vib", "source": "anomaly", "metric": "vib", "value": 8.0, "threshold": 7.1})
+    client.post("/aiops/alerts", json={"asset_id": "C102", "severity": "High", "title": "high temp", "source": "opc", "metric": "temp", "value": 95, "threshold": 90})
+    client.post("/aiops/alerts", json={"asset_id": "C102", "severity": "High", "title": "rul low", "source": "twin", "metric": "rul", "value": 10, "threshold": 24})
+    incs = client.get("/aiops/incidents").json()
+    if incs:
+        iid = incs[0]["id"]
+        r = client.post(f"/aiops/incidents/{iid}/ack?actor=op1")
+        assert r.status_code == 200
+        r2 = client.post(f"/aiops/incidents/{iid}/resolve")
+        assert r2.status_code == 200
