+/**
+ * opcua.ts — OPC UA Read-Only Client Mock (آفلاین) — برای اتصال به DCS بدون Cloud
+ * مرجع: Bently Nevada System 1 OPC UA / Modbus TCP
+ */
+export interface OPCNode { nodeId:string; displayName:string; value:number; unit:string; ts:number; }
+export interface OPCConfig { endpoint:string; securityMode:'None'|'SignAndEncrypt'; }
+const KEY='rotamind_opc';
+export function mockBrowse(): OPCNode[] {
+  const now=Date.now();
+  return [
+    {nodeId:'ns=2;s=Compressor.C101.Speed', displayName:'C101 Speed', value:2980, unit:'RPM', ts:now},
+    {nodeId:'ns=2;s=Compressor.C101.Vib_DE', displayName:'C101 Vib DE', value:2.1, unit:'mm/s', ts:now},
+    {nodeId:'ns=2;s=Compressor.C101.Temp', displayName:'C101 Temp', value:68, unit:'°C', ts:now},
+    {nodeId:'ns=2;s=Pump.P202.Pressure', displayName:'P202 Pressure', value:4.2, unit:'bar', ts:now},
+  ];
+}
+export function connectOPC(cfg:OPCConfig): {connected:boolean; nodes:OPCNode[]} {
+  localStorage.setItem(KEY, JSON.stringify(cfg));
+  return {connected:true, nodes: mockBrowse()};
+}
+export function readOPC(nodeId:string): OPCNode|null { return mockBrowse().find(n=>n.nodeId===nodeId)||null; }
