+/**
+ * rulAdvanced.ts — RUL با LSTM Mock + Uncertainty — NASA Bearing Dataset style
+ */
+export interface RULAdvanced { days:number; ciLow:number; ciHigh:number; model:'LSTM-v2'; confidence:number; }
+export function predictRUL_LSTM(history:{ts:number, health:number}[]): RULAdvanced|null {
+  if(history.length<5) return null;
+  // LSTM mock: exponential decay fit
+  const n=history.length; const t0=history[0].ts; const xs=history.map(h=>(h.ts-t0)/86400000); const ys=history.map(h=>h.health);
+  let sx=0,sy=0,sxx=0,sxy=0; for(let i=0;i<n;i++){sx+=xs[i]; sy+=Math.log(Math.max(1,ys[i])); sxx+=xs[i]*xs[i]; sxy+=xs[i]*Math.log(Math.max(1,ys[i]));}
+  const slope=(n*sxy - sx*sy)/(n*sxx - sx*sx +1e-9);
+  const intercept=(sy - slope*sx)/n;
+  if(slope>= -0.001) return {days:999, ciLow:180, ciHigh:999, model:'LSTM-v2', confidence:0.45};
+  const days=(Math.log(20)-intercept)/slope - xs[n-1];
+  return {days: Math.max(1,Math.round(days)), ciLow: Math.max(1,Math.round(days*0.7)), ciHigh: Math.round(days*1.4), model:'LSTM-v2', confidence: Math.min(0.91, 0.6+ n*0.04)};
+}
