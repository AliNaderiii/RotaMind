+/**
+ * sap.ts — SAP PM / IBM Maximo Work Order Mock — تولید WO خودکار
+ * مرجع: Tractian Automatic Work Order
+ */
+export interface WorkOrder { id:string; ts:number; dateFa:string; asset:string; fault:string; severity:string; priority:'Low'|'Medium'|'High'|'Critical'; status:'Open'|'InProgress'|'Closed'; sop:string[]; }
+const KEY='rotamind_wo';
+export function createWorkOrder(asset:string, fault:string, severity:string): WorkOrder {
+  const priority= severity==='Extreme'?'Critical': severity==='Serious'?'High': severity==='Moderate'?'Medium':'Low';
+  const wo: WorkOrder={ id:'WO-'+Date.now().toString(36).toUpperCase(), ts:Date.now(), dateFa:new Date().toLocaleDateString('fa-IR'), asset, fault, severity, priority, status:'Open', sop: sopFor(fault) };
+  const list=loadWO(); list.push(wo); localStorage.setItem(KEY, JSON.stringify(list)); return wo;
+}
+export function loadWO(): WorkOrder[]{ try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch{return[]} }
+function sopFor(fault:string): string[] {
+  if(fault.includes('Outer')||fault.includes('BPFO')) return ['ایزوله تجهیز','بازرسی چشمی یاتاقان','تعویض یاتاقان','کنترل روانکاری'];
+  if(fault.includes('Unbalance')) return ['بالانس دینامیکی','کنترل فونداسیون'];
+  return ['بازرسی کلی','اندازه‌گیری مجدد'];
+}
+export function exportWOPDF(wo:WorkOrder): string { return `WO ${wo.id} | ${wo.asset} | ${wo.fault} | Priority ${wo.priority}\nSOP:\n${wo.sop.map((s,i)=>`${i+1}. ${s}`).join('\n')}`; }
