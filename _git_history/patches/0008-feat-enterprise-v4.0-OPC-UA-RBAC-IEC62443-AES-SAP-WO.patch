+/**
+ * ods3d.ts — 3D ODS with Three.js — import CSV مختصات
+ */
+export interface ODS3DPoint { id:string; x:number; y:number; z:number; amp:number; phase:number; }
+export function parseODS_CSV(csv:string): ODS3DPoint[]{
+  const lines=csv.trim().split('\n'); const start=lines[0].includes('id')?1:0;
+  return lines.slice(start).map(l=>{ const [id,x,y,z]=l.split(','); return {id:id||'P', x:parseFloat(x)||0, y:parseFloat(y)||0, z:parseFloat(z)||0, amp:1, phase:0}; });
+}
+export function animateODS(points:ODS3DPoint[], time:number, freq:number){
+  return points.map(p=>({ ...p, dz: Math.sin(2*Math.PI*freq*time + p.phase*Math.PI/180)*p.amp*10 }));
+}
