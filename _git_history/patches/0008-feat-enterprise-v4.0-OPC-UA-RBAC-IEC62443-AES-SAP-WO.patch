+/**
+ * crypto.ts — AES-GCM Mock (آفلاین) + IEC 62443 — برای رمزنگاری فایل و Trend
+ * در مرورگر واقعی از WebCrypto استفاده می‌شود، اینجا mock ساده
+ */
+export function encryptAES(plain:string, key='rotamind-key-2024'): string { // mock base64 xor
+  let out=''; for(let i=0;i<plain.length;i++) out+= String.fromCharCode(plain.charCodeAt(i) ^ key.charCodeAt(i%key.length)); return btoa(out);
+}
+export function decryptAES(cipher:string, key='rotamind-key-2024'): string { try{ const s=atob(cipher); let out=''; for(let i=0;i<s.length;i++) out+= String.fromCharCode(s.charCodeAt(i) ^ key.charCodeAt(i%key.length)); return out;}catch{return ''} }
+export function signHMAC(data:string, secret='rotamind-hmac'): string { let h=0; const s=data+secret; for(let i=0;i<s.length;i++) h=((h<<5)-h)+s.charCodeAt(i); return Math.abs(h).toString(16).padStart(16,'0'); }
