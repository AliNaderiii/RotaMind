+    {id:'5.4.2', clause:'Vibration Monitoring', desc:'Velocity RMS per ISO 10816-3', status:'Pass', note:'Implemented — iso10816.ts'},
+    {id:'5.4.3', clause:'Position Monitoring', desc:'Axial position with proximity probe', status:'NA', note:'Requires proximity hardware'},
+    {id:'6.2', clause:'Alarm Setpoints', desc:'Alert/Danger with voting logic', status:'Pass', note:'alarm.ts with Warn/Danger'},
+    {id:'7.1', clause:'Transient Capture', desc:'Waveform capture on alarm', status:'Pass', note:'streaming.ts 51.2kHz'},
