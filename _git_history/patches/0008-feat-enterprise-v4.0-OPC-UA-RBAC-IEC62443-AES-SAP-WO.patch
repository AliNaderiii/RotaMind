+/**
+ * db.ts — TimescaleDB Mock — جایگزین localStorage برای Trend حجیم
+ */
+export interface DBRow { ts:number; asset:string; metric:string; value:number; }
+const KEY='rotamind_db';
+export function dbInsert(row:DBRow){ const db=loadDB(); db.push(row); localStorage.setItem(KEY, JSON.stringify(db.slice(-5000))); }
+export function loadDB(): DBRow[]{ try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch{return[]} }
+export function dbQuery(asset:string, metric:string, days=30): DBRow[]{ const since=Date.now()-days*86400000; return loadDB().filter(r=>r.asset===asset && r.metric===metric && r.ts>=since); }
+export function dbStats(){ const db=loadDB(); return {rows:db.length, assets: new Set(db.map(r=>r.asset)).size}; }
