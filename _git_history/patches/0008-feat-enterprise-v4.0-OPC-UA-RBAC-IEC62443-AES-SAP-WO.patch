+/**
+ * auth.ts — RBAC + SSO Mock + IEC 62443 — آفلاین
+ */
+export type Role='viewer'|'analyst'|'supervisor'|'admin';
+export interface User { id:string; name:string; role:Role; hash:string; }
+const KEY='rotamind_users';
+const ROLE_PERMS: Record<Role,string[]> = {
+  viewer:['read'],
+  analyst:['read','analyse','route'],
+  supervisor:['read','analyse','route','approve','report'],
+  admin:['*']
+};
+export function hashPass(p:string){ let h=0; for(let i=0;i<p.length;i++) h=((h<<5)-h)+p.charCodeAt(i); return Math.abs(h).toString(16); }
+export function createUser(name:string, pass:string, role:Role): User { const u={id:'U-'+Date.now().toString(36), name, role, hash: hashPass(pass)}; const list=loadUsers(); list.push(u); localStorage.setItem(KEY, JSON.stringify(list)); return u; }
+export function loadUsers(): User[]{ try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch{return[]} }
+export function can(role:Role, perm:string){ const perms=ROLE_PERMS[role]||[]; return perms.includes('*')||perms.includes(perm); }
+export function currentUser(): User|null { try{return JSON.parse(localStorage.getItem('rotamind_current')||'null')}catch{return null} }
+export function login(name:string, pass:string): User|null { const u=loadUsers().find(x=>x.name===name && x.hash===hashPass(pass)); if(u) localStorage.setItem('rotamind_current', JSON.stringify(u)); return u||null; }
