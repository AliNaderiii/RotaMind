+# ── Phase 11: Autonomous Actions & Closed-Loop ──
+class EvaluateIn(BaseModel):
+    fault: str = "Outer"
+    severity: str = "Medium"
+    zone: str = "B"
+    rul_h: float = 500
+    trust: str = "HIGH"
+    physics_score: float = 0.7
+    rms: float = 3.5
+    rpm: float = 1500
+    asset_id: str = "C101"
+
+@app.get("/actions/policies")
+async def actions_policies():
+    return get_orchestrator().list_policies()
+
+@app.post("/actions/evaluate")
+async def actions_evaluate(body: EvaluateIn):
+    tel = body.model_dump()
+    return get_orchestrator().evaluate(tel)
+
+class ExecuteIn(BaseModel):
+    telemetry: Dict = {}
+    asset_id: str = "C101"
+
+@app.post("/actions/execute")
+async def actions_execute(body: ExecuteIn, request: Request, x_api_key: str = Header(None)):
+    tel = body.telemetry
+    if not tel:
+        tel = {}
+    # merge asset_id into telemetry for context
+    tel["asset_id"] = body.asset_id
+    res = get_orchestrator().execute(body.asset_id, tel, actor=x_api_key or "autonomous")
+    return [r.model_dump() for r in res]
+
+@app.post("/actions/approve/{exec_id}")
+async def actions_approve(exec_id: str, approver: str = "admin"):
+    orch = get_orchestrator()
+    ex = orch.approve(exec_id, approver)
+    if not ex:
+        raise HTTPException(404, "exec_id not found or not pending")
+    return ex.model_dump()
+
