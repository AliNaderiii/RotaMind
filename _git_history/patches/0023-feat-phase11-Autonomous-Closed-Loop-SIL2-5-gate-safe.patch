+from fastapi.testclient import TestClient
+from api.server import app
+from api.safety import safety_gate, risk_matrix
+from api.actions import get_orchestrator
+
+client = TestClient(app)
+
+def test_safety_gate_allow():
+    ok, reason, diag = safety_gate("C101", "opc_write_rpm", {"rpm": 1200})
+    assert ok is True
+    assert diag["risk"] in ("LOW","MEDIUM","HIGH")
+
+def test_safety_gate_bounds_deny():
+    ok, reason, _ = safety_gate("C101", "opc_write_rpm", {"rpm": 400})  # out of bounds
+    assert ok is False and "bounds" in reason
+
+def test_safety_gate_emergency():
+    ok, reason, _ = safety_gate("C101", "opc_write_stop", {"_mock_tags": {"emergency_stop": True}})
+    assert ok is False and "EMERGENCY_STOP" in reason
+
+def test_risk_matrix():
+    assert risk_matrix("High","D","LOW") == "CRITICAL_MANUAL"
+    assert risk_matrix("High","D","HIGH") == "CRITICAL_AUTO"
+
+def test_orchestrator_policies():
+    orch = get_orchestrator()
+    assert len(orch.list_policies()) == 4
+
+def test_evaluate_medium_outer():
+    orch = get_orchestrator()
+    tel = {"fault": "Outer", "severity": "Medium", "zone": "B", "rul_h": 500, "trust": "HIGH", "physics_score": 0.7, "rms": 3.5}
+    matched = orch.evaluate(tel)
+    assert any(m["policy"]["id"] == "POL-003-MEDIUM-WO" for m in matched)
+
+def test_execute_creates_workorder():
+    orch = get_orchestrator()
+    tel = {"fault": "Outer", "severity": "Medium", "zone": "B", "rul_h": 500, "trust": "HIGH", "physics_score": 0.7, "rms": 3.5}
+    res = orch.execute("C101", tel, actor="test")
+    assert any(r.action_type == "create_workorder" for r in res)
+    # workorder exists
+    assert len(orch.list_workorders("C101")) >= 1
+
+def test_execute_derate_auto():
+    orch = get_orchestrator()
+    tel = {"fault": "Outer", "severity": "High", "zone": "C", "rul_h": 100, "trust": "HIGH", "physics_score": 0.7, "rms": 4.0}
+    res = orch.execute("C102", tel, actor="test")
+    # should trigger derate (POL-002) without approval
+    assert any(r.action_type == "opc_write_rpm" and r.status == "EXECUTED" for r in res)
+
+def test_execute_critical_pending_approval():
+    orch = get_orchestrator()
+    tel = {"fault": "Outer", "severity": "High", "zone": "D", "rul_h": 10, "trust": "HIGH", "physics_score": 0.7, "rms": 19}
+    res = orch.execute("C103", tel, actor="test")
+    pend = [r for r in res if r.status == "PENDING_APPROVAL"]
+    assert len(pend) == 1
+    # approve it
+    ex = orch.approve(pend[0].exec_id, "admin")
+    assert ex.status in ("EXECUTED","DENIED_SAFETY")
+
+def test_api_policies():
+    r = client.get("/actions/policies")
+    assert r.status_code == 200 and len(r.json()) == 4
+
+def test_api_evaluate():
+    r = client.post("/actions/evaluate", json={"fault": "Outer", "severity": "Medium", "zone": "B", "rul_h": 500, "trust": "HIGH", "physics_score": 0.7, "asset_id": "C101"})
+    assert r.status_code == 200
+    assert any(p["policy"]["id"] == "POL-003-MEDIUM-WO" for p in r.json())
+
+def test_api_execute_and_workorders():
+    body = {"telemetry": {"fault": "Outer", "severity": "Medium", "zone": "B", "rul_h": 500, "trust": "HIGH", "physics_score": 0.7, "rms": 3.5}, "asset_id": "C101"}
+    r = client.post("/actions/execute", json=body)
+    assert r.status_code == 200
+    assert isinstance(r.json(), list)
+    r2 = client.get("/actions/workorders?asset_id=C101")
+    assert r2.status_code == 200 and len(r2.json()) >= 1
+
+def test_api_safety_check():
+    r = client.get("/actions/safety/check?asset_id=C101&action=opc_write_rpm&rpm=1200")
+    assert r.status_code == 200 and "allowed" in r.json()
+
+def test_api_approval_flow():
+    # create pending
+    body = {"telemetry": {"fault": "Outer", "severity": "High", "zone": "D", "rul_h": 10, "trust": "HIGH", "physics_score": 0.7, "rms": 19.0}, "asset_id": "C999"}
+    r = client.post("/actions/execute", json=body)
+    pend_ids = [x["exec_id"] for x in r.json() if x["status"] == "PENDING_APPROVAL"]
+    if pend_ids:
+        r2 = client.post(f"/actions/approve/{pend_ids[0]}?approver=admin")
+        assert r2.status_code == 200
+
+def test_api_history():
+    r = client.get("/actions/history?limit=5")
+    assert r.status_code == 200
+    assert isinstance(r.json(), list)
