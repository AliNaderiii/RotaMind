+const KEY='rotamind_audit';
+function hashStr(s:string){ let h=0; for(let i=0;i<s.length;i++) h=((h<<5)-h)+s.charCodeAt(i); h|=0; return Math.abs(h).toString(16).padStart(8,'0'); }
