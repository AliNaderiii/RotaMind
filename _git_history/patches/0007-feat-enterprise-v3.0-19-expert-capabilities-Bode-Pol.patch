+/**
+ * tacholess.ts — Tacholess RPM estimation from vibration
+ * الگوریتم: Autocorrelation peak tracking
+ */
+export function estimateRPM(signal:Float64Array, fs:number, minRpm=300, maxRpm=12000): number {
+  const minLag=Math.floor(fs/(maxRpm/60)); const maxLag=Math.floor(fs/(minRpm/60));
+  let bestLag=minLag, bestCorr=-Infinity;
+  const mean=signal.reduce((a,b)=>a+b,0)/signal.length;
+  const norm=signal.reduce((a,b)=>{const d=b-mean; return a+d*d;},0);
+  for(let lag=minLag; lag<=Math.min(maxLag, signal.length-1); lag++){
+    let corr=0; for(let i=0;i<signal.length-lag;i++) corr+=(signal[i]-mean)*(signal[i+lag]-mean);
+    corr/= (norm+1e-9);
+    if(corr>bestCorr){ bestCorr=corr; bestLag=lag; }
+  }
+  const rpm=60*fs/bestLag;
+  return Math.round(Math.max(minRpm, Math.min(maxRpm, rpm)));
+}
