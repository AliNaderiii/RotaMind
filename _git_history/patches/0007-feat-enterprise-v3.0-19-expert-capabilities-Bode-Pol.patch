+/**
+ * baseline.ts — Baseline & Historical Overlay (Emerson AMS baseline)
+ */
+export interface Baseline { id:string; ts:number; dateFa:string; spectrum:{freq:number[],amp:number[]}; rms:number; label:string; }
+const KEY='rotamind_baseline';
+export function saveBaseline(b:Baseline){ localStorage.setItem(KEY, JSON.stringify(b)); }
+export function loadBaseline(): Baseline|null { try{const v=localStorage.getItem(KEY); return v?JSON.parse(v):null}catch{return null} }
+export function clearBaseline(){ localStorage.removeItem(KEY); }
+export function compareToBaseline(current:{freq:number[],amp:number[]}, baseline:Baseline){
+  let maxDelta=0, maxFreq=0;
+  const n=Math.min(current.freq.length, baseline.spectrum.freq.length);
+  for(let i=0;i<n;i++){ const d=Math.abs(current.amp[i]-baseline.spectrum.amp[i]); if(d>maxDelta){maxDelta=d; maxFreq=current.freq[i];} }
+  return { maxDelta, maxFreq, growthPct: (maxDelta/(baseline.spectrum.amp[0]||1))*100 };
+}
