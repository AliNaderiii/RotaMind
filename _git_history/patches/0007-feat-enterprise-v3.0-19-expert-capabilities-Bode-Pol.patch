+/**
+ * bode.ts — Bode / Polar / Nyquist for Run-up & Coast-down
+ * مرجع: Emerson CSI 2140, Bently Nevada System 1 — 1X amplitude & phase vs RPM
+ */
+export interface BodePoint { rpm:number; amp:number; phase:number; }
+export interface PolarPoint { amp:number; phase:number; }
+
+// Simulate/shift from waterfall slices or real tach signal
+export function computeBode(slices:{rpm:number,samples:Float64Array,fs:number}[], targetFreqOrder=1): BodePoint[] {
+  return slices.map(s=>{
+    const n=s.samples.length;
+    let re=0,im=0;
+    const f0 = (s.rpm/60)*targetFreqOrder;
+    for(let i=0;i<n;i++){ const t=i/s.fs; re+=s.samples[i]*Math.cos(2*Math.PI*f0*t); im+=s.samples[i]*Math.sin(2*Math.PI*f0*t); }
+    re/=n; im/=n;
+    const amp=Math.hypot(re,im)*2;
+    const phase=Math.atan2(im,re)*180/Math.PI;
+    return { rpm:s.rpm, amp, phase: ((phase%360)+360)%360 };
+  });
+}
+export function findCriticalSpeed(bode:BodePoint[]): BodePoint|null {
+  if(!bode.length) return null;
+  return bode.reduce((a,b)=> a.amp>b.amp?a:b);
+}
+export function bodeToPolar(bode:BodePoint[]): PolarPoint[] { return bode.map(b=>({amp:b.amp, phase:b.phase})); }
