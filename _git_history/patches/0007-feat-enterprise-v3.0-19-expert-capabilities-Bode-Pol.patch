+/**
+ * rul.ts — Remaining Useful Life (RUL) — exponential degradation
+ * مرجع: Schaeffler OPTIME AI RUL
+ */
+export interface RULPoint { ts:number; health:number; } // health 0-100
+export interface RULResult { daysRemaining:number; predictedFailureDate:string; confidence:number; trend:string; healthNow:number; }
+export function predictRUL(history:RULPoint[], threshold=20): RULResult|null {
+  if(history.length<5) return null;
+  // Linear regression on health vs time
+  const n=history.length;
+  const t0=history[0].ts;
+  const xs=history.map(h=>(h.ts-t0)/86400000); // days
+  const ys=history.map(h=>h.health);
+  let sx=0,sy=0,sxx=0,sxy=0; for(let i=0;i<n;i++){ sx+=xs[i]; sy+=ys[i]; sxx+=xs[i]*xs[i]; sxy+=xs[i]*ys[i];}
+  const slope=(n*sxy - sx*sy)/(n*sxx - sx*sx + 1e-9);
+  const intercept=(sy - slope*sx)/n;
+  const healthNow=ys[ys.length-1];
+  if(slope>= -0.01) return { daysRemaining: 999, predictedFailureDate:'—', confidence:0.4, trend:'پایدار', healthNow };
+  const daysToThreshold = (threshold - intercept)/slope - xs[xs.length-1];
+  const daysRemaining=Math.max(1, Math.round(daysToThreshold));
+  const d=new Date(Date.now()+daysRemaining*86400000);
+  const confidence=Math.min(0.92, 0.5 + n*0.03);
+  const trend = slope<-1 ? 'نزولی تند — اقدام فوری' : slope<-0.3 ? 'نزولی' : 'پایدار';
+  return { daysRemaining, predictedFailureDate: d.toLocaleDateString('fa-IR'), confidence, trend, healthNow };
+}
+export function healthFromMetrics(rms:number, kurt:number, vel:number): number {
+  // 100 = سالم, 0 = خراب
+  let h=100;
+  h -= Math.min(40, (vel/4.5)*40);
+  h -= Math.min(30, Math.max(0, (kurt-3))*5);
+  h -= Math.min(20, (rms/5)*20);
+  return Math.max(5, Math.round(h));
+}
