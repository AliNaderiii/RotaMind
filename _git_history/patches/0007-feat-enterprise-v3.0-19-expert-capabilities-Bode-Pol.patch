+/**
+ * routeManager.ts — Route Manager (Fluke 810 / SKF QuickCollect)
+ * 50-200 نقطه، QR/Barcode, ترتیب بهینه, Complete/Skip, آفلاین
+ */
+export interface RoutePoint { id:string; asset:string; point:string; rpm:number; bearing:string; status:'pending'|'done'|'skip'; ts?:number; health?:number; }
+export interface Route { id:string; name:string; dateFa:string; points:RoutePoint[]; }
+const KEY='rotamind_routes';
+export function loadRoutes(): Route[]{ try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch{return[]} }
+export function saveRoutes(r:Route[]){ localStorage.setItem(KEY, JSON.stringify(r)); }
+export function createRoute(name:string, points:Omit<RoutePoint,'id'|'status'>[]): Route {
+  const r:Route={ id:'R-'+Date.now().toString(36), name, dateFa:new Date().toLocaleDateString('fa-IR'), points: points.map((p,i)=>({...p, id:`P-${i+1}`, status:'pending'})) };
+  const all=loadRoutes(); all.push(r); saveRoutes(all); return r;
+}
+export function updatePoint(routeId:string, pointId:string, patch:Partial<RoutePoint>){
+  const routes=loadRoutes(); const rt=routes.find(x=>x.id===routeId); if(!rt) return;
+  const pt=rt.points.find(p=>p.id===pointId); if(pt) Object.assign(pt,patch);
+  saveRoutes(routes);
+}
+export function routeProgress(route:Route){ const done=route.points.filter(p=>p.status==='done').length; return {done, total:route.points.length, pct:Math.round(done/route.points.length*100)}; }
