+/**
+ * mcsa.ts — Motor Current Signature Analysis (MCSA)
+ * تشخیص: میله شکسته روتور, ناهم‌محوری هوایی, اتصال کوتاه استاتور
+ */
+export interface MCSAPeak { freq:number; amp:number; label:string; severity:string; }
+export function computeMCSA(current:Float64Array, fs:number, lineFreq=50, slip=0.02): MCSAPeak[] {
+  const n=current.length;
+  // Simple FFT magnitude around sidebands
+  function goertzel(freq:number){
+    let re=0,im=0; for(let i=0;i<n;i++){ const t=i/fs; re+=current[i]*Math.cos(2*Math.PI*freq*t); im+=current[i]*Math.sin(2*Math.PI*freq*t);}
+    return Math.hypot(re,im)/n;
+  }
+  const peaks:MCSAPeak[]=[];
+  const fSup = lineFreq;
+  const side1 = lineFreq*(1-2*slip);
+  const side2 = lineFreq*(1+2*slip);
+  const a0=goertzel(fSup), a1=goertzel(side1), a2=goertzel(side2);
+  const db1=20*Math.log10((a1+1e-9)/(a0+1e-9));
+  peaks.push({freq:side1, amp:a1, label:`LSB ${(2*slip*lineFreq).toFixed(1)}Hz — میله شکسته؟`, severity: db1>-50?'High':db1>-60?'Medium':'Low'});
+  peaks.push({freq:side2, amp:a2, label:`USB ${(2*slip*lineFreq).toFixed(1)}Hz`, severity: db1>-50?'High':'Low'});
+  // Eccentricity: lineFreq ± fr
+  return peaks;
+}
+export function estimateSlip(rpm:number, syncRpm:number){ return (syncRpm-rpm)/syncRpm; }
+export function diagnoseMCSA(peaks:MCSAPeak[]): string {
+  const worst=peaks.reduce((a,b)=> a.amp>b.amp?a:b, peaks[0]);
+  if(!worst) return 'طبیعی';
+  if(worst.severity==='High') return 'هشدار: الگوی میله شکسته — بازرسی روتور';
+  if(worst.severity==='Medium') return 'مشکوک — روند را پایش کنید';
+  return 'طبیعی';
+}
