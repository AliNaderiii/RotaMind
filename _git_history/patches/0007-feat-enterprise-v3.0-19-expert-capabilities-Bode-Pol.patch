+/**
+ * tsa.ts — Time Synchronous Averaging for Gearbox
+ * مرجع: SKF Enlight AI Gearbox
+ */
+export function timeSynchronousAverage(signal:Float64Array, fs:number, rpm:number, numAverages=32): Float64Array {
+  const revSamples=Math.round(fs/(rpm/60));
+  if(revSamples<4) return signal.slice(0,1024);
+  const avgLen=revSamples;
+  const out=new Float64Array(avgLen); const cnt=new Float64Array(avgLen);
+  const revs=Math.floor(signal.length/revSamples);
+  const use=Math.min(revs, numAverages);
+  for(let r=0;r<use;r++){ for(let i=0;i<avgLen;i++){ out[i]+=signal[r*revSamples+i]; cnt[i]++; } }
+  for(let i=0;i<avgLen;i++) if(cnt[i]>0) out[i]/=cnt[i];
+  return out;
+}
+export function gearMeshFreq(rpm:number, teeth:number){ return rpm/60*teeth; }
+export function tsaResidual(tsa:Float64Array): Float64Array {
+  // Remove gear mesh harmonics via moving average
+  const w=Math.max(3, Math.round(tsa.length/32));
+  const ma=new Float64Array(tsa.length);
+  for(let i=0;i<tsa.length;i++){ let s=0,c=0; for(let k=-w;k<=w;k++){ const j=i+k; if(j>=0&&j<tsa.length){s+=tsa[j];c++;}} ma[i]=s/c; }
+  const res=new Float64Array(tsa.length); for(let i=0;i<tsa.length;i++) res[i]=tsa[i]-ma[i];
+  return res;
+}
