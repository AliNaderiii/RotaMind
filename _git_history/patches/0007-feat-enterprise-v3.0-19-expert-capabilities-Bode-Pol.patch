+/**
+ * phase.ts — Cross-Phase & ODS (Operating Deflection Shape)
+ * تشخیص: نابالانسی (0°), ناهمراستایی (180°), لقی
+ */
+export interface PhaseResult { deltaPhase:number; coherence:number; diagnosis:string; }
+export function computeCrossPhase(a:Float64Array, b:Float64Array, fs:number, f0:number): PhaseResult {
+  const n=a.length;
+  let reA=0,imA=0,reB=0,imB=0;
+  for(let i=0;i<n;i++){ const t=i/fs; const c=Math.cos(2*Math.PI*f0*t), s=Math.sin(2*Math.PI*f0*t); reA+=a[i]*c; imA+=a[i]*s; reB+=b[i]*c; imB+=b[i]*s; }
+  const phA=Math.atan2(imA,reA), phB=Math.atan2(imB,reB);
+  let delta=(phB-phA)*180/Math.PI; delta=((delta+180)%360)-180;
+  const absA=Math.hypot(reA,imA), absB=Math.hypot(reB,imB);
+  const coherence = (absA>1e-9 && absB>1e-9) ? Math.min(absA,absB)/Math.max(absA,absB) : 0;
+  let diagnosis='نامشخص';
+  if(Math.abs(delta)<30) diagnosis='هم‌فاز — نابالانسی محتمل';
+  else if(Math.abs(Math.abs(delta)-180)<30) diagnosis='غیرهم‌فاز 180° — ناهمراستایی محتمل';
+  else if(Math.abs(Math.abs(delta)-90)<20) diagnosis='90° — لقی یا رزونانس';
+  return { deltaPhase:delta, coherence, diagnosis };
+}
+export interface ODSPoint { id:string; x:number; y:number; amp:number; phase:number; }
+export function buildODS(points:{id:string,a:Float64Array}[], fs:number, f0:number): ODSPoint[] {
+  // Simplified ODS: relative amplitude/phase to first point
+  if(!points.length) return [];
+  const ref=points[0]; let re0=0,im0=0; for(let i=0;i<ref.a.length;i++){const t=i/fs; re0+=ref.a[i]*Math.cos(2*Math.PI*f0*t); im0+=ref.a[i]*Math.sin(2*Math.PI*f0*t);}
+  const amp0=Math.hypot(re0,im0)||1; const ph0=Math.atan2(im0,re0);
+  return points.map((p,idx)=>{
+    let re=0,im=0; for(let i=0;i<p.a.length;i++){const t=i/fs; re+=p.a[i]*Math.cos(2*Math.PI*f0*t); im+=p.a[i]*Math.sin(2*Math.PI*f0*t);}
+    const amp=Math.hypot(re,im)/amp0; const ph=Math.atan2(im,re)-ph0;
+    return { id:p.id, x: idx*60, y:0, amp, phase: ph*180/Math.PI };
+  });
+}
