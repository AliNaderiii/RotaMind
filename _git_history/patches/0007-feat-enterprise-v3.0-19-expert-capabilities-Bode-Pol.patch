+/**
+ * spectrogram.ts — STFT Spectrogram (time-frequency)
+ */
+export function stft(signal:Float64Array, fs:number, winSize=512, hop=256): {freqs:number[], times:number[], mag:number[][]} {
+  const nFrames=Math.floor((signal.length-winSize)/hop)+1;
+  const freqs=Array.from({length:winSize/2},(_,k)=> k*fs/winSize);
+  const times=Array.from({length:nFrames},(_,i)=> i*hop/fs);
+  const mag:number[][]=[];
+  // Hann window
+  const win=new Float64Array(winSize); for(let i=0;i<winSize;i++) win[i]=0.5*(1-Math.cos(2*Math.PI*i/(winSize-1)));
+  for(let f=0;f<nFrames;f++){
+    const off=f*hop; const frame=new Float64Array(winSize);
+    for(let i=0;i<winSize;i++) frame[i]=(signal[off+i]||0)*win[i];
+    // DFT magnitude (naive, acceptable for 512)
+    const row:number[]=[];
+    for(let k=0;k<winSize/2;k++){
+      let re=0,im=0; for(let i=0;i<winSize;i++){ const ang=2*Math.PI*k*i/winSize; re+=frame[i]*Math.cos(ang); im+=frame[i]*Math.sin(ang);}
+      row.push(Math.hypot(re,im)/winSize);
+    }
+    mag.push(row);
+  }
+  return {freqs, times, mag};
+}
