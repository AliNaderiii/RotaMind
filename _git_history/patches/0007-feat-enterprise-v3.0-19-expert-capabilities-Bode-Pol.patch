+/**
+ * explainable.ts — Explainable AI: highlight spectrum peaks that drove decision
+ */
+export interface ExplainRegion { freq:number; amp:number; weight:number; reason:string; }
+export function explainSpectrum(spectrum:{freq:number[],amp:number[]}, faultFreqs:{label:string,freq:number}[]): ExplainRegion[] {
+  const regions:ExplainRegion[]=[];
+  faultFreqs.forEach(f=>{
+    let bestAmp=0, bestFreq=f.freq;
+    for(let i=0;i<spectrum.freq.length;i++){
+      if(Math.abs(spectrum.freq[i]-f.freq)< f.freq*0.03){
+        if(spectrum.amp[i]>bestAmp){ bestAmp=spectrum.amp[i]; bestFreq=spectrum.freq[i]; }
+      }
+    }
+    if(bestAmp>0.01) regions.push({freq:bestFreq, amp:bestAmp, weight: Math.min(1, bestAmp*10), reason: `نزدیک ${f.label} (${f.freq.toFixed(1)}Hz)`});
+  });
+  return regions.sort((a,b)=> b.weight-a.weight);
+}
