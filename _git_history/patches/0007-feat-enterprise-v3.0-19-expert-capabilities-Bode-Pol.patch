+/**
+ * balancing.ts — Field Balancing single-plane & two-plane (ISO 1940)
+ * Trial weight method
+ */
+export interface BalancingInput { vib0:{amp:number,phase:number}, vibTrial:{amp:number,phase:number}, trialWeight:{mass:number,angle:number}, rotorMass?:number }
+export interface BalancingResult { correctionMass:number; correctionAngle:number; influenceCoeff:{amp:number,phase:number} }
+export function singlePlaneBalancing(inp:BalancingInput): BalancingResult {
+  // Vector: V0, V1
+  const toVec=(a:number,p:number)=>({x:a*Math.cos(p*Math.PI/180), y:a*Math.sin(p*Math.PI/180)});
+  const v0=toVec(inp.vib0.amp, inp.vib0.phase);
+  const v1=toVec(inp.vibTrial.amp, inp.vibTrial.phase);
+  const d={x:v1.x-v0.x, y:v1.y-v0.y};
+  const infAmp=Math.hypot(d.x,d.y)/(inp.trialWeight.mass||1);
+  const infPhase=Math.atan2(d.y,d.x)*180/Math.PI;
+  // Correction = -V0 / influence
+  const invInfAmp = 1/(infAmp||1e-9);
+  const corrAmp = inp.vib0.amp * invInfAmp;
+  const corrPhase = inp.vib0.phase - infPhase + 180;
+  return { correctionMass: corrAmp, correctionAngle: ((corrPhase%360)+360)%360, influenceCoeff:{amp:infAmp, phase:infPhase} };
+}
+export function twoPlaneBalancing(planeA:BalancingInput, planeB:BalancingInput){
+  return { planeA: singlePlaneBalancing(planeA), planeB: singlePlaneBalancing(planeB) };
+}
+export function iso1940Grade(mass:number, rpm:number, G=6.3){
+  const omega=rpm*2*Math.PI/60; const ePer = (G*1000)/omega; // µm
+  return { permissibleResidualU: ePer*mass/1000, grade:`G${G}`, ePer };
+}
