+        { id:'p1', name:'DE — یاتاقان جلو', bearing:'6205-2RS', rpm:1500, direction:'H' },
+        { id:'p2', name:'NDE — یاتاقان عقب', bearing:'6205-2RS', rpm:1500, direction:'V' },
+      ]},
+      { id:'m2', name:'گیربکس G-202', type:'Gearbox', isoClass:'III', foundation:'rigid', points:[
+        { id:'p3', name:'ورودی — شافت 1', bearing:'NU205-E', rpm:1500, direction:'H' },
