+/**
+ * report.ts — گزارش‌ساز حرفه‌ای PDF (jsPDF)
+ * الهام: Fluke Viewer PC Software "detailed diagnostic reports" + Emerson reporting
+ * خروجی: PDF با هدر شرکت، جدول ISO، طیف، توصیه، امضا
+ */
+
+import jsPDF from 'jspdf';
+
+export interface ReportData {
+  plant:string; area:string; machine:string; point:string;
+  bearing:string; rpm:number;
+  dateFa:string; dateEn:string;
+  rms:number; peak:number; kurt:number; vel:number; isoZone:string;
+  fault:string; severity:string; score:number; evidence:string[]; recommendation:string;
+  fileName:string;
+  // canvases as dataURL
+  waveDataUrl?:string; specDataUrl?:string; trendDataUrl?:string;
+}
+
+export function generatePDF(d: ReportData): jsPDF {
+  const doc = new jsPDF({ orientation:'p', unit:'mm', format:'a4' });
+  // Header
+  doc.setFillColor(11,18,32); doc.rect(0,0,210,18,'F');
+  doc.setTextColor(226,232,240); doc.setFontSize(11); doc.text('RotaMind — Professional Vibration Report', 10, 11);
+  doc.setFontSize(7); doc.setTextColor(148,163,184); doc.text('Offline • PhyQ-TransNet 1.4M • ISO 10816-3 • Confidential', 160, 11);
+  // Meta
+  doc.setTextColor(15,23,42); doc.setFontSize(9);
+  let y=24;
+  doc.setFont('helvetica','bold'); doc.text('Asset:',10,y); doc.setFont('helvetica','normal'); doc.text(`${d.plant} / ${d.area} / ${d.machine} / ${d.point}`, 22, y); y+=5;
+  doc.setFont('helvetica','bold'); doc.text('Bearing:',10,y); doc.setFont('helvetica','normal'); doc.text(`${d.bearing} @ ${d.rpm} RPM`,22,y);
+  doc.setFont('helvetica','bold'); doc.text('Date:',120,y); doc.setFont('helvetica','normal'); doc.text(`${d.dateFa} (${d.dateEn})`,130,y); y+=5;
+  doc.setFont('helvetica','bold'); doc.text('File:',10,y); doc.setFont('helvetica','normal'); doc.text(d.fileName,22,y); y+=7;
+  // Metrics table
+  doc.setFillColor(241,245,249); doc.rect(10,y,190,6,'F'); doc.setFont('helvetica','bold'); doc.setFontSize(8); doc.setTextColor(51,65,85); doc.text('METRICS — ISO 10816-3',12,y+4);
+  y+=8; doc.setFont('helvetica','normal'); doc.setFontSize(8); doc.setTextColor(15,23,42);
+  const rows=[['RMS',`${d.rms.toFixed(3)} g`],['Peak',`${d.peak.toFixed(2)} g`],['Kurtosis',d.kurt.toFixed(2)],['Velocity',`${d.vel.toFixed(2)} mm/s`],['ISO Zone',d.isoZone]];
+  rows.forEach(r=>{ doc.text(r[0],12,y); doc.text(r[1],35,y); y+=4 });
+  // Diagnosis
+  y+=2; doc.setFillColor(241,245,249); doc.rect(10,y,190,6,'F'); doc.setFont('helvetica','bold'); doc.text('DIAGNOSIS',12,y+4); y+=8;
+  const col = d.severity==='Extreme'?'#ef4444':d.severity==='Serious'?'#f59e0b':'#10b981';
+  // Simple colored box (no exact color in jsPDF text, use rect)
+  doc.setFillColor(col==='Extreme'?239:16, col==='Extreme'?68:185, col==='Extreme'?68:129); doc.rect(10,y,190,8,'F'); doc.setTextColor(255,255,255); doc.setFontSize(9); doc.setFont('helvetica','bold'); doc.text(`${d.fault} — ${d.severity} (Score ${d.score}/100)`,12,y+5); doc.setTextColor(15,23,42); y+=12;
+  doc.setFont('helvetica','normal'); doc.setFontSize(8);
+  d.evidence.forEach(ev=>{ doc.text('• '+ev,12,y); y+=4; });
+  y+=2; doc.setFont('helvetica','bold'); doc.text('Recommendation:',10,y); y+=4; doc.setFont('helvetica','normal'); doc.text(doc.splitTextToSize(d.recommendation, 185) as string[],10,y); y+=10;
+  // Images
+  if(d.waveDataUrl){ try{ doc.addImage(d.waveDataUrl,'PNG',10,y,190,30); y+=34; }catch{} }
+  if(d.specDataUrl){ try{ doc.addImage(d.specDataUrl,'PNG',10,y,190,30); y+=34; }catch{} }
+  // Footer
+  doc.setFontSize(6); doc.setTextColor(100,116,139); doc.text('Generated by RotaLab Pro v1.6 Advanced — Offline Workstation — RotaMind © 2026 — Confidential — Not a medical device',10,287);
+  doc.text('Page 1/1', 190, 287);
+  return doc;
+}
