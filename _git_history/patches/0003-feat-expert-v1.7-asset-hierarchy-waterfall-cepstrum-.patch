+/**
+ * cepstrum.ts — Cepstrum برای گیربکس (تشخیص sideband family)
+ * متخصص: ارتعاشات گیربکس — الهام: Emerson AMS "gear analysis", Brüel & Kjær
+ * Cepstrum = IFFT(log(|FFT(x)|)) — قله در quefrency = فاصله هارمونیک‌ها
+ */
+
+export function computeCepstrum(x: Float64Array, fs: number): { quefrency: Float64Array, cep: Float64Array } {
+  const n = 1 << Math.ceil(Math.log2(x.length));
+  const re = new Float64Array(n), im = new Float64Array(n);
+  // Window + FFT (naive for MVP, in prod use FFT.ts)
+  for(let i=0;i<x.length;i++){ const w=0.5*(1-Math.cos(2*Math.PI*i/(x.length-1))); re[i]=x[i]*w; }
+  // Naive DFT for magnitude
+  const mag = new Float64Array(n/2);
+  for(let k=0;k<n/2;k++){ let r=0, ii=0; for(let i=0;i<n;i++){ const ang=2*Math.PI*k*i/n; r+=re[i]*Math.cos(ang); ii-=re[i]*Math.sin(ang);} mag[k]=Math.log(Math.sqrt(r*r+ii*ii)+1e-12); }
+  // IFFT cepstrum (naive)
+  const cep = new Float64Array(n/2), quefrency = new Float64Array(n/2);
+  for(let q=0;q<n/2;q++){
+    let s=0; for(let k=0;k<n/2;k++){ s+= mag[k]*Math.cos(2*Math.PI*q*k/(n/2)); }
+    cep[q]=s/(n/2); quefrency[q]=q/fs*n;
+  }
+  return { quefrency, cep };
+}
+
+/**
+ * Spectral Kurtosis + Kurtogram — انتخاب باند بهینه برای Envelope
+ * الهام: Antoni 2006, Emerson PeakVue band selection
+ */
+export function spectralKurtosisBand(x: Float64Array, fs:number, nperseg=256): {centerHz:number, bwHz:number, kurt:number, suggestion:string}{
+  // محاسبه Kurtosis در هر باند — ساده شده
+  let bestK=-Infinity, bestF=0, bestBW=0;
+  const bands = [500,1000,2000,4000]; // Hz
+  for(const bw of bands){
+    for(let cf=bw/2; cf<fs/2-bw/2; cf+=bw/2){
+      // Extract band via simple filter (mock) — kurt of envelope
+      let m4=0,m2=0; const n=x.length;
+      for(let i=0;i<n;i++){ const v=x[i]*Math.sin(2*Math.PI*cf*i/fs); m2+=v*v; m4+=v*v*v*v; }
+      m2/=n; m4/=n; const kurt=m4/(m2*m2+1e-12)-3;
+      if(kurt>bestK){ bestK=kurt; bestF=cf; bestBW=bw; }
+    }
+  }
+  let suggestion = bestK>5? "باند انتخاب شده دارای ضربات شدید — Envelope ایده‌آل" : bestK>1? "باند متوسط — قابل قبول" : "سیگنال بدون ضربه واضح — Raw بهتر است";
+  return { centerHz:bestF, bwHz:bestBW, kurt:bestK, suggestion };
+}
