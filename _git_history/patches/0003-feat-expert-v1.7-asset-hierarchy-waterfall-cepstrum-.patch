+/**
+ * waterfall.ts — Waterfall / Cascade (Emerson) برای Run-up / Coast-down
+ * نگهداری تاریخچه طیف‌ها برای نمایش waterfall — آفلاین
+ */
+
+export interface WaterfallSlice { ts:number, rpm:number, spectrum: Float64Array, freqs: Float64Array }
+
+export class WaterfallStore {
+  slices: WaterfallSlice[] = [];
+  maxSlices = 20;
+  add(s:WaterfallSlice){ this.slices.push(s); if(this.slices.length>this.maxSlices) this.slices.shift(); }
+  clear(){ this.slices=[]; }
+  toCSV():string {
+    if(!this.slices.length) return '';
+    const header = 'rpm,' + this.slices[0].freqs.join(',');
+    const rows = this.slices.map(s=> `${s.rpm},`+ Array.from(s.spectrum).join(','));
+    return [header,...rows].join('\n');
+  }
+}
