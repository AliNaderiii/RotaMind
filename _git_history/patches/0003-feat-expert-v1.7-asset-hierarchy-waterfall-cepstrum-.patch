+/**
+ * assets.ts — سلسله مراتب دارایی (Plant > Area > Machine > Point)
+ * الهام: Emerson AMS Machine Works "Design Studio" + SKF Enlight Centre
+ * آفلاین در localStorage
+ */
+
+export interface MeasurementPoint { id:string, name:string, bearing:string, rpm:number, direction:'H'|'V'|'A', lastRms?:number, lastZone?:string }
+export interface Machine { id:string, name:string, type:'Motor'|'Pump'|'Fan'|'Gearbox'|'Compressor', isoClass:'I'|'II'|'III'|'IV', foundation:'rigid'|'soft', points: MeasurementPoint[] }
+export interface Area { id:string, name:string, machines: Machine[] }
+export interface Plant { id:string, name:string, areas: Area[] }
