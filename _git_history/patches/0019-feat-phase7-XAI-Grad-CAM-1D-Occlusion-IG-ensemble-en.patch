+import io, numpy as np
+from fastapi.testclient import TestClient
+from api.server import app
+from api.explain import explain_full, occlusion_attribution
+from api.report import build_report, render_html, render_pdf, iso_zone
+
+client = TestClient(app)
+
+def test_iso_zones():
+    zA = iso_zone(1.5)
+    assert zA["zone"] == "A"
+    zB = iso_zone(5.0)
+    assert zB["zone"] == "B"
+    zC = iso_zone(10)
+    assert zC["zone"] == "C"
+    zD = iso_zone(20)
+    assert zD["zone"] == "D"
+
+def test_occlusion_shape():
+    sig = np.random.randn(2048).astype(np.float32)
+    attr = occlusion_attribution(sig, window=64, stride=32)
+    assert attr.shape == (2048,)
+    assert 0 <= attr.max() <= 1.01
+
+def test_explain_full_mock():
+    sig = np.random.randn(2048).astype(np.float32)*0.2
+    sig[800:900] += 1.2
+    out = explain_full(sig, fs=12800, rpm=1500)
+    assert "heatmap" in out and len(out["heatmap"]) == 256
+    assert "physical" in out
+    assert out["pred"] in ["Normal","Outer","Inner","Ball","Cage"]
+
+def test_report_build():
+    infer = {"fault":"Outer","confidence":0.91,"severity":"Medium","all_probs":{"Normal":0.05,"Outer":0.91,"Inner":0.02,"Ball":0.01,"Cage":0.01},"recommendation":"test","rpm":1500,"fs":12800}
+    report = build_report(infer, [{"rms":2.1,"vel":2.1,"fault":"Outer","dateFa":"2026-11-15"}]*3, None, {"mode":"mock"})
+    assert report["report_id"].startswith("RM-")
+    assert report["iso"]["zone"] in ["A","B","C","D"]
+    assert "signature" in report
+
+def test_report_html_pdf():
+    infer = {"fault":"Normal","confidence":0.96,"severity":"None","all_probs":{"Normal":0.96,"Outer":0.02,"Inner":0.01,"Ball":0.005,"Cage":0.005},"recommendation":"ok","rpm":1500,"fs":12800}
+    report = build_report(infer, [], None, None)
+    html = render_html(report)
+    assert "<html" in html and report["report_id"] in html
+    pdf = render_pdf(report)
+    # pdf bytes start with %PDF or html fallback
+    assert len(pdf) > 500
+
+def test_api_explain():
+    csv = "timestamp,ax_g\n" + "\n".join(f"{i},{np.sin(2*np.pi*30*i/12800)+0.1*np.random.randn()}" for i in range(3000))
+    files = {"file": ("vib.csv", io.BytesIO(csv.encode()), "text/csv")}
+    r = client.post("/explain/gradcam?rpm=1500&fs=12800", files=files)
+    assert r.status_code == 200
+    j = r.json()
+    assert "heatmap" in j
+    assert j["pred"] in ["Normal","Outer","Inner","Ball","Cage"]
+
+def test_api_iso():
+    r = client.get("/iso/zones?rms=5.0")
+    assert r.status_code == 200
+    assert r.json()["zone"] == "B"
+
+def test_api_report_preview():
+    csv = "timestamp,ax_g\n" + "\n".join(f"{i},{0.2*np.sin(2*np.pi*50*i/12800)}" for i in range(2048))
+    files = {"file": ("vib.csv", io.BytesIO(csv.encode()), "text/csv")}
+    r = client.post("/report/pdf?rpm=1500", files=files)
+    assert r.status_code == 200
+    # returns JSON with base64 or direct pdf
+    assert "report_id" in r.json() or r.headers.get("content-type","").startswith("application/pdf")
+
+def test_api_report_html():
+    r = client.get("/report/preview?fault=Outer&confidence=0.88&severity=Medium")
+    assert r.status_code == 200
+    assert "RotaMind" in r.text
