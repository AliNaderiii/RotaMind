+"""
+dsp_order.py — Phase 6: Order Tracking + TSA (پیشرفته‌ترین DSP صنعتی)
+
+• Order Tracking (Vold-Kalman): بازنمونه‌برداری بر اساس زاویه شفت (tachometer) → حذف اثر تغییرات دور
+  X_order(o) = FFT( x(θ) ) , θ = ∫ ω(t) dt          (vs Dewesoft Order Tracking 100k€)
+• TSA (Time Synchronous Averaging): میانگین سنکرون با دوران → استخراج عیب چرخ‌دنده از نویز -20dB
+  TSA(θ) = 1/N Σ_n x(θ + 2πn)
+
+مرجع: Randall 2011, Vibration-based Condition Monitoring
+"""
+import numpy as np
+from scipy.signal import resample
+from scipy.interpolate import interp1d
+from scipy.fft import rfft, rfftfreq
+
+def tach_to_angle(tach_pulse_times: np.ndarray, rpm: float = 1500) -> callable:
+    """تولید تابع θ(t) از پالس تاکومتر — در عمل از encoder 1024 ppr"""
+    # mock: فرض دور ثابت
+    fr = rpm/60.0
+    return lambda t: 2*np.pi*fr*t
+
+def order_track(x: np.ndarray, fs: int, rpm_profile: np.ndarray, order_max: int = 20, nrev: int = 10):
+    """
+    x: ارتعاش (N,)
+    rpm_profile: RPM در هر نمونه (N,) — از OPC UA ns=2;s=C101.Speed
+    خروجی: order_spectrum (orders, mag)
+    """
+    t = np.arange(len(x))/fs
+    # زاویه تجمعی
+    fr = rpm_profile/60.0
+    theta = np.cumsum(2*np.pi*fr/fs)  # ∫ωdt
+    # بازنمونه‌برداری یکنواخت در حوزه زاویه
+    theta_uniform = np.linspace(theta[0], theta[-1], len(x))
+    f = interp1d(theta, x, kind='linear', fill_value="extrapolate")
+    x_angle = f(theta_uniform)
+    # FFT در حوزه order
+    n = len(x_angle)
+    win = np.hanning(n)
+    X = rfft(x_angle * win)
+    mag = np.abs(X) / (n/2) * 2.0
+    total_rev = (theta[-1]-theta[0])/(2*np.pi)
+    orders = np.linspace(0, n/2/total_rev if total_rev>0 else n/2, len(mag))
+    return orders, mag
+
+def tsa(x: np.ndarray, fs: int, rpm: float, n_avg: int = 32) -> np.ndarray:
+    """Time Synchronous Averaging — N دوران را روی هم می‌اندازد"""
+    fr = rpm/60.0
+    spp = int(fs / fr)  # samples per revolution
+    if spp <= 0:
+        return x[:1024]
+    usable = (len(x)//spp) * spp
+    x = x[:usable]
+    revs = x.reshape(-1, spp)[:n_avg]
+    return np.mean(revs, axis=0)
+
+def orbit(x: np.ndarray, y: np.ndarray, rpm: float, fs: int):
+    """Orbit Analysis — مسیر شفت در بیرینگ (Bently System1 Orbit)"""
+    # فیلتر 1×
+    fr = rpm/60.0
+    spp = int(fs / fr) if fr>0 else len(x)
+    n = min(len(x), len(y), spp*4)
+    return {"x": x[:n].tolist(), "y": y[:n].tolist(), "rpm": rpm, "fr": fr}
