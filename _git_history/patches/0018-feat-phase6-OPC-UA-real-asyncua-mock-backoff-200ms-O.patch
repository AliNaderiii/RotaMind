+"""
+client.py — Phase 6: کلاینت فدرال (شبیه‌ساز کارخانه)
+
+هر کارخانه داده خام ارتعاش را نگه می‌دارد، فقط Δw را می‌فرستد.
+"""
+import numpy as np
+from .strategy import clip_and_noise
+
+class FederatedClient:
+    def __init__(self, client_id: str, x: np.ndarray, y: np.ndarray, dp: bool = False):
+        self.id = client_id
+        self.x = x
+        self.y = y
+        self.dp = dp
+        self.samples = len(y)
+
+    def local_train(self, global_w: np.ndarray, lr: float = 0.05, epochs: int = 2) -> np.ndarray:
+        w = global_w.copy()
+        for _ in range(epochs):
+            pred = self.x @ w
+            grad = 2 * (self.x.T @ (pred - self.y)) / len(self.y)
+            if self.dp:
+                grad = clip_and_noise(grad, clip_norm=1.0, noise_multiplier=0.2, seed=hash(self.id)%1000)
+            w -= lr * grad
+        return w
+
+    def evaluate(self, w: np.ndarray) -> dict:
+        pred = self.x @ w
+        mse = float(np.mean((pred - self.y)**2))
+        return {"mse": mse, "samples": self.samples}
