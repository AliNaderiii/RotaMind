+"""
+strategy.py — Phase 6: FedAvg + DP (نظریه‌مند)
+
+هدف بهینه‌سازی فدرال:
+  min_w  F(w) = Σ_k (n_k / N) · F_k(w)          , F_k = E_{(x,y)~D_k}[ℓ(w;x,y)]
+
+FedAvg (McMahan et al. 2017):
+  هر راند t:
+    سرور ← w_t را به K کلاینت می‌فرستد
+    هر کلاینت k: w_k ← SGD(w_t, D_k, E epoch)
+    سرور: w_{t+1} = Σ_k (n_k / N) · w_k          (میانگین وزنی)
+
+DP: کلیپ گرادیان + نویز گاوسی (Abadi et al. 2016)
+  clip_norm C, noise σ·C
+
+vs رقبا: Bently/Siemens = داده خام به Cloud (نقض حریم خصوصی + پهنای باند 100×)
+         ما: وزن‌ها فقط (حریم خصوصی + 10× بهینه)
+"""
+import numpy as np
+from typing import List, Dict
+
+def fedavg_aggregate(client_weights: List[np.ndarray], client_samples: List[int]) -> np.ndarray:
+    """میانگین وزنی — هسته FedAvg"""
+    total = sum(client_samples)
+    if total == 0:
+        raise ValueError("no samples")
+    weighted = sum(w * (n/total) for w, n in zip(client_weights, client_samples))
+    return weighted
+
+def fedavg_aggregate_layers(client_layers: List[List[np.ndarray]], client_samples: List[int]) -> List[np.ndarray]:
+    """برای مدل چندلایه (Conv1d 16→32): هر لایه جدا aggregate"""
+    n_layers = len(client_layers[0])
+    agg = []
+    for l in range(n_layers):
+        ws = [cl[l] for cl in client_layers]
+        agg.append(fedavg_aggregate(ws, client_samples))
+    return agg
+
+def clip_and_noise(grad: np.ndarray, clip_norm: float = 1.0, noise_multiplier: float = 0.3, seed: int = 0) -> np.ndarray:
+    """DP-SGD: clip + Gaussian noise"""
+    rng = np.random.default_rng(seed)
+    norm = np.linalg.norm(grad)
+    if norm > clip_norm:
+        grad = grad * (clip_norm / norm)
+    noise = rng.normal(0, clip_norm * noise_multiplier, size=grad.shape)
+    return grad + noise
+
+def federated_round(global_w: np.ndarray, client_datasets: List[Dict], lr: float = 0.01, local_epochs: int = 1, dp: bool = False) -> np.ndarray:
+    """شبیه‌سازی یک راند فدرال کامل (برای تست و دمو آفلاین)"""
+    client_ws = []
+    client_ns = []
+    for ds in client_datasets:
+        # هر کلاینت: یک گام SGD روی گرادیان میانگین دیتاست‌اش
+        # F_k(w) = mean((w·x - y)^2) → grad = 2·mean((w·x - y)·x)
+        x, y = ds["x"], ds["y"]  # x: (n, d), y: (n,)
+        w = global_w.copy()
+        for _ in range(local_epochs):
+            pred = x @ w  # (n,)
+            grad = 2 * (x.T @ (pred - y)) / len(y)  # (d,)
+            if dp:
+                grad = clip_and_noise(grad, clip_norm=1.0, noise_multiplier=0.5, seed=int(w.sum()*1000)%1000)
+            w = w - lr * grad
+        client_ws.append(w)
+        client_ns.append(len(y))
+    return fedavg_aggregate(client_ws, client_ns)
+
+def convergence_gap(global_w: np.ndarray, optimum_w: np.ndarray) -> float:
+    return float(np.linalg.norm(global_w - optimum_w))
