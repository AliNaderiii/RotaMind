index 0000000..4b52598
--- /dev/null
+++ b/software/dsp-core/src/lib.rs
@@ -0,0 +1,67 @@
+use rustfft::{FftPlanner, num_complex::Complex};
+use wasm_bindgen::prelude::*;
+
+fn hann_window(n: usize) -> Vec<f32> {
+    (0..n).map(|i| 0.5*(1.0 - (2.0*std::f32::consts::PI * i as f32 / (n as f32 -1.0)).cos())).collect()
+}
+#[wasm_bindgen]
+pub fn fft_hann(input: Vec<f32>) -> Vec<f32> {
+    let n = input.len();
+    let win = hann_window(n);
+    let mut buf: Vec<Complex<f32>> = input.iter().zip(win.iter()).map(|(x,w)| Complex::new(x*w, 0.0)).collect();
+    let mut planner = FftPlanner::new();
+    let fft = planner.plan_fft_forward(n);
+    fft.process(&mut buf);
+    buf[..n/2].iter().map(|c| c.norm() / (n as f32 /2.0) *2.0).collect()
+}
+#[wasm_bindgen]
+pub fn bearing_fault_freqs(rpm: f32, bpfo_mult: f32, bpfi_mult: f32) -> Vec<f32> {
+    let fr = rpm/60.0; vec![fr*bpfo_mult, fr*bpfi_mult, fr*2.0*bpfo_mult]
+}
+// ── Phase6: Order tracking (angle-domain resampling core) ──
+#[wasm_bindgen]
+pub fn order_spectrum(input: Vec<f32>, rpm: f32, fs: f32) -> Vec<f32> {
+    // بازنمونه‌برداری زاویه‌ای ساده (rpm ثابت) — در Python نسخه کامل Vold-Kalman
+    // اینجا فقط FFT را در حوزه order برمی‌گرداند: order = f / fr
+    let mag = fft_hann(input);
+    let fr = rpm/60.0;
+    let _order_res = (fs / mag.len() as f32) / fr;
+    mag // orders ضمنی: order = k * order_res
+}
+#[wasm_bindgen]
+pub fn tsa(input: Vec<f32>, rpm: f32, fs: f32) -> Vec<f32> {
+    let fr = rpm/60.0;
+    let spp = (fs/fr) as usize;
+    if spp==0 || input.len() < spp { return input; }
+    let n_rev = input.len()/spp;
+    let mut avg = vec![0.0f32; spp];
+    for r in 0..n_rev { for i in 0..spp { avg[i] += input[r*spp+i]; } }
+    for v in &mut avg { *v /= n_rev as f32; }
+    avg
+}
+#[wasm_bindgen]
+pub fn orbit_features(x: Vec<f32>, y: Vec<f32>) -> Vec<f32> {
+    // ویژگی‌های orbit: [rms_x, rms_y, pk-pk_x, pk-pk_y]
+    let rms = |v: &[f32]| (v.iter().map(|x| x*x).sum::<f32>()/v.len() as f32).sqrt();
+    let pkpk = |v: &[f32]| v.iter().cloned().fold(f32::NEG_INFINITY, f32::max) - v.iter().cloned().fold(f32::INFINITY, f32::min);
+    vec![rms(&x), rms(&y), pkpk(&x), pkpk(&y)]
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn fft_peak() {
+        let fs=12800.0; let f0=50.0; let n=2048;
+        let sig: Vec<f32> = (0..n).map(|i| (2.0*std::f32::consts::PI*f0*i as f32/fs).sin()).collect();
+        let mag = fft_hann(sig);
+        let peak = mag.iter().enumerate().max_by(|a,b| a.1.partial_cmp(b.1).unwrap()).unwrap().0;
+        let freq_res = fs / n as f32;
+        assert!((peak as f32 * freq_res - f0).abs() < 5.0);
+    }
+    #[test] fn tsa_len() {
+        let fs=12800.0; let rpm=1500.0;
+        let fr=rpm/60.0; let spp=(fs/fr) as usize;
+        let x: Vec<f32> = (0..8192).map(|i| (2.0*std::f32::consts::PI*25.0*i as f32/fs).sin()).collect();
+        let o=tsa(x, rpm, fs);
+        assert_eq!(o.len(), spp);
+    }
+}
