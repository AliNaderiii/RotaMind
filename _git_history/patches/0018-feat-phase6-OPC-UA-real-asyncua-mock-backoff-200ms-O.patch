+import numpy as np
+from fastapi.testclient import TestClient
+from api.server import app
+from federated.strategy import fedavg_aggregate, federated_round, convergence_gap
+from federated.client import FederatedClient
+from federated.aggregator import FederatedServer
+from api.dsp_order import order_track, tsa, orbit
+
+client = TestClient(app)
+
+def test_fedavg_weighted():
+    w1 = np.array([1.0, 2.0])
+    w2 = np.array([3.0, 4.0])
+    agg = fedavg_aggregate([w1,w2],[10,30])  # وزن 1:3
+    expected = np.array([2.5, 3.5])
+    assert np.allclose(agg, expected, atol=1e-9)
+
+def test_federated_round_converges():
+    # مسئله ساده: y = 2*x (optimum w=[2])
+    rng = np.random.default_rng(0)
+    optimum = np.array([2.0])
+    # 3 کلاینت با داده متفاوت
+    datasets = []
+    for _ in range(3):
+        x = rng.normal(0,1,(50,1))
+        y = (x @ optimum).ravel() + rng.normal(0,0.1,50)
+        datasets.append({"x": x, "y": y})
+    w0 = np.array([0.0])
+    w1 = federated_round(w0, datasets, lr=0.1, local_epochs=5)
+    # باید به optimum نزدیک‌تر شود
+    assert convergence_gap(w1, optimum) < convergence_gap(w0, optimum)
+
+def test_federated_server_byzantine():
+    srv = FederatedServer(dim=2)
+    ws = [np.array([1.0,1.0]), np.array([1.1,0.9]), np.array([-5.0,-5.0])]  # سومی سمی
+    flagged = srv.detect_byzantine(ws, threshold=0.2)
+    assert 2 in flagged
+
+def test_dsp_order_peak():
+    fs = 12800
+    rpm = 1800  # fr=30 Hz
+    t = np.arange(4096)/fs
+    # سیگنال با هارمونیک order 1×, 2×, BPFO≈3.07×
+    sig = np.sin(2*np.pi*30*t) + 0.5*np.sin(2*np.pi*60*t) + 0.3*np.sin(2*np.pi*92*t)
+    rpm_profile = np.full(4096, rpm, dtype=float)
+    orders, mag = order_track(sig, fs, rpm_profile, order_max=10)
+    # پیک باید نزدیک order 1 و 2 باشد
+    peak_orders = orders[np.argsort(mag)[-3:]]
+    assert any(abs(o-1.0) < 0.3 for o in peak_orders)
+    assert any(abs(o-2.0) < 0.3 for o in peak_orders)
+
+def test_dsp_tsa_shape():
+    fs=12800; rpm=1500; n=8192
+    x = np.sin(2*np.pi*25*np.arange(n)/fs)
+    out = tsa(x, fs, rpm, n_avg=8)
+    assert len(out) == int(fs/(rpm/60.0))
+
+def test_api_opc_status():
+    r = client.get("/opc/status")
+    assert r.status_code == 200
+    assert r.json()["mode"] in ("mock","opcua","mock-fallback")
+
+def test_api_opc_read_once():
+    r = client.get("/opc/read?node=ns=2;s=C101.Speed")
+    assert r.status_code == 200
+    j = r.json()
+    assert "value" in j or "points" in j
+
+def test_api_federated_status():
+    r = client.get("/federated/status")
+    assert r.status_code == 200
+    assert "round" in r.json()
+
+def test_api_federated_round():
+    r = client.post("/federated/round", json={"clients":2,"samples_per":20})
+    assert r.status_code == 200
+    assert "global_norm" in r.json()
+
+def test_api_dsp_order():
+    # csv ساده
+    import io
+    csv = "timestamp,ax_g\n" + "\n".join(f"{i},{0.5*np.sin(2*np.pi*30*i/12800)}" for i in range(4096))
+    files = {"file": ("vib.csv", io.BytesIO(csv.encode()), "text/csv")}
+    r = client.post("/dsp/order?rpm=1800&fs=12800", files=files)
+    assert r.status_code == 200
+    assert "orders" in r.json()
