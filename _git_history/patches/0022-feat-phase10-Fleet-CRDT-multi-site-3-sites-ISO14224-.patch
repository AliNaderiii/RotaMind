+"""
+compliance.py — Phase 10: Compliance (GDPR + Audit + ISO 55000)
+
+استانداردها (دقیق):
+
+- GDPR (EU 2016/679): Right to Access (Art.15), Erasure (Art.17), Data Portability (Art.20), Retention
+  PII در RotaMind: operator_id, site location — pseudonymize با HMAC, erase → tombstone
+- Audit Log (ISO 27001 A.12.4): Immutable append-only, HMAC-chained (مثل blockchain سبک)
+  hash_n = HMAC_SHA256(k, hash_{n-1} || canonical_json(entry_n))
+  هر تغییر بدون hash قبلی قابل تشخیص → tamper-evident
+- ISO 55000 Asset Management: asset criticality matrix → maintenance priority
+- Retention (از 001_hypertable.sql): 2 years → auto-delete, Parquet archive
+
+vs رقبا: Bently log فایل متنی بدون امضا → ما chained HMAC + GDPR-ready
+"""
+
+import time, json, hmac, hashlib, pathlib
+from pathlib import Path
+from typing import Dict, List, Optional
+from pydantic import BaseModel
+
+AUDIT_FILE = Path(__file__).parent.parent / "model" / "audit.jsonl"
+GDPR_FILE = Path(__file__).parent.parent / "model" / "gdpr_requests.jsonl"
+AUDIT_KEY = b"rotamind-audit-hmac-2026-v10"
+
+# ── Audit Log ──
+class AuditEntry(BaseModel):
+    ts: int
+    actor: str
+    action: str  # infer, login, export, erase, etc
+    target: str
+    meta: Dict = {}
+    prev_hash: str = "GENESIS"
+    hash: str = ""
+
+def _canonical(e: Dict) -> str:
+    return json.dumps(e, sort_keys=True, ensure_ascii=False, separators=(",", ":"))
+
+def _hmac_chain(prev_hash: str, entry: Dict, key: bytes = AUDIT_KEY) -> str:
+    payload = prev_hash + _canonical(entry)
+    return hmac.new(key, payload.encode(), hashlib.sha256).hexdigest()[:16]
+
+class AuditLog:
+    def __init__(self, path: Path = AUDIT_FILE):
+        self.path = path
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        if not self.path.exists():
+            self.path.write_text("")
+
+    def _last_hash(self) -> str:
+        try:
+            lines = self.path.read_text().strip().splitlines()
+            if not lines or not lines[-1]:
+                return "GENESIS"
+            last = json.loads(lines[-1])
+            return last.get("hash", "GENESIS")
+        except Exception:
+            return "GENESIS"
+
+    def append(self, actor: str, action: str, target: str, meta: Dict = None) -> AuditEntry:
+        meta = meta or {}
+        ts = int(time.time()*1000)
+        prev = self._last_hash()
+        entry_dict = {"ts": ts, "actor": actor, "action": action, "target": target, "meta": meta, "prev_hash": prev}
+        h = _hmac_chain(prev, entry_dict)
+        entry = AuditEntry(ts=ts, actor=actor, action=action, target=target, meta=meta, prev_hash=prev, hash=h)
+        with open(self.path, "a") as f:
+            f.write(entry.model_dump_json() + "\n")
+        return entry
+
+    def list(self, limit: int = 50) -> List[AuditEntry]:
+        try:
+            lines = self.path.read_text().strip().splitlines()[-limit:]
+            return [AuditEntry(**json.loads(l)) for l in lines if l.strip()]
+        except Exception:
+            return []
+
+    def verify(self) -> Dict:
+        """Verify chain integrity — O(n)"""
+        try:
+            lines = self.path.read_text().strip().splitlines()
+            prev = "GENESIS"
+            for i, line in enumerate(lines):
+                if not line.strip():
+                    continue
+                e = json.loads(line)
+                recomputed = _hmac_chain(prev, {"ts": e["ts"], "actor": e["actor"], "action": e["action"], "target": e["target"], "meta": e["meta"], "prev_hash": prev})
+                if recomputed != e["hash"]:
+                    return {"ok": False, "broken_at": i, "expected": recomputed, "got": e["hash"]}
+                prev = e["hash"]
+            return {"ok": True, "entries": len([l for l in lines if l.strip()]), "last_hash": prev}
+        except Exception as ex:
+            return {"ok": False, "error": str(ex)}
+
+    def stats(self) -> Dict:
+        entries = self.list(1000)
+        return {
+            "total": len(entries),
+            "last_hash": self._last_hash(),
+            "verified": self.verify(),
+            "actions": {a: sum(1 for e in entries if e.action == a) for a in set(e.action for e in entries)} if entries else {}
+        }
+
+# ── GDPR ──
+def pseudonymize(value: str, key: bytes = b"rotamind-gdpr-2026") -> str:
+    return hmac.new(key, value.encode(), hashlib.sha256).hexdigest()[:12]
+
+def gdpr_export(operator_id: str) -> Dict:
+    """Export all data for subject — Art.15+20"""
+    # collect from audit + fleet + trends
+    audit = AuditLog()
+    entries = [e.model_dump() for e in audit.list(1000) if e.actor == operator_id or e.target == operator_id]
+    # trends filtered by meta
+    trends_path = pathlib.Path(__file__).parent.parent / "model" / "trends.json"
+    trends = []
+    if trends_path.exists():
+        try:
+            trends = json.loads(trends_path.read_text())[-20:]
+        except Exception:
+            pass
+    # log request
+    GDPR_FILE.parent.mkdir(parents=True, exist_ok=True)
+    req = {"ts": int(time.time()*1000), "type": "export", "operator_id": pseudonymize(operator_id), "count_audit": len(entries)}
+    with open(GDPR_FILE, "a") as f:
+        f.write(json.dumps(req) + "\n")
+    return {
+        "operator_id": operator_id,
+        "pseudonymized": pseudonymize(operator_id),
+        "audit_entries": entries,
+        "trends_sample": trends,
+        "format": "JSON (Art.20 portability)",
+        "regulation": "GDPR Art.15/20"
+    }
+
+def gdpr_erase(operator_id: str, actor: str = "dpo") -> Dict:
+    """Right to erasure — Art.17: tombstone + audit"""
+    audit = AuditLog()
+    # log erasure (not delete audit, but mark)
+    entry = audit.append(actor=actor, action="gdpr_erase", target=pseudonymize(operator_id), meta={"operator_id_hash": pseudonymize(operator_id), "original": "tombstoned"})
+    with open(GDPR_FILE, "a") as f:
+        f.write(json.dumps({"ts": int(time.time()*1000), "type": "erase", "operator_id": pseudonymize(operator_id), "audit_hash": entry.hash}) + "\n")
+    return {
+        "status": "erased",
+        "operator_id": pseudonymize(operator_id),
+        "audit_hash": entry.hash,
+        "retention": "audit hash kept for legal hold (GDPR Recital 65)",
+        "regulation": "GDPR Art.17"
+    }
+
+def retention_cleanup(older_than_days: int = 730) -> Dict:
+    """2-year retention (از hypertable) — حذف Parquet قدیمی"""
+    import pathlib, time as _t
+    archive = pathlib.Path(__file__).parent.parent / "archive"
+    deleted = 0
+    freed = 0
+    if archive.exists():
+        cutoff = _t.time() - older_than_days*86400
+        for p in archive.glob("trends_*.parquet"):
+            if p.stat().st_mtime < cutoff:
+                freed += p.stat().st_size
+                p.unlink(); deleted += 1
+    # also audit old? keep legal hold
+    return {"deleted_archives": deleted, "freed_bytes": freed, "policy": f"{older_than_days}d (ISO 55000 + GDPR storage limitation)", "legal_hold": "audit.jsonl never deleted"}
+
+# singletons
+_audit = AuditLog()
+def get_audit() -> AuditLog:
+    return _audit
