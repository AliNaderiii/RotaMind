diff --git a/software/rota-inference/tests/test_phase10.py b/software/rota-inference/tests/test_phase10.py
new file mode 100644
index 0000000..bccaf85
--- /dev/null
+++ b/software/rota-inference/tests/test_phase10.py
@@ -0,0 +1,100 @@
+import pathlib, json
+from fastapi.testclient import TestClient
+from api.server import app
+from api.multisite import get_fleet, Site, Asset
+from api.compliance import AuditLog, pseudonymize, gdpr_export, gdpr_erase, retention_cleanup
+
+client = TestClient(app)
+
+def test_fleet_sites_seed():
+    fleet = get_fleet()
+    sites = fleet.list_sites()
+    assert len(sites) >= 3
+    assert any(s.site_id == "IR-ISF-01" for s in sites)
+
+def test_fleet_upsert_asset_crdt():
+    fleet = get_fleet()
+    a = Asset(asset_id="TEST-01", site_id="IR-ISF-01", name="Test Pump", criticality="Medium", last_rul_h=120)
+    fleet.upsert_asset(a)
+    fetched = fleet.get_asset("TEST-01")
+    assert fetched is not None and fetched.name == "Test Pump"
+    # update RUL
+    fleet.update_rul("TEST-01", 95.5)
+    assert fleet.get_asset("TEST-01").last_rul_h == 95.5
+
+def test_fleet_sync_status():
+    fleet = get_fleet()
+    st = fleet.sync_status()
+    assert "vector_clock" in st and "consistency" in st
+    assert st["consistency"] == "AP-CRDT-LWW"
+
+def test_fleet_kpi():
+    kpi = get_fleet().fleet_kpi()
+    assert "total_assets" in kpi and "mttr_hours" in kpi
+    assert kpi["mttr_hours"] == 2.8
+
+def test_audit_chain():
+    import tempfile, pathlib
+    tmp = pathlib.Path("/tmp/test_audit_phase10.jsonl")
+    if tmp.exists(): tmp.unlink()
+    al = AuditLog(tmp)
+    e1 = al.append("alice", "login", "system", {"ip": "1.1.1.1"})
+    e2 = al.append("alice", "infer", "C101", {"fault": "Outer"})
+    assert e2.prev_hash == e1.hash
+    ver = al.verify()
+    assert ver["ok"] is True and ver["entries"] == 2
+    # tamper
+    lines = tmp.read_text().splitlines()
+    tampered = json.loads(lines[0]); tampered["action"] = "hacked"
+    tmp.write_text(json.dumps(tampered) + "\n" + lines[1] + "\n")
+    assert al.verify()["ok"] is False
+
+def test_gdpr_pseudonymize():
+    h1 = pseudonymize("operator1")
+    h2 = pseudonymize("operator1")
+    h3 = pseudonymize("operator2")
+    assert h1 == h2 and h1 != h3 and len(h1) == 12
+
+def test_gdpr_export_erase():
+    ex = gdpr_export("test_user_10")
+    assert "pseudonymized" in ex and "regulation" in ex
+    er = gdpr_erase("test_user_10", actor="dpo_test")
+    assert er["status"] == "erased" and "audit_hash" in er
+
+def test_retention_cleanup():
+    res = retention_cleanup(older_than_days=3650)
+    assert "deleted_archives" in res and "policy" in res
+
+# ── API ──
+def test_api_fleet_sites():
+    r = client.get("/fleet/sites")
+    assert r.status_code == 200 and len(r.json()) >= 3
+
+def test_api_fleet_upsert():
+    r = client.post("/fleet/sites", json={"site_id": "TEST-99", "name": "Test Site", "lat": 35.0, "lon": 51.0})
+    assert r.status_code == 200
+    assert r.json()["site_id"] == "TEST-99"
+    r2 = client.post("/fleet/assets", json={"asset_id": "AST-99", "site_id": "TEST-99", "name": "Pump 99", "criticality": "High", "rpm_nominal": 1800})
+    assert r2.status_code == 200
+
+def test_api_fleet_sync_kpi():
+    assert client.get("/fleet/sync").status_code == 200
+    assert client.get("/fleet/kpi").status_code == 200
+
+def test_api_audit():
+    client.post("/compliance/audit", json={"actor": "tester", "action": "test", "target": "unit", "meta": {"x": 1}})
+    r = client.get("/compliance/audit?limit=5")
+    assert r.status_code == 200 and "entries" in r.json()
+    r2 = client.get("/compliance/audit/verify")
+    assert r2.json()["ok"] is True
+
+def test_api_gdpr():
+    r = client.get("/compliance/gdpr/export?operator_id=alice")
+    assert r.status_code == 200 and "pseudonymized" in r.json()
+    r2 = client.post("/compliance/gdpr/erase?operator_id=alice")
+    assert r2.json()["status"] == "erased"
+
+def test_api_retention_compliance_report():
+    assert client.post("/compliance/retention/cleanup?days=730").status_code == 200
+    r = client.get("/compliance/report")
+    assert r.status_code == 200 and "standards" in r.json()
