+"""
+test_phase14 — Vault + Perf Cache + AI Advisor
+Enterprise hardening: encryption, lease, SLO, RAG citation
+"""
+import time
+import pytest
+from fastapi.testclient import TestClient
+from api.server import app
+from api.vault import SecretVault, get_vault
+from api.perf import AdaptiveCache, cache_key, get_cache, get_shedder
+from api.advisor import get_advisor, AdvisorQuery, KB_DOCS, retrieve
+
+client = TestClient(app)
+
+# ── Vault unit ──
+def test_vault_put_get():
+    v = SecretVault(master_key="test-master-key-1234567890")
+    v.clear()
+    sec = v.put("api.key.test", "s3cr3t-value", lease_ttl_s=3600, actor="tester")
+    assert sec.fingerprint
+    assert sec.version == 1
+    val = v.get("api.key.test", actor="tester")
+    assert val == "s3cr3t-value"
+    # update increments version
+    v.put("api.key.test", "new-value", actor="tester")
+    assert v.secrets["api.key.test"].version == 2
+    assert v.get("api.key.test") == "new-value"
+
+def test_vault_lease_expiry():
+    v = SecretVault(master_key="test-master-2")
+    v.clear()
+    v.put("temp.key", "temp", lease_ttl_s=1, actor="tester")
+    assert v.get("temp.key") == "temp"
+    time.sleep(1.2)
+    assert v.get("temp.key") is None  # expired
+
+def test_vault_rotate_and_revoke():
+    v = SecretVault(master_key="test-master-3")
+    v.clear()
+    v.put("rot.key", "v1", actor="tester")
+    sec = v.rotate("rot.key", new_value="v2", actor="tester")
+    assert sec.rotation_count == 1
+    assert v.get("rot.key") == "v2"
+    # HMAC integrity
+    assert v.verify_integrity()["ok"] is True
+    # revoke
+    assert v.revoke("rot.key", actor="tester") is True
+    assert v.get("rot.key") is None
+
+def test_vault_tamper_detection():
+    v = SecretVault(master_key="test-master-4")
+    v.clear()
+    v.put("tamper.key", "secret", actor="tester")
+    # tamper ciphertext
+    v.secrets["tamper.key"].ciphertext = "tampered-ciphertext"
+    try:
+        v.get("tamper.key")
+        assert False, "should raise HMAC tamper"
+    except ValueError as e:
+        assert "HMAC" in str(e) or "tamper" in str(e).lower()
+
+def test_vault_stats_and_audit():
+    v = SecretVault(master_key="test-master-5")
+    v.clear()
+    v.put("k1", "v1", actor="alice")
+    v.get("k1", actor="bob")
+    v.get("nope", actor="eve")
+    assert v.stats()["total"] == 1
+    assert len(v.audit) >= 3
+    assert v.verify_integrity()["checked"] == 1
+
+def test_api_vault_crud():
+    # use global vault via API — clear first via direct
+    get_vault().clear()
+    r = client.post("/vault/put", json={"key": "test.api.key", "value": "my-secret", "lease_ttl_s": 3600, "actor": "tester"})
+    assert r.status_code == 200
+    assert r.json()["fingerprint"]
+    r2 = client.get("/vault/get/test.api.key", params={"actor": "tester"})
+    assert r2.status_code == 200
+    assert r2.json()["value"] == "my-secret"
+    r3 = client.post("/vault/rotate/test.api.key", json={"value": "rotated", "actor": "tester"})
+    assert r3.status_code == 200
+    assert r3.json()["version"] == 2
+    r4 = client.get("/vault/stats")
+    assert r4.status_code == 200
+    assert r4.json()["total"] >= 1
+    assert "vs_bently" in r4.json()
+    r5 = client.get("/vault/audit")
+    assert r5.status_code == 200
+    assert "entries" in r5.json()
+    # revoke
+    r6 = client.delete("/vault/test.api.key", params={"actor": "tester"})
+    assert r6.status_code == 200
+    r7 = client.get("/vault/get/test.api.key")
+    assert r7.status_code == 404
+
+def test_api_vault_not_found():
+    r = client.get("/vault/get/not-exist-xyz")
+    assert r.status_code == 404
+    r2 = client.post("/vault/rotate/not-exist-xyz", json={})
+    assert r2.status_code == 404
+
+# ── Perf Cache unit ──
+def test_cache_put_get_ttl():
+    c = AdaptiveCache(max_entries=10, default_ttl_s=1.0)
+    c.put("k1", {"a": 1})
+    assert c.get("k1") == {"a": 1}
+    assert c.stats()["hits"] == 1
+    time.sleep(1.1)
+    assert c.get("k1") is None
+    assert c.stats()["misses"] >= 1
+
+def test_cache_lru_eviction():
+    c = AdaptiveCache(max_entries=3)
+    c.put("k1", "v1")
+    c.put("k2", "v2")
+    c.put("k3", "v3")
+    c.put("k4", "v4")  # evict k1
+    assert c.get("k1") is None
+    assert c.get("k4") == "v4"
+    assert c.stats()["evictions"] == 1
+
+def test_cache_adaptive_ttl_hot():
+    c = AdaptiveCache(default_ttl_s=10)
+    c.put("hot", "val", ttl_s=10)
+    for _ in range(6):
+        c.get("hot")
+    # hot key TTL boosted
+    assert c._store["hot"].ttl_s > 10
+
+def test_cache_invalidate():
+    c = AdaptiveCache()
+    c.put("a:1", "v1")
+    c.put("a:2", "v2")
+    c.put("b:1", "v3")
+    n = c.invalidate("a:")
+    assert n == 2
+    assert c.get("a:1") is None
+    assert c.get("b:1") == "v3"
+
+def test_cache_slo_tracking():
+    c = AdaptiveCache()
+    for i in range(50):
+        c.record_latency(3.0 + i*0.1)
+    slo = c.slo()
+    assert slo["p50_ms"] > 0
+    assert slo["p95_ms"] > slo["p50_ms"]
+    assert "slo_ok" in slo
+
+def test_api_cache_stats_and_crud():
+    r = client.get("/perf/cache/stats")
+    assert r.status_code == 200
+    assert "hit_ratio" in r.json()
+    r2 = client.post("/perf/cache/put", json={"key": "test:cache:key", "value": {"hello": "world"}, "ttl_s": 60})
+    assert r2.status_code == 200
+    r3 = client.get("/perf/cache/get/test:cache:key")
+    assert r3.status_code == 200
+    assert r3.json()["value"]["hello"] == "world"
+    r4 = client.get("/perf/slo")
+    assert r4.status_code == 200
+    assert "p95_ms" in r4.json()
+    r5 = client.post("/perf/cache/invalidate", params={"prefix": "test:cache:"})
+    assert r5.status_code == 200
+    assert r5.json()["invalidated"] >= 1
+
+def test_cache_key_determinism():
+    k1 = cache_key("/trends", {"limit": 20})
+    k2 = cache_key("/trends", {"limit": 20})
+    k3 = cache_key("/trends", {"limit": 10})
+    assert k1 == k2
+    assert k1 != k3
+
+# ── Advisor unit ──
+def test_retrieve_kb():
+    docs = retrieve("ISO 10816 vibration threshold 7.1", top_k=2)
+    assert len(docs) >= 1
+    assert any("iso10816" in d["id"] for d in docs)
+    docs2 = retrieve("bearing outer race BPFO", top_k=2)
+    assert any("bpfo" in d["id"].lower() or "outer" in d["title"].lower() for d in docs2)
+
+def test_advisor_ask_outer_rms():
+    adv = get_advisor()
+    adv.clear()
+    q = AdvisorQuery(question="What does RMS 8.5 mean? Should I shutdown?", context={"rms": 8.5, "fault": "Outer", "rul_h": 90})
+    ans = adv.ask(q)
+    assert "Zone C" in ans.answer or "7.1" in ans.answer
+    assert "outer" in ans.answer.lower() or "BPFO" in ans.answer
+    assert len(ans.citations) >= 1
+    assert ans.latency_ms > 0
+    assert ans.confidence > 0.6
+    assert any("iso" in s or "bearing" in s or "bpfo" in s for s in ans.sources)
+
+def test_advisor_ask_critical_rul():
+    adv = get_advisor()
+    adv.clear()
+    q = AdvisorQuery(question="RUL is 12 hours, what to do?", context={"rul_h": 12, "criticality": "CRITICAL"})
+    ans = adv.ask(q)
+    assert "critical" in ans.answer.lower() or "immediate" in ans.answer.lower()
+    assert ans.answer_id.startswith("ADV-")
+
+def test_advisor_feedback_and_stats():
+    adv = get_advisor()
+    adv.clear()
+    ans = adv.ask(AdvisorQuery(question="test feedback", context={}))
+    fb = adv.feedback(ans.answer_id, rating=5)
+    assert fb is not None
+    assert fb.confidence >= ans.confidence or fb.confidence > 0
+    assert adv.stats()["queries"] >= 1
+    assert adv.stats()["kb_docs"] == len(KB_DOCS)
+
+def test_api_advisor_ask_and_history():
+    r = client.post("/advisor/ask", json={"question": "My bearing has RMS 9 and outer fault, advise?", "context": {"rms": 9, "fault": "Outer", "rul_h": 60}})
+    assert r.status_code == 200
+    j = r.json()
+    assert "answer" in j
+    assert "citations" in j
+    assert len(j["citations"]) >= 1
+    # history
+    r2 = client.get("/advisor/history")
+    assert r2.status_code == 200
+    assert len(r2.json()) >= 1
+    # stats
+    r3 = client.get("/advisor/stats")
+    assert r3.status_code == 200
+    assert r3.json()["kb_docs"] == len(KB_DOCS)
+    # kb
+    r4 = client.get("/advisor/kb")
+    assert r4.status_code == 200
+    assert r4.json()["count"] == len(KB_DOCS)
+    # feedback
+    aid = j["answer_id"]
+    r5 = client.post(f"/advisor/feedback/{aid}", params={"rating": 5})
+    assert r5.status_code == 200
+
+def test_api_advisor_validation():
+    r = client.post("/advisor/ask", json={"question": ""})
+    assert r.status_code == 400
+    r2 = client.post("/advisor/feedback/NOTEXIST", params={"rating": 5})
+    assert r2.status_code == 404
