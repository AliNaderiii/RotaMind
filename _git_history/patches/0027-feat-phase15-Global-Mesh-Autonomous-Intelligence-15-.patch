+"""
+test_phase15 — Mesh + Pilot + Cortex
+Global scale mesh with quorum + autonomous RL scorer + knowledge graph
+"""
+import pytest
+from fastapi.testclient import TestClient
+from api.server import app
+from api.mesh import MeshRing, get_mesh
+from api.pilot import ControlPlane, get_pilot
+from api.cortex import CortexGraph, get_cortex, Node, Edge
+
+client = TestClient(app)
+
+# ── Mesh unit ──
+def test_mesh_placement_and_routing():
+    m = MeshRing()
+    replicas = m.place("C101")
+    assert len(replicas) == 3
+    assert len(set(replicas)) == 3  # distinct nodes
+    route = m.route("C101")
+    assert route["primary"] == replicas[0]
+    assert route["quorum"]["W"] == 2
+    # consistent hash determinism
+    assert m.route("C101")["primary"] == m.route("C101")["primary"]
+
+def test_mesh_quorum():
+    m = MeshRing()
+    m.place("C101")
+    w = m.quorum_write("C101", {"rms": 5.0})
+    assert w["acked"] is True
+    r = m.quorum_read("C101")
+    assert r["ok"] is True
+    # simulate node down
+    down_nid = m.replication["C101"][0]
+    m.nodes[down_nid].state = "DOWN"
+    m._rebuild_ring()
+    # still quorum with 2 remaining?
+    w2 = m.quorum_write("C101", {})
+    # may still ack if 2 healthy left
+    assert "replicas" in w2
+
+def test_mesh_gossip_and_rebalance():
+    m = MeshRing()
+    m.place("C101")
+    m.place("C102")
+    # heartbeat
+    nid = list(m.nodes.keys())[0]
+    hb = m.heartbeat(nid)
+    assert hb.node_id == nid
+    # gossip tick no events when healthy
+    events = m.gossip_tick()
+    assert isinstance(events, list)
+    # force old heartbeat
+    import time
+    m.nodes[nid].last_heartbeat = time.time() - 11
+    events2 = m.gossip_tick()
+    assert any(e["node_id"] == nid for e in events2)
+    assert m.nodes[nid].state == "DOWN"
+    # rebalance
+    rb = m.rebalance()
+    assert "before" in rb and "after" in rb
+
+def test_mesh_stats():
+    m = MeshRing()
+    s = m.stats()
+    assert s["nodes"] == 15
+    assert s["regions"] == 5
+    assert s["vnodes"] == 450
+    assert s["replication"] == "N=3 W=2 R=2"
+
+def test_api_mesh():
+    r = client.get("/mesh/stats")
+    assert r.status_code == 200
+    assert r.json()["nodes"] == 15
+    r2 = client.post("/mesh/place/C999")
+    assert r2.status_code == 200
+    assert len(r2.json()["replicas"]) == 3
+    r3 = client.get("/mesh/route/C999")
+    assert r3.status_code == 200
+    assert "primary" in r3.json()
+    r4 = client.get("/mesh/nodes")
+    assert len(r4.json()) == 15
+    # heartbeat
+    nid = r4.json()[0]["node_id"]
+    r5 = client.post(f"/mesh/heartbeat/{nid}")
+    assert r5.status_code == 200
+    r6 = client.get("/mesh/quorum/write/C999")
+    assert r6.json()["acked"] is True
+    r7 = client.get("/mesh/quorum/read/C999")
+    assert r7.json()["ok"] is True
+    r8 = client.post("/mesh/gossip")
+    assert r8.status_code == 200
+    r9 = client.post("/mesh/rebalance")
+    assert r9.status_code == 200
+
+# ── Pilot unit ──
+def test_pilot_decide():
+    p = ControlPlane()
+    d = p.decide("ZoneB", "Medium", {"rms": 5.0, "rul_h": 120})
+    assert "action" in d and d["action"] in ["MONITOR", "DERATE_1200", "LUBE", "INSPECT", "STOP", "SCHEDULE_WO"]
+    assert "scores" in d
+    # ZoneD critical should tend to STOP
+    d2 = p.decide("ZoneD", "Critical", {"rms": 20, "rul_h": 10})
+    # not guaranteed due to epsilon, but either STOP or high score for STOP
+    assert d2["scores"]["STOP"] > 0.5
+
+def test_pilot_workflow_lifecycle():
+    p = ControlPlane()
+    dag = p.create_workflow("C101", "ZoneC_High", actions=["DERATE_1200", "SCHEDULE_WO"])
+    assert len(dag.steps) == 2
+    assert dag.status == "RUNNING"
+    step_id = dag.steps[0].step_id
+    s = p.step(dag.dag_id, step_id, result={"ok": True})
+    assert s.status == "DONE"
+    # second step
+    s2 = p.step(dag.dag_id, dag.steps[1].step_id, result={"wo": "created"})
+    assert p.workflows[dag.dag_id].status == "DONE"
+
+def test_pilot_feedback_and_chaos():
+    p = ControlPlane()
+    state = "ZoneB_Medium"
+    old = p.q_table[state]["DERATE_1200"]
+    p.feedback(state, "DERATE_1200", reward=0.9)
+    assert p.q_table[state]["DERATE_1200"] > old
+    chaos = p.chaos_test("node_down")
+    assert chaos["recovered"] is True
+    assert chaos["elapsed_ms"] < 100
+
+def test_api_pilot():
+    r = client.post("/pilot/decide", json={"zone": "ZoneC", "severity": "High", "context": {"rms": 8.0, "rul_h": 80}})
+    assert r.status_code == 200
+    assert "action" in r.json()
+    r2 = client.post("/pilot/workflow", json={"asset_id": "C101", "trigger": "ZoneC_High", "actions": ["STOP", "INSPECT"]})
+    assert r2.status_code == 200
+    dag_id = r2.json()["dag_id"]
+    step_id = r2.json()["steps"][0]["step_id"]
+    # STOP requires approval → blocked without approve
+    r3 = client.post(f"/pilot/workflows/{dag_id}/step/{step_id}", json={"approve": False})
+    assert r3.json()["status"] == "BLOCKED"
+    # with approve → done
+    r4 = client.post(f"/pilot/workflows/{dag_id}/step/{step_id}", json={"approve": True, "result": {"ok": True}})
+    assert r4.json()["status"] == "DONE"
+    r5 = client.get("/pilot/stats")
+    assert "epsilon" in r5.json()
+    r6 = client.post("/pilot/chaos", json={"fault": "net_partition"})
+    assert r6.json()["recovered"] is True
+    r7 = client.post("/pilot/feedback", json={"state": "ZoneB_Medium", "action": "MONITOR", "reward": 0.8})
+    assert r7.json()["ok"] is True
+
+# ── Cortex unit ──
+def test_cortex_path_and_impact():
+    g = CortexGraph()
+    path = g.bfs_path("S-Vib", "EF-Downtime")
+    assert path is not None
+    assert path[0] == "S-Vib" and path[-1] == "EF-Downtime"
+    assert len(path) <= 6
+    # no path
+    assert g.bfs_path("S-Vib", "NOTEXIST") is None
+    impact = g.impact_radius("F-Outer", depth=2)
+    assert "affected" in impact
+    assert len(impact["affected"]) > 0
+    # Pagerank
+    pr = g.pagerank()
+    assert len(pr) == 10
+    assert pr[0]["score"] >= pr[-1]["score"]
+
+def test_cortex_query():
+    g = CortexGraph()
+    res = g.query("bearing outer vibration")
+    assert len(res) > 0
+    assert any("Outer" in r["label"] or "Bearing" in r["label"] for r in res)
+
+def test_cortex_stats():
+    g = CortexGraph()
+    s = g.stats()
+    assert s["nodes"] >= 50
+    assert s["edges"] >= 40
+    assert "density" in s
+
+def test_api_cortex():
+    r = client.get("/cortex/stats")
+    assert r.status_code == 200
+    assert r.json()["nodes"] >= 50
+    r2 = client.get("/cortex/pagerank")
+    assert len(r2.json()) == 10
+    r3 = client.get("/cortex/path", params={"src": "S-Vib", "dst": "EF-Downtime"})
+    assert r3.status_code == 200
+    assert "path" in r3.json()
+    r4 = client.get("/cortex/impact/C101")
+    assert "affected" in r4.json()
+    r5 = client.get("/cortex/query", params={"q": "lubrication failure"})
+    assert len(r5.json()) > 0
+    # add node & edge
+    r6 = client.post("/cortex/nodes", json={"id": "TEST-NODE", "label": "Test Node", "type": "Sensor", "props": {}})
+    assert r6.status_code == 200
+    r7 = client.post("/cortex/edges", json={"src": "TEST-NODE", "dst": "C101", "rel": "monitors", "weight": 0.5})
+    assert r7.status_code == 200
+    r8 = client.get("/cortex/nodes", params={"type": "Fault"})
+    assert any(n["type"] == "Fault" for n in r8.json())
