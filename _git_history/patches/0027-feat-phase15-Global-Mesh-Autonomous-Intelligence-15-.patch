+"""
+mesh.py — Global Scale Mesh Control Plane
+Consistent Hash Ring (150 vnodes) + Gossip Membership + Quorum (N=3,W=2,R=2) + Latency-Aware Routing
+
+vs Bently single-node → ما 5 regions با partition tolerance + auto-rebalance
+
+معماری: هر asset با hash(asset_id) روی ring قرار می‌گیرد → primary + 2 replica روی 3 node متوالی
+Gossip: هر 1s heartbeat → failure detector φ-accrual (ساده: missed >3 → suspect)
+"""
+from __future__ import annotations
+import time
+import uuid
+import hashlib
+import bisect
+from typing import Dict, List, Optional, Set
+from pydantic import BaseModel, Field
+from enum import Enum
+
+REGIONS = ["eu-west", "us-east", "apac-sg", "mea-dxb", "latam-br"]
+VNODES_PER_NODE = 30  # 5 regions × 3 nodes × 30 = 450 virtual points
+
+class NodeState(str, Enum):
+    HEALTHY = "HEALTHY"
+    SUSPECT = "SUSPECT"
+    DOWN = "DOWN"
+
+class MeshNode(BaseModel):
+    node_id: str
+    region: str
+    addr: str
+    state: NodeState = NodeState.HEALTHY
+    load: float = 0.0  # 0-1
+    latency_ms: float = 12.0
+    shard_count: int = 0
+    last_heartbeat: float = Field(default_factory=time.time)
+    version: str = "1.0.0-phase15"
+
+class MeshRing:
+    def __init__(self):
+        self.nodes: Dict[str, MeshNode] = {}
+        self.ring: List[tuple[int, str]] = []  # (hash, node_id) sorted
+        self.replication: Dict[str, List[str]] = {}  # asset_id -> [primary, replica1, replica2]
+        self._seed_default()
+
+    def _hash(self, key: str) -> int:
+        return int(hashlib.sha256(key.encode()).hexdigest()[:8], 16)
+
+    def _seed_default(self):
+        if self.nodes:
+            return
+        # 5 regions × 3 nodes = 15 physical nodes
+        nid = 0
+        for region in REGIONS:
+            for i in range(3):
+                nid += 1
+                node_id = f"{region}-n{i+1}"
+                self.nodes[node_id] = MeshNode(
+                    node_id=node_id, region=region,
+                    addr=f"10.{nid//256}.{nid%256}.10:8000",
+                    latency_ms=8 + (hash(node_id) % 25),  # 8-32ms simulated
+                    load=0.15 + (hash(node_id) % 40)/100
+                )
+        self._rebuild_ring()
+
+    def _rebuild_ring(self):
+        self.ring.clear()
+        for node_id in self.nodes:
+            for v in range(VNODES_PER_NODE):
+                h = self._hash(f"{node_id}#v{v}")
+                self.ring.append((h, node_id))
+        self.ring.sort(key=lambda x: x[0])
+
+    def _find_nodes(self, key: str, n: int = 3) -> List[str]:
+        if not self.ring:
+            return []
+        h = self._hash(key)
+        idx = bisect.bisect_left(self.ring, (h, ""))
+        if idx == len(self.ring):
+            idx = 0
+        result = []
+        seen = set()
+        # walk ring clockwise, collect distinct physical nodes
+        pos = idx
+        while len(result) < n and len(seen) < len(self.nodes):
+            _, nid = self.ring[pos % len(self.ring)]
+            if nid not in seen and self.nodes[nid].state != NodeState.DOWN:
+                result.append(nid)
+                seen.add(nid)
+            pos += 1
+            if pos - idx > len(self.ring):
+                break
+        return result
+
+    def place(self, asset_id: str) -> List[str]:
+        replicas = self._find_nodes(asset_id, 3)
+        self.replication[asset_id] = replicas
+        # update shard counts
+        for nid in self.nodes:
+            self.nodes[nid].shard_count = sum(1 for reps in self.replication.values() if nid in reps)
+        return replicas
+
+    def route(self, asset_id: str, prefer_region: Optional[str] = None) -> dict:
+        replicas = self.replication.get(asset_id) or self.place(asset_id)
+        # latency-aware: sort replicas by latency
+        sorted_replicas = sorted(replicas, key=lambda nid: self.nodes[nid].latency_ms)
+        # if prefer_region, boost nodes in that region
+        if prefer_region:
+            sorted_replicas = sorted(replicas, key=lambda nid: (0 if self.nodes[nid].region == prefer_region else 1, self.nodes[nid].latency_ms))
+        return {
+            "asset_id": asset_id,
+            "primary": replicas[0] if replicas else None,
+            "replicas": replicas,
+            "preferred": sorted_replicas[0] if sorted_replicas else None,
+            "quorum": {"N": 3, "W": 2, "R": 2},
+            "hash": hex(self._hash(asset_id))
+        }
+
+    def heartbeat(self, node_id: str) -> Optional[MeshNode]:
+        node = self.nodes.get(node_id)
+        if not node:
+            return None
+        node.last_heartbeat = time.time()
+        if node.state == NodeState.SUSPECT:
+            node.state = NodeState.HEALTHY
+        return node
+
+    def gossip_tick(self) -> List[dict]:
+        # simple failure detector: missed >3s suspect, >10s down
+        now = time.time()
+        events = []
+        for node in self.nodes.values():
+            delta = now - node.last_heartbeat
+            prev = node.state
+            if delta > 10:
+                node.state = NodeState.DOWN
+            elif delta > 3:
+                node.state = NodeState.SUSPECT
+            if prev != node.state:
+                events.append({"node_id": node.node_id, "from": prev, "to": node.state, "delta_s": round(delta, 1)})
+        if events:
+            self._rebuild_ring()
+        return events
+
+    def rebalance(self) -> dict:
+        before = {nid: n.shard_count for nid, n in self.nodes.items()}
+        # re-place all assets
+        for asset_id in list(self.replication.keys()):
+            self.place(asset_id)
+        after = {nid: n.shard_count for nid, n in self.nodes.items()}
+        moved = sum(1 for k in before if before[k] != after[k])
+        return {"before": before, "after": after, "nodes_moved": moved, "total_assets": len(self.replication)}
+
+    def quorum_write(self, asset_id: str, payload: dict) -> dict:
+        replicas = self.replication.get(asset_id) or self.place(asset_id)
+        # simulate W=2 ack required — need at least 2 HEALTHY
+        healthy = [nid for nid in replicas if self.nodes[nid].state == NodeState.HEALTHY]
+        ack = len(healthy) >= 2
+        return {"asset_id": asset_id, "replicas": replicas, "healthy": healthy, "acked": ack, "W": 2, "required": 2}
+
+    def quorum_read(self, asset_id: str) -> dict:
+        replicas = self.replication.get(asset_id) or self.place(asset_id)
+        healthy = [nid for nid in replicas if self.nodes[nid].state in (NodeState.HEALTHY, NodeState.SUSPECT)]
+        ok = len(healthy) >= 2
+        return {"asset_id": asset_id, "replicas": replicas, "read_from": healthy[:2], "ok": ok, "R": 2}
+
+    def stats(self) -> dict:
+        healthy = sum(1 for n in self.nodes.values() if n.state == NodeState.HEALTHY)
+        suspect = sum(1 for n in self.nodes.values() if n.state == NodeState.SUSPECT)
+        down = sum(1 for n in self.nodes.values() if n.state == NodeState.DOWN)
+        total_shards = sum(n.shard_count for n in self.nodes.values())
+        avg_lat = round(sum(n.latency_ms for n in self.nodes.values())/len(self.nodes), 1) if self.nodes else 0
+        return {
+            "nodes": len(self.nodes), "regions": len(REGIONS), "healthy": healthy, "suspect": suspect, "down": down,
+            "vnodes": len(self.ring), "assets_placed": len(self.replication), "total_shards": total_shards,
+            "avg_latency_ms": avg_lat, "replication": "N=3 W=2 R=2", "vs_bently": "Bently single-node → we 5-region mesh 450 vnodes + quorum"
+        }
+
+    def clear(self):
+        self.nodes.clear()
+        self.ring.clear()
+        self.replication.clear()
+        self._seed_default()
+
+_mesh: Optional[MeshRing] = None
+
+def get_mesh() -> MeshRing:
+    global _mesh
+    if _mesh is None:
+        _mesh = MeshRing()
+    return _mesh
