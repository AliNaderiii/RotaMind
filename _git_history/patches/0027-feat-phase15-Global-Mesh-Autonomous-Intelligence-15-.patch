@@ -0,0 +1,215 @@
+"""
+pilot.py — Autonomous Control Plane (RL-inspired + DAG workflows)
+ε-greedy policy scorer + multi-objective (cost/downtime/safety/energy) + DAG executor + chaos hooks
+
+vs Bently human-only → ما autonomous policy → safety gate → human-approve P1 → execute
+
+Scoring: score(s,a) = w1*cost_save + w2*downtime_save + w3*safety + w4*energy — λ*risk
+RL: Q-table ساده (state=zone+severity) با reward از feedback
+"""
+from __future__ import annotations
+import time
+import uuid
+import hashlib
+from typing import Dict, List, Optional, Literal
+from pydantic import BaseModel, Field
+from collections import defaultdict
+
+# ── Policy Actions ──
+ACTIONS = ["MONITOR", "DERATE_1200", "LUBE", "INSPECT", "STOP", "SCHEDULE_WO"]
+
+# reward weights (multi-objective)
+W_COST = 0.3
+W_DOWN = 0.25
+W_SAFE = 0.3
+W_ENER = 0.15
+
+# Q-table: state_key -> action -> Q value
+class PilotPolicy(BaseModel):
+    state: str  # e.g. "ZoneB_Medium"
+    best_action: str
+    q_values: Dict[str, float] = Field(default_factory=dict)
+    visits: int = 0
+
+class WorkflowStep(BaseModel):
+    step_id: str
+    action: str
+    target: str  # asset_id
+    requires_approval: bool = False
+    status: str = "PENDING"  # PENDING | RUNNING | DONE | BLOCKED | FAILED
+    started_at: Optional[float] = None
+    done_at: Optional[float] = None
+    result: dict = Field(default_factory=dict)
+
+class WorkflowDAG(BaseModel):
+    dag_id: str
+    asset_id: str
+    trigger: str  # fault: Outer, Zone C etc
+    steps: List[WorkflowStep] = Field(default_factory=list)
+    created_at: float = Field(default_factory=time.time)
+    status: str = "RUNNING"  # RUNNING | DONE | FAILED | PAUSED
+    reward: Optional[float] = None
+
+class ControlPlane:
+    def __init__(self):
+        self.q_table: Dict[str, Dict[str, float]] = defaultdict(lambda: {a: 0.5 for a in ACTIONS})
+        self.policies: Dict[str, PilotPolicy] = {}
+        self.workflows: Dict[str, WorkflowDAG] = {}
+        self.rewards: List[dict] = []
+        self._epsilon = 0.15  # exploration
+        self._seed_policies()
+
+    def _seed_policies(self):
+        if self.policies:
+            return
+        seeds = {
+            "ZoneA_Low": ("MONITOR", {"MONITOR": 0.9, "LUBE": 0.3, "INSPECT": 0.2}),
+            "ZoneB_Medium": ("DERATE_1200", {"DERATE_1200": 0.85, "LUBE": 0.6, "SCHEDULE_WO": 0.7, "MONITOR": 0.4}),
+            "ZoneC_High": ("SCHEDULE_WO", {"SCHEDULE_WO": 0.88, "STOP": 0.6, "INSPECT": 0.75}),
+            "ZoneD_Critical": ("STOP", {"STOP": 0.95, "SCHEDULE_WO": 0.5}),
+        }
+        for state, (best, qs) in seeds.items():
+            full_q = {a: qs.get(a, 0.2) for a in ACTIONS}
+            self.policies[state] = PilotPolicy(state=state, best_action=best, q_values=full_q, visits=10)
+            for a, v in full_q.items():
+                self.q_table[state][a] = v
+
+    def _state_key(self, zone: str, severity: str) -> str:
+        # normalize: Zone A/B/C/D + Low/Medium/High/Critical
+        z = zone.strip().title()  # ZoneB -> Zoneb fix
+        if "A" in zone.upper():
+            z = "ZoneA"
+        elif "B" in zone.upper():
+            z = "ZoneB"
+        elif "C" in zone.upper():
+            z = "ZoneC"
+        elif "D" in zone.upper():
+            z = "ZoneD"
+        sev = severity.strip().title()
+        return f"{z}_{sev}"
+
+    def score_action(self, state: str, action: str, context: dict) -> float:
+        # base Q
+        base = self.q_table[state].get(action, 0.3)
+        # context modifiers
+        rms = float(context.get("rms", 3.0))
+        rul = float(context.get("rul_h", 500))
+        cost_save = min(1.0, context.get("cost_save_pct", 30)/100)
+        downtime = context.get("downtime_h", 4)
+        # safety boost for critical states
+        safety = 1.0 if state.startswith("ZoneD") and action == "STOP" else 0.6 if action in ("STOP", "SCHEDULE_WO") else 0.2
+        energy = 0.7 if action == "DERATE_1200" else 0.3
+        risk = 0.8 if action == "STOP" and rms < 7 else 0.1
+        score = (W_COST*cost_save + W_DOWN*(1 - min(1, downtime/24)) + W_SAFE*safety + W_ENER*energy) - 0.2*risk
+        score = 0.6*base + 0.4*score
+        return round(max(0, min(1, score)), 3)
+
+    def decide(self, zone: str, severity: str, context: dict = None) -> dict:
+        context = context or {}
+        state = self._state_key(zone, severity)
+        # ε-greedy
+        import random as _r
+        if _r.random() < self._epsilon:
+            # explore: random action
+            action = _r.choice(ACTIONS)
+            reason = "explore ε-greedy"
+        else:
+            # exploit: best scored
+            scored = [(a, self.score_action(state, a, context)) for a in ACTIONS]
+            scored.sort(key=lambda x: x[1], reverse=True)
+            action = scored[0][0]
+            reason = f"exploit Q={scored[0][1]}"
+        all_scores = {a: self.score_action(state, a, context) for a in ACTIONS}
+        return {
+            "state": state, "action": action, "reason": reason,
+            "scores": all_scores, "q_values": dict(self.q_table[state]),
+            "epsilon": self._epsilon
+        }
+
+    def create_workflow(self, asset_id: str, trigger: str, actions: List[str] = None) -> WorkflowDAG:
+        # build DAG steps from action list
+        if actions is None:
+            # infer from trigger: "ZoneC_Outer" → SCHEDULE_WO + INSPECT
+            if "ZoneD" in trigger or "Critical" in trigger:
+                actions = ["STOP", "INSPECT", "SCHEDULE_WO"]
+            elif "ZoneC" in trigger:
+                actions = ["DERATE_1200", "SCHEDULE_WO"]
+            else:
+                actions = ["MONITOR"]
+        steps = []
+        for act in actions:
+            needs_approval = act == "STOP"
+            steps.append(WorkflowStep(
+                step_id=f"step-{uuid.uuid4().hex[:6]}", action=act, target=asset_id,
+                requires_approval=needs_approval
+            ))
+        dag = WorkflowDAG(dag_id=f"dag-{uuid.uuid4().hex[:6]}", asset_id=asset_id, trigger=trigger, steps=steps)
+        self.workflows[dag.dag_id] = dag
+        return dag
+
+    def step(self, dag_id: str, step_id: str, result: dict = None, approve: bool = False) -> Optional[WorkflowStep]:
+        dag = self.workflows.get(dag_id)
+        if not dag:
+            return None
+        step = next((s for s in dag.steps if s.step_id == step_id), None)
+        if not step:
+            return None
+        if step.requires_approval and not approve:
+            step.status = "BLOCKED"
+            dag.status = "PAUSED"
+            return step
+        step.status = "RUNNING"
+        step.started_at = time.time()
+        # simulate execution
+        step.result = result or {"ok": True, "msg": f"{step.action} executed"}
+        step.status = "DONE"
+        step.done_at = time.time()
+        # check DAG done
+        if all(s.status == "DONE" for s in dag.steps):
+            dag.status = "DONE"
+        return step
+
+    def feedback(self, state: str, action: str, reward: float):
+        # Q-learning update: Q ← Q + α(r - Q)
+        alpha = 0.2
+        old = self.q_table[state].get(action, 0.5)
+        new = old + alpha * (reward - old)
+        self.q_table[state][action] = round(max(0, min(1, new)), 3)
+        self.rewards.append({"state": state, "action": action, "reward": reward, "old": old, "new": new, "ts": time.time()})
+        # decay epsilon
+        self._epsilon = max(0.02, self._epsilon * 0.998)
+
+    def chaos_test(self, fault: str = "node_down") -> dict:
+        # inject chaos: simulate node failure and auto-recovery
+        start = time.time()
+        dag = self.create_workflow("CHAOS", f"chaos-{fault}", actions=["MONITOR", "INSPECT"])
+        # auto-step
+        for step in dag.steps:
+            self.step(dag.dag_id, step.step_id, result={"chaos": fault})
+        elapsed_ms = round((time.time() - start)*1000, 1)
+        return {"fault": fault, "dag_id": dag.dag_id, "elapsed_ms": elapsed_ms, "recovered": dag.status == "DONE", "vs_bently": "Bently no chaos → we chaos-tested"}
+
+    def stats(self) -> dict:
+        return {
+            "policies": len(self.policies), "workflows": len(self.workflows),
+            "q_states": len(self.q_table), "rewards": len(self.rewards),
+            "epsilon": round(self._epsilon, 3),
+            "avg_reward": round(sum(r["reward"] for r in self.rewards)/len(self.rewards), 3) if self.rewards else 0,
+            "vs_bently": "Bently manual SOP → we autonomous DAG + RL scorer"
+        }
+
+    def clear(self):
+        self.q_table.clear()
+        self.policies.clear()
+        self.workflows.clear()
+        self.rewards.clear()
+        self._epsilon = 0.15
+        self._seed_policies()
+
+_pilot: Optional[ControlPlane] = None
+
+def get_pilot() -> ControlPlane:
+    global _pilot
+    if _pilot is None:
+        _pilot = ControlPlane()
+    return _pilot
