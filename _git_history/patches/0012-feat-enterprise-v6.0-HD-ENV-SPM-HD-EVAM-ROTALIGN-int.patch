+export interface ThermalPoint { ts:number; temp:number; growthX:number; growthY:number; vib:number; }
+export function simulateThermalGrowth(hours=8): ThermalPoint[]{
+  return Array.from({length:hours*4},(_,i)=>{ const t=i/4; const temp=25+ (60-25)*(1-Math.exp(-t/2)); const gx=0.02*temp, gy=0.035*temp; return {ts:Date.now()+i*900000, temp, growthX:gx, growthY:gy, vib:1.2+ Math.sin(t)*0.3};});
+}
+export function compensateAlignment(thermal:ThermalPoint, coldAlign:{x:number,y:number}){ const last=thermal; return {x: coldAlign.x + last.growthX, y: coldAlign.y + last.growthY};}
