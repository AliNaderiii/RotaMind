+/**
+ * physicsTwin.ts — Physics-Aware Digital Twin — Siemens MindSphere PINN
+ */
+export interface PhysicsParams { mass:number; k:number; c:number; unbalance:number; clearance:number; rpm:number; }
+export function physicsTwin(p:PhysicsParams){
+  const omega=p.rpm*2*Math.PI/60; const wn=Math.sqrt(p.k/p.mass); const zeta=p.c/(2*Math.sqrt(p.k*p.mass));
+  const r=omega/wn; const amp_physics= (p.unbalance*omega*omega/p.k)/Math.sqrt((1-r*r)**2 + (2*zeta*r)**2);
+  // ML correction (mock PINN)
+  const mlCorr= 1 + 0.08*Math.sin(r*3);
+  return {amp: amp_physics*mlCorr, phase: Math.atan2(2*zeta*r,1-r*r)*180/Math.PI, wn, r, physicsOnly: amp_physics, twinError: Math.abs(mlCorr-1)*100};
+}
+export function virtualScenario(base:PhysicsParams, delta:{k?:number,mass?:number}){ const p={...base, ...delta}; return physicsTwin(p); }
