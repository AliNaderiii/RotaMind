+export function loadTags(): RFIDTag[]{ try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch{return[]} }
+export function readTag(tagId:string): RFIDTag|null { return loadTags().find(x=>x.tagId===tagId)||null; }
