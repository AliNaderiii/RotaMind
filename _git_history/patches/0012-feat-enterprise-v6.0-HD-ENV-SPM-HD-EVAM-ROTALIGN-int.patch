+/**
+ * hdEnv.ts — SPM HD ENV + HD Real Peak (dB) — الهام SPM Instrument
+ * HD Real Peak = true highest peak in envelope, HD ENV Spectrum/Tim
+ */
+export interface HDResult { hdRealPeak_dB:number; hdPeak:number; defect:string; band:string; }
+export function computeHDEnv(signal:Float64Array, fs:number, band: 'bearing'|'gear'='bearing'): HDResult {
+  const n=signal.length; let env=new Float64Array(n);
+  // Hilbert envelope mock via rectify + lowpass
+  for(let i=0;i<n;i++) env[i]=Math.abs(signal[i]);
+  let peak=0; for(let i=0;i<n;i++) if(env[i]>peak) peak=env[i];
+  const hdPeak=peak*1.6; // enhancement
+  const dB=20*Math.log10(hdPeak/1e-6 +1);
+  let defect='Normal'; if(dB>45) defect='Bearing damage — early stage'; if(dB>65) defect='Gear/Bearing severe';
+  return {hdRealPeak_dB: dB, hdPeak, defect, band};
+}
+export function hdSpectrum(env:Float64Array, fs:number){ // FFT on envelope
+  const n=Math.min(env.length,4096); let mag:number[]=[]; for(let k=0;k<400;k++){ const f=k*fs/2/400; let re=0,im=0; for(let i=0;i<n;i++){ const t=i/fs; re+=env[i]*Math.cos(2*Math.PI*f*t); im+=env[i]*Math.sin(2*Math.PI*f*t);} mag.push(Math.hypot(re,im)/n);} return mag;
+}
