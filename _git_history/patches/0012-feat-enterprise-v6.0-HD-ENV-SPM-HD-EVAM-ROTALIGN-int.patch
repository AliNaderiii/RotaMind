+/**
+ * shaftAlignment.ts — Laser Shaft Alignment ROTALIGN intelliSWEEP + Live Move
+ */
+export interface AlignReading { angle:number; x:number; y:number; quality:number; }
+export interface AlignResult { vertical:number; horizontal:number; shim:number; status:string; }
+export function intelliSWEEP(readings:AlignReading[]): AlignReading[] {
+  // Filter low quality (vibration)
+  return readings.filter(r=> r.quality>0.6);
+}
+export function liveMove(current:{x:number,y:number}, target:{x:number,y:number}): {dx:number, dy:number, shim:number, move:string}{
+  const dx=target.x-current.x, dy=target.y-current.y;
+  const shim=Math.abs(dy)*0.8;
+  return {dx, dy, shim, move: `جابجایی ${dx.toFixed(2)}mm افقی، ${dy.toFixed(2)}mm عمودی — شیم ${shim.toFixed(2)}mm`};
+}
+export function alignmentCheck(offset:number, tol=0.05): string { return Math.abs(offset)<=tol ? 'PASS — تلرانس OK' : `FAIL — ${Math.abs(offset).toFixed(3)}mm خارج تلرانس`;}
