+/**
+ * opcPubSub.ts — OPC UA PubSub + MQTT — Siemens MindConnect
+ */
+export interface PubSubMsg { topic:string; payload:any; ts:number; qos:0|1|2; }
+const subs:Record<string,((m:PubSubMsg)=>void)[]>={};
+export function publish(topic:string, payload:any, qos:0|1|2=1){ const m:PubSubMsg={topic,payload,ts:Date.now(),qos}; (subs[topic]||[]).forEach(fn=>fn(m)); saveLog(m); }
+export function subscribe(topic:string, fn:(m:PubSubMsg)=>void){ (subs[topic]=subs[topic]||[]).push(fn); }
+const KEY='rotamind_pubsub';
+function saveLog(m:PubSubMsg){ let l:PubSubMsg[]=[]; try{l=JSON.parse(localStorage.getItem(KEY)||'[]')}catch{} l.push(m); localStorage.setItem(KEY, JSON.stringify(l.slice(-100))); }
+export function loadLog(): PubSubMsg[]{ try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch{return[]} }
