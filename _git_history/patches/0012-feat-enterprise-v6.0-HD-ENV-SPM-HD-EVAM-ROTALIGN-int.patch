+/**
+ * spmHd.ts — Shock Pulse Method HDm/HDc/HDd — 0.1-20000 RPM
+ */
+export interface SPMResult { HDm:number; HDc:number; HDd:number; rpm:number; code:string; cond:string; }
+export function computeSPMHD(signal:Float64Array, rpm:number): SPMResult {
+  const n=signal.length; let max=0; for(let i=0;i<n;i++){ const v=Math.abs(signal[i]); if(v>max) max=v;}
+  const HDm = 20*Math.log10(max*1e3 +1); // 0-60 dB
+  const HDc = HDm + Math.log10(Math.max(0.1,rpm)/1000)*8; // condition compensates rpm
+  const delta = HDm - 20; // normalized
+  const HDd = Math.max(0, delta);
+  let code='A - Good', cond='سالم';
+  if(HDd>25) {code='D - Damage'; cond='آسیب قطعی — تعویض';}
+  else if(HDd>15) {code='C - Probable damage'; cond='آسیب محتمل — پایش روزانه';}
+  else if(HDd>5) {code='B - Attention'; cond='توجه — پایش هفتگی';}
+  return {HDm, HDc, HDd, rpm, code, cond};
+}
