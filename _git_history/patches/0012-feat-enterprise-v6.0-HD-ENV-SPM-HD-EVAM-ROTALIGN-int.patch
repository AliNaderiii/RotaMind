+/**
+ * federated.ts — Federated Learning for Factory Nodes — Siemens
+ */
+export interface LocalModel { site:string; samples:number; weights:number[]; acc:number; }
+export function federatedAvg(models:LocalModel[]): number[] {
+  const dim=models[0].weights.length; let agg=new Array(dim).fill(0); let total=models.reduce((a,b)=>a+b.samples,0);
+  models.forEach(m=>{ m.weights.forEach((w,i)=> agg[i]+= w*m.samples/total);});
+  return agg;
+}
+export function mockLocal(site:string): LocalModel{ return {site, samples: 200+ Math.floor(Math.random()*300), weights: [0.6+Math.random()*0.2, 0.4+Math.random()*0.2], acc: 0.82+Math.random()*0.12 };}
