+/**
+ * orderAdvanced.ts — Order Tracking پیشرفته Dewesoft — Supercounter® style
+ * Resampling به Angle domain + Tracking filter + Bode/Nyquist استخراج هر Order
+ */
+export function angleResample(signal:Float64Array, tachoPulse:number[], fs:number): {angle:Float64Array, signalAngle:Float64Array}{
+  // تاخو پالس → زاویه
+  const angle=new Float64Array(signal.length);
+  let pulseIdx=0; let anglePerRev=2*Math.PI;
+  for(let i=0;i<signal.length;i++){ if(pulseIdx < tachoPulse.length && i>= tachoPulse[pulseIdx]) pulseIdx++; angle[i]= pulseIdx*anglePerRev + (i - (tachoPulse[pulseIdx-1]||0))/fs * anglePerRev * (fs/ (tachoPulse[1]-tachoPulse[0] || 1000)); }
+  return {angle, signalAngle: signal};
+}
+export function trackingFilter(signalAngle:Float64Array, order:number, bw:number=0.5){
+  // Mock: extract order harmonic via Goertzel in angle domain
+  const n=signalAngle.length; let amp=0; for(let i=0;i<n;i++) amp+= signalAngle[i]*Math.cos(order*0.1*i);
+  return {order, amp: Math.abs(amp)/n, phase: Math.atan2(amp, amp*0.5)*180/Math.PI};
+}
+export function orderSpectrum(angleSignal:Float64Array, maxOrder=20){ return Array.from({length:maxOrder},(_,k)=> trackingFilter(angleSignal, k+1)); }
