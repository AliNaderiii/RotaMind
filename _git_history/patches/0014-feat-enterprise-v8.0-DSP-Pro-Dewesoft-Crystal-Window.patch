+/**
+ * dspAdvanced.ts — DSP حرفه‌ای الهام Dewesoft X + Crystal Instruments CoCo
+ * Window: Uniform/Hann/Flattop — Overlap 0/25/50/75% — Averaging linear/peak/exponential/TSA
+ * FFT lines 112..14400 — Demodulation 24 bands — Angle sensor math
+ */
+export type WindowType='Uniform'|'Hann'|'Hamming'|'Flattop';
+export type AvgType='Linear'|'PeakHold'|'Exponential'|'TimeSync';
+export interface FFTConfig { window:WindowType; overlap:number; avg:AvgType; lines:112|225|450|900|1800|3600|7200|14400; demodBand?:[number,number]; display:'peak'|'rms'|'dB'; freqAxis:'Hz'|'RPM'|'Order'; }
+
+export function windowCoef(type:WindowType, n:number): Float64Array{
+  const w=new Float64Array(n);
+  for(let i=0;i<n;i++){
+    if(type==='Uniform') w[i]=1;
+    else if(type==='Hann') w[i]=0.5*(1-Math.cos(2*Math.PI*i/(n-1)));
+    else if(type==='Hamming') w[i]=0.54-0.46*Math.cos(2*Math.PI*i/(n-1));
+    else if(type==='Flattop') w[i]=0.2155 -0.4168*Math.cos(2*Math.PI*i/(n-1)) +0.2783*Math.cos(4*Math.PI*i/(n-1)) -0.0836*Math.cos(6*Math.PI*i/(n-1));
+  }
+  return w;
+}
+export function ampCorr(type:WindowType): number{
+  if(type==='Uniform') return 1.0;
+  if(type==='Hann') return 2.0;
+  if(type==='Hamming') return 1.85;
+  if(type==='Flattop') return 4.6;
+  return 1;
+}
+export function applyOverlap(signal:Float64Array, blockSize:number, overlapPct:number): Float64Array[]{
+  const step=Math.round(blockSize*(1-overlapPct/100));
+  const blocks:Float64Array[]=[];
+  for(let off=0; off+blockSize<=signal.length; off+=step) blocks.push(signal.slice(off, off+blockSize));
+  return blocks;
+}
+export function averageSpectra(spectra:number[][], type:AvgType): number[]{
+  const lines=spectra[0].length; const out=new Array(lines).fill(0);
+  if(type==='Linear'){ for(let k=0;k<lines;k++){ let s=0; spectra.forEach(sp=> s+=sp[k]); out[k]=s/spectra.length; } }
+  else if(type==='PeakHold'){ for(let k=0;k<lines;k++) out[k]=Math.max(...spectra.map(sp=>sp[k])); }
+  else if(type==='Exponential'){ let alpha=0.2; out.splice(0,lines,...spectra[0]); for(let b=1;b<spectra.length;b++) for(let k=0;k<lines;k++) out[k]= alpha*spectra[b][k] + (1-alpha)*out[k]; }
+  return out;
+}
+export function demodulate(signal:Float64Array, fs:number, band:[number,number]): Float64Array{
+  // Mock bandpass + envelope: rectify + lowpass 1kHz
+  const lo=band[0]/fs, hi=band[1]/fs; // not real filter, mock
+  const env=new Float64Array(signal.length);
+  for(let i=0;i<signal.length;i++) env[i]=Math.abs(signal[i]) * (Math.abs(signal[i])>0.01?1:0.5);
+  return env;
+}
+export const DEMOD_BANDS: [number,number][] = [
+  [125,1440],[250,2880],[500,5760],[1000,11520],[2000,23040],[4000,46080],
+  [4000,8000],[8000,16000],[16000,32000],[32000,46080],
+];
