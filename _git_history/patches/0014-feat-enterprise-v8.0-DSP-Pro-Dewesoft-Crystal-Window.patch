+/**
+ * balancingAdvanced.ts — Rotor Balancing Wizard Dewesoft — Single/Dual plane + Vector Polar
+ */
+export interface BalanceRun { label:string; amp:number; phase:number; rpm:number; trialMass?:number; trialAngle?:number; }
+export function balanceWizard(runs:BalanceRun[]): {corrMass:number, corrAngle:number, polar:BalanceRun[], status:string}{
+  if(runs.length<2) return {corrMass:0,corrAngle:0,polar:runs,status:'Need initial + trial'};
+  const r0=runs[0], r1=runs[1];
+  const toVec=(a:number,p:number)=>({x:a*Math.cos(p*Math.PI/180), y:a*Math.sin(p*Math.PI/180)});
+  const v0=toVec(r0.amp,r0.phase), v1=toVec(r1.amp,r1.phase);
+  const d={x:v1.x-v0.x, y:v1.y-v0.y}; const inf=Math.hypot(d.x,d.y)/(r1.trialMass||1);
+  const corrAmp=r0.amp/inf; const corrAng=((r0.phase - Math.atan2(d.y,d.x)*180/Math.PI +180)%360+360)%360;
+  return {corrMass: corrAmp, corrAngle: corrAng, polar: runs, status: corrAmp<50?'PASS — within limit':'FAIL — excessive'};
+}
+export function polarPlot(runs:BalanceRun[]): {x:number,y:number,label:string}[]{ return runs.map(r=>({x: r.amp*Math.cos(r.phase*Math.PI/180), y: r.amp*Math.sin(r.phase*Math.PI/180), label:r.label})); }
