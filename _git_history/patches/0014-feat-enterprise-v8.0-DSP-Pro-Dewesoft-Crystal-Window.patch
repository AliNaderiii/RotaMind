+/**
+ * srs.ts — Shock Response Spectrum — DewesoftX 2026.1 + Crystal Instruments
+ */
+export interface SRSPoint { freq:number; accel:number; vel:number; disp:number; }
+export function computeSRS(signal:Float64Array, fs:number, freqs:number[]=Array.from({length:48},(_,i)=> 10*Math.pow(10, i/16))): SRSPoint[]{
+  return freqs.map(f=>{
+    const wn=2*Math.PI*f, zeta=0.05;
+    let maxA=0; let a=0,v=0; const dt=1/fs;
+    for(let i=0;i<signal.length;i++){ const inp=signal[i]; // SDOF
+      const an= inp*wn*wn -2*zeta*wn*v - wn*wn*a;
+      v+= an*dt; a+= v*dt; if(Math.abs(an)>maxA) maxA=Math.abs(an);
+    }
+    return {freq:f, accel:maxA, vel:maxA/wn, disp:maxA/(wn*wn)};
+  });
+}
