+/**
+ * torsionalAdvanced.ts — Torsional & Rotational — Dewesoft با Supercounter 102.4MHz
+ * جبران Constant angle offset, uncentered mounting, sensor errors, Gearbox ratio
+ */
+export interface TorsionalConfig { angleOffset:number; uncentered:number; gearRatio:number; sensorError:number; }
+export function compensateTorsional(rawAngle:Float64Array, cfg:TorsionalConfig): Float64Array{
+  const out=new Float64Array(rawAngle.length);
+  for(let i=0;i<rawAngle.length;i++) out[i]= (rawAngle[i] + cfg.angleOffset) * cfg.gearRatio - cfg.uncentered * Math.sin(rawAngle[i]) - cfg.sensorError;
+  return out;
+}
+export function torsionalVib(angle:Float64Array, fs:number){ // derivative
+  const vel=new Float64Array(angle.length-1);
+  for(let i=0;i<vel.length;i++) vel[i]=(angle[i+1]-angle[i])*fs;
+  const mean=vel.reduce((a,b)=>a+b,0)/vel.length; let jitter=0; for(let i=0;i<vel.length;i++) jitter+=Math.abs(vel[i]-mean); jitter/=vel.length;
+  return {mean, jitter, vel};
+}
