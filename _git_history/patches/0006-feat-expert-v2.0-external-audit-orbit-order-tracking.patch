-.iso-card{display:grid;grid-template-columns:38px 1fr;gap:10px;align-items:center;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px}
-.iso-badge{width:36px;height:36px;border-radius:8px;display:grid;place-items:center;font:700 11px var(--font-mono);border:1.5px solid var(--border);background:var(--bg)}
-.channel-row{height:30px;display:flex;align-items:center;gap:8px;padding:0 8px;background:var(--surface);border:1px solid var(--border);border-radius:8px;font:500 11px var(--font-sans);color:var(--text-secondary);transition:all .12s}
-.channel-row:hover{border-color:var(--border-strong)}
-.channel-row input{accent-color:var(--accent)}
-.channel-row .rms{margin-left:auto;font:500 10px var(--font-mono);color:var(--text-tertiary);background:var(--bg);border:1px solid var(--border);padding:2px 6px;border-radius:20px}
-.diagnosis{border:1px solid var(--border);border-radius:9px;overflow:hidden;background:var(--surface)}
-.diagnosis-head{padding:9px 10px;display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--border)}
-.diagnosis-icon{width:26px;height:26px;border-radius:7px;display:grid;place-items:center;font:700 11px var(--font-sans);border:1px solid var(--border)}
-.evidence{font:500 10px var(--font-sans);color:var(--text-tertiary);background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:6px;margin:4px 0}
-.help-tip{font:500 10px var(--font-sans);color:#93b4d7;background:rgba(37,99,235,.07);border:1px solid rgba(37,99,235,.16);border-radius:7px;padding:7px;line-height:1.6}
-.trend-wrap{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:6px}
-/* Status bar — VS Code style */
-.statusbar{height:22px;background:var(--accent);color:#fff;display:flex;align-items:center;gap:10px;padding:0 10px;font:500 10px var(--font-sans);flex-shrink:0}
-.statusbar span{opacity:.9}
-.statusbar b{opacity:1}
-.statusbar .spacer{flex:1}
-/* Command palette hint */
-.kbd{font:500 9px var(--font-mono);background:var(--surface-raised);border:1px solid var(--border);border-bottom-width:2px;padding:1px 5px;border-radius:4px;color:var(--text-tertiary)}
+.metric{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:8px}
+.metric label{font:600 9px Inter;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:4px}
+.metric .v{font:600 13px JetBrains Mono}
+.channel-row{height:28px;display:flex;align-items:center;gap:6px;padding:0 8px;background:var(--card);border:1px solid var(--border);border-radius:8px;font:500 11px Inter;color:var(--muted)}
+.statusbar{height:22px;background:var(--accent);color:#fff;display:flex;align-items:center;gap:8px;padding:0 10px;font:500 10px Inter;flex-shrink:0}
+.modal{position:fixed;inset:0;background:rgba(3,8,18,.6);backdrop-filter:blur(4px);display:none;place-items:center;z-index:50}
+.modal.open{display:grid}
+.modal-box{width:560px;background:var(--panel);border:1px solid var(--border2);border-radius:12px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.5)}
+.modal-head{height:40px;display:flex;align-items:center;gap:10px;padding:0 14px;background:var(--card);border-bottom:1px solid var(--border);font:600 12px Inter}
+.stepper{display:flex;gap:6px;margin-top:8px}
+.step{flex:1;height:3px;background:var(--border);border-radius:2px}
+.step.active{background:var(--accent)}
+.wizard-body{padding:16px;display:grid;gap:10px}
+.wizard-actions{display:flex;gap:8px;justify-content:flex-end;padding:12px;background:var(--card);border-top:1px solid var(--border)}
+.alarm-row{display:grid;grid-template-columns:1fr 70px 70px;gap:6px;align-items:center;font:500 11px Inter;padding:4px 0}
+.alarm-row input{height:24px;background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:0 6px;font:500 11px JetBrains Mono;text-align:center}
+::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-thumb{background:#1e3356;border-radius:8px}
