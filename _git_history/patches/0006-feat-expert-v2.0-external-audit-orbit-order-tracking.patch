+/**
+ * orbit.ts — Orbit plot (X vs Y) + Shaft Centerline
+ * الهام: Emerson AMS "Orbit, Circular plot, Shaft Centerline"
+ * برای یاتاقان ژورنال و توربوماشین
+ */
+export function computeOrbit(x: Float64Array, y: Float64Array, maxPoints=2048): {x:number[], y:number[]} {
+  const n = Math.min(x.length, y.length, maxPoints);
+  return { x: Array.from(x.slice(0,n)), y: Array.from(y.slice(0,n)) };
+}
+export function orbitMetrics(x: Float64Array, y: Float64Array){
+  const n=Math.min(x.length,y.length);
+  let maxR=0; for(let i=0;i<n;i++){ const r=Math.hypot(x[i],y[i]); if(r>maxR) maxR=r; }
+  return { maxOrbit: maxR, isCircular: maxR>0 };
+}
