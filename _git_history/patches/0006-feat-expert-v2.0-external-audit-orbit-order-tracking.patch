+/**
+ * orderTracking.ts — Order Spectrum (RPM-based)
+ * الهام: Emerson "order tracking, run-up/coast-down"
+ * Resample signal to equal-angle (order) instead of equal-time
+ */
+export function orderSpectrum(x: Float64Array, fs:number, rpm:number): {orders: Float64Array, mag: Float64Array}{
+  const f0 = rpm/60;
+  const orders = new Float64Array(100);
+  const mag = new Float64Array(100);
+  for(let o=1;o<=100;o++){
+    const f = o*f0;
+    let re=0,im=0;
+    for(let i=0;i<x.length;i++){ const ang=2*Math.PI*f*i/fs; re+=x[i]*Math.cos(ang); im-=x[i]*Math.sin(ang); }
+    orders[o-1]=o; mag[o-1]=Math.hypot(re,im)/x.length;
+  }
+  return { orders, mag };
+}
