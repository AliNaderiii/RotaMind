+/**
+ * alarm.ts — Alarm Sets (Emerson Analysis Parameter Sets + Alarm Sets)
+ * هر نقطه اندازه‌گیری آستانه خودش را دارد
+ */
+export interface AlarmSet { pointId:string; thresholds:{ warn:number; danger:number; metric:'rms'|'peak'|'vel'}; enabled:boolean; history:{ts:number, value:number, level:'ok'|'warn'|'danger'}[]; }
+const KEY='rotamind_alarms_v1';
+export function loadAlarms(): AlarmSet[]{ try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch{return []} }
+export function saveAlarms(a:AlarmSet[]){ localStorage.setItem(KEY, JSON.stringify(a)); }
+export function checkAlarm(value:number, set:AlarmSet):'ok'|'warn'|'danger'{
+  if(!set.enabled) return 'ok';
+  if(value>=set.thresholds.danger) return 'danger';
+  if(value>=set.thresholds.warn) return 'warn';
+  return 'ok';
+}
+export const DEFAULT_ALARM: AlarmSet = { pointId:'p1', thresholds:{ warn:1.8, danger:4.5, metric:'vel'}, enabled:true, history:[] };
